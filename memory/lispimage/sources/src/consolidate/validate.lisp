;;;; Level 1's validation (memory/consolidate validate.go, curated.go and definitions.go;
;;;; hooks.level1Counts): what of one level-1 answer is recorded. Only ids the prompt showed are
;;;; accepted; a record is dropped only when the one standing for it carries its specifics as whole
;;;; items (drops-specifics-p, ledger.AddedSpecifics, never a substring match); records with
;;;; different statuses never merge; a supersede or a confirmed update obeys the status rule
;;;; (MaySupersede); only the possible updates the prompt listed are settled; every new record
;;;; names what it replaces (Observation.Replaces). Definitions: the image offers instructions
;;;; only (decision 5), so a definition of any other kind is refused as not offered, and a rule
;;;; is always refused (no remedy is offered).

(in-package "OM")

(defparameter +reason-foreign-id+ "cites an id outside its input")
(defparameter +reason-not-candidate+ "labels a record that is not a candidate")
(defparameter +reason-used+ "names a record already labelled or merged")
(defparameter +reason-too-few+ "a merge needs two or more records")
(defparameter +reason-empty+ "has no text")
(defparameter +reason-drops-specifics+ "drops specifics of what it replaces")
(defparameter +reason-cycle+ "would close a supersede cycle")
(defparameter +reason-cross-scope+ "supersedes a record with a different scope")
(defparameter +reason-merge-scopes+ "merges records with different scopes")
(defparameter +reason-superseded+ "names a record another proposal supersedes")
(defparameter +reason-cited+ "merges a record a standing reflection cites")
(defparameter +reason-self+ "supersedes itself")
(defparameter +reason-no-support+ "cites no record whose specifics it carries")
(defparameter +reason-malformed+ "is not an object")
(defparameter +reason-code-kind+ "merges an attempt, file, commit, note, decision or convention record, whose fields code keeps")
(defparameter +reason-merge-statuses+ "merges records with different statuses (proposed, hypothetical, retracted or stated as fact)")
(defparameter +reason-not-link+ "names a pair the input did not list as a possible update")
(defparameter +reason-verdict+ "has no verdict: confirm or reject")
(defparameter +reason-link-settled+ "settles a possible update another verdict already settled")
(defparameter +reason-link-merged+ "settles a possible update between records its merge joins")
(defparameter +reason-status-replace+ "replaces a record of another status (a plan or condition never replaces a fact, a retraction only a plan or condition)")
(defparameter +reason-not-curated+ "names a curated memory the input did not list")
(defparameter +reason-no-user-support+ "cites no shown record of the user's own words")
(defparameter +reason-not-offered+ "defines what the input did not offer (definitions are offered only with HARNESS EVIDENCE)")
(defparameter +reason-defined-twice+ "defines a name another proposal of this output already defines")

(defparameter +failure-no-call+ (cat "the response did not call " "consolidate_memory"))
(defparameter +failure-nothing+ "the output accounts for nothing")
(defparameter +failure-none-valid+ "the output has no valid record")

(defstruct vinput
  "consolidate.Input: what the prompt showed, the folded ledger, the subjects, the links and
curated memories listed, the branch, and the offer (nil refuses every definition)."
  candidates active reflections folded subjects links curated branch offer)

(defstruct vresult
  "consolidate.Result. replaced is an equal hash table id -> replacing id; refusals are
(what index reason) lists; cited (name . ids); definitions (kind name text); rules (detector . remedy)."
  records (merges 0) (replaced (make-set)) reflections aliases (unchanged 0) (confirmed 0)
  (rejected 0) (link-records 0) cited definitions rules refusals (failure ""))

(defun vresult-accounted (r)
  (+ (length (vresult-records r)) (vresult-unchanged r) (length (vresult-reflections r))
     (length (vresult-aliases r)) (length (vresult-cited r)) (length (vresult-definitions r))
     (length (vresult-rules r))))

(defstruct (vstate (:conc-name v-))
  in (shown (make-set)) (candidates (make-set)) (reflections (make-set)) (used (make-set))
  (replaced (make-set)) (superseded (make-set)) (standing-superseded (make-set))
  (standing-cited (make-set)) (edges (make-set)) (verdicts '()) (result (make-vresult)))

;; verdict: (index (later . earlier) confirm settled), as a struct for setf.
(defstruct verdict index link confirm settled)

(defun refuse (v what index reason)
  (push-end (list what index reason) (vresult-refusals (v-result v))))

(defun json-items (x) (if (and (vectorp x) (not (stringp x))) (coerce x 'list) '()))

(defun unique-strings (x)
  "uniqueStrings: the distinct non-empty trimmed strings of a JSON array, in order."
  (let ((out '()))
    (dolist (item (json-items x) out)
      (when (stringp item)
        (let ((s (trim-space item)))
          (when (and (string/= s "") (not (member-str s out))) (push-end s out)))))))

(defun one-line-of (x) (if (stringp x) (join (fields x) " ") ""))

(defun jstr (m key) (let ((v (jget m key))) (if (stringp v) v "")))

(defun drops-specifics-p (source replacement)
  "dropsSpecifics: replacement does not give a specific of source as a whole item."
  (and (added-specifics source (list replacement)) t))

(defun drops-record-p (o replacement)
  "dropsRecord: dropsSpecifics, or a rule, correction or decision whose key replacement misses."
  (or (drops-specifics-p (obs-content o) replacement)
      (and (keeps-keys-p o) (missing-keys (obs-content o) replacement) t)))

(defun drops-specifics-besides-update-p (earlier later)
  (let ((updated (updated-specifics later earlier)))
    (some (lambda (s) (not (gethash s updated))) (added-specifics earlier (list later)))))

(defun may-supersede-obs-p (record target) (may-supersede-p (obs-status record) (obs-status target)))

(defun keeps-kind-p (kind) (or (member-str kind +code-kinds+) (member-str kind '("correction" "preference"))))

(defun level1-record-id (o)
  "recordID: the hash of everything a level-1 record states."
  (let* ((z (string (code-char 0)))
         (parts (list "level1" (obs-content o) (join (obs-source-ids o) ",") (obs-kind o) (obs-relevance o)
                      (obs-subject o) (obs-scope o) (join (obs-supersedes o) ",") (obs-outcome o))))
    (when (obs-possibly-updates o)
      (setf parts (append parts (list "possiblyUpdates" (join (obs-possibly-updates o) ",")))))
    (hash-id (join parts z))))

(defun same-labels-p (a b)
  (and (string= (obs-kind a) (obs-kind b)) (string= (obs-relevance a) (obs-relevance b))
       (string= (obs-subject a) (obs-subject b)) (string= (obs-scope a) (obs-scope b))
       (string= (obs-outcome a) (obs-outcome b)) (equal (obs-supersedes a) (obs-supersedes b))
       (equal (obs-possibly-updates a) (obs-possibly-updates b))))

(defun newest-timestamp (records)
  (let ((newest "")) (dolist (o records newest) (when (string> (obs-timestamp o) newest) (setf newest (obs-timestamp o))))))

(defun highest-relevance (records)
  (let ((best 0))
    (dolist (o records) (let ((i (position (obs-relevance o) +relevance-values+ :test #'string=))) (when (and i (> i best)) (setf best i))))
    (nth best +relevance-values+)))

(defun common-field (records key)
  (let ((v (funcall key (first records))))
    (if (every (lambda (o) (string= (funcall key o) v)) (rest records)) v "")))

(defun scope-of (records) (or (find-if (lambda (s) (string/= s "")) (mapcar #'obs-scope records)) ""))

(defun common-scope (records)
  (let ((scope (scope-of records)))
    (if (every (lambda (o) (or (string= (obs-scope o) "") (string= (obs-scope o) scope))) records) scope "")))

(defun common-event-date (records)
  (let ((date ""))
    (dolist (o records date)
      (when (names-no-one-date-p o) (return ""))
      (unless (or (string= (obs-event-date o) "") (string= (obs-event-date o) date))
        (when (string/= date "") (return ""))
        (setf date (obs-event-date o))))))

(defun v-resolve (v id)
  (loop repeat (1+ (hash-table-count (v-replaced v)))
        do (multiple-value-bind (next ok) (gethash id (v-replaced v))
             (unless ok (return-from v-resolve id))
             (setf id next)))
  id)

(defun v-reaches (v id targets)
  (let ((seen (make-set)) (queue (list id)))
    (loop while queue
          do (let ((next (v-resolve v (pop queue))))
               (unless (gethash next seen)
                 (setf (gethash next seen) t)
                 (dolist (tg targets)
                   (when (or (string= next tg) (string= next (v-resolve v tg))) (return-from v-reaches t)))
                 (setf queue (append queue (gethash next (v-edges v)))))))
    nil))

(defun v-record (v id)
  (or (find id (vresult-records (v-result v)) :key #'obs-id :test #'string=)
      (gethash id (v-shown v))
      (gethash id (folded-by-id (vinput-folded (v-in v))))))

(defun v-supersedes (v raw sources record)
  "supersedes: (values targets reason)."
  (let ((targets (unique-strings raw)))
    (dolist (tg targets (values targets ""))
      (let ((target (gethash tg (v-shown v))))
        (cond ((null target) (return (values nil +reason-foreign-id+)))
              ((member-str tg sources) (return (values nil +reason-self+)))
              ((string/= (gethash tg (v-replaced v) "") "") (return (values nil +reason-used+)))
              ((and (string/= (obs-scope record) "") (string/= (obs-scope target) "") (string/= (obs-scope record) (obs-scope target)))
               (return (values nil +reason-cross-scope+)))
              ((not (may-supersede-obs-p record target)) (return (values nil +reason-status-replace+)))
              ((drops-record-p target (obs-content record)) (return (values nil +reason-drops-specifics+)))
              ((v-reaches v tg sources) (return (values nil +reason-cycle+))))))))

(defun origin-rank (origin)
  "consolidate.originRank: model (and any origin not known) lowest, then host, then code."
  (cond ((string= origin "code") 2) ((string= origin "host") 1) (t 0)))

(defun v-least-provenance (v record sources)
  "validator.leastProvenance: a record replacing sources has no origin above the lowest source's,
and stands for the user only when every source does."
  (dolist (id sources)
    (let ((o (gethash id (v-shown v))))
      (when o
        (when (< (origin-rank (obs-origin o)) (origin-rank (obs-origin record)))
          (setf (obs-origin record) (obs-origin o)))
        (unless (or (obs-from-user o) (user-priority-p o))
          (setf (obs-from-user record) nil))))))

(defun v-accept (v record sources)
  (v-least-provenance v record sources)
  (setf (obs-replaces record) (copy-list sources))
  (setf (obs-id record) (level1-record-id record))
  (setf (obs-token-count record) (observation-line-tokens (obs-id record) (obs-timestamp record) (obs-relevance record) (obs-content record)))
  (dolist (id sources) (setf (gethash id (v-used v)) t))
  (when (nth-value 1 (gethash (obs-id record) (folded-by-id (vinput-folded (v-in v)))))
    (incf (vresult-unchanged (v-result v)))
    (return-from v-accept))
  (dolist (id sources) (setf (gethash id (v-replaced v)) (obs-id record)))
  (dolist (id (obs-supersedes record)) (setf (gethash id (v-superseded v)) t))
  (setf (gethash (obs-id record) (v-edges v)) (copy-list (obs-supersedes record)))
  (push-end record (vresult-records (v-result v))))

(defun v-apply-labels (record m label)
  (let ((kind (jget m "kind")))
    (when (and (stringp kind) (member-str kind +observation-kinds+) (not (keeps-kind-p (obs-kind record))))
      (setf (obs-kind record) kind)))
  (let ((relevance (jget m "relevance")))
    (when (and (stringp relevance) (member-str relevance +relevance-values+)) (setf (obs-relevance record) relevance)))
  (let ((subject (jget m "subject")))
    (when (and (stringp subject) (string/= (trim-space subject) ""))
      (let ((stored (recordable-subject subject))) (when (string/= stored "") (setf (obs-subject record) stored)))))
  (let ((scope (jget m "scope")))
    (when (and (stringp scope) (string/= (trim-space scope) "")) (setf (obs-scope record) (normalize-scope scope))))
  (let ((outcome (jget m "outcome")))
    (when (and label (stringp outcome) (string= (obs-kind record) "attempt") (member-str outcome '("failed" "worked" "open")))
      (setf (obs-outcome record) outcome))))

(defun v-confirmable (v record sources earlier)
  (let ((target (gethash earlier (v-shown v))))
    (cond ((string/= (gethash earlier (v-replaced v) "") "") +reason-used+)
          ((and (string/= (obs-scope record) "") (string/= (obs-scope target) "") (string/= (obs-scope record) (obs-scope target)))
           +reason-cross-scope+)
          ((not (may-supersede-obs-p record target)) +reason-status-replace+)
          ((drops-specifics-besides-update-p (obs-content target) (obs-content record)) +reason-drops-specifics+)
          ((v-reaches v earlier sources) +reason-cycle+)
          (t ""))))

(defun v-settle (v record sources)
  (dolist (d (v-verdicts v))
    (when (and (not (verdict-settled d)) (member-str (car (verdict-link d)) sources))
      (setf (verdict-settled d) t)
      (let ((earlier (cdr (verdict-link d))))
        (cond ((member-str earlier sources) (refuse v "link" (verdict-index d) +reason-link-merged+))
              ((not (member-str earlier (obs-possibly-updates record))) (refuse v "link" (verdict-index d) +reason-not-link+))
              (t (let ((ok t))
                   (if (verdict-confirm d)
                       (let ((reason (v-confirmable v record sources earlier)))
                         (if (string/= reason "")
                             (progn (refuse v "link" (verdict-index d) reason) (setf ok nil))
                             (progn (unless (member-str earlier (obs-supersedes record))
                                      (setf (obs-supersedes record) (append (obs-supersedes record) (list earlier))))
                                    (incf (vresult-confirmed (v-result v))))))
                       (incf (vresult-rejected (v-result v))))
                   (when ok
                     (setf (obs-possibly-updates record) (remove earlier (obs-possibly-updates record) :test #'string=))))))))))

(defun v-merge (v index item)
  (unless (hash-table-p item) (return-from v-merge (refuse v "merge" index +reason-malformed+)))
  (let ((source-ids (unique-strings (jget item "ids"))) (sources '()))
    (when (< (length source-ids) 2) (return-from v-merge (refuse v "merge" index +reason-too-few+)))
    (dolist (id source-ids)
      (let ((o (gethash id (v-shown v))))
        (cond ((null o) (return-from v-merge (refuse v "merge" index +reason-foreign-id+)))
              ((gethash id (v-used v)) (return-from v-merge (refuse v "merge" index +reason-used+)))
              ((or (gethash id (v-superseded v)) (gethash id (v-standing-superseded v)))
               (return-from v-merge (refuse v "merge" index +reason-superseded+)))
              ((gethash id (v-standing-cited v)) (return-from v-merge (refuse v "merge" index +reason-cited+)))
              ((member-str (obs-kind o) +code-kinds+) (return-from v-merge (refuse v "merge" index +reason-code-kind+))))
        (push-end o sources)))
    (when (and (string= (common-scope sources) "") (string/= (scope-of sources) ""))
      (return-from v-merge (refuse v "merge" index +reason-merge-scopes+)))
    (dolist (o (rest sources))
      (when (string/= (obs-status o) (obs-status (first sources)))
        (return-from v-merge (refuse v "merge" index +reason-merge-statuses+))))
    (let ((content (one-line-of (jget item "content"))))
      (when (string= content "") (return-from v-merge (refuse v "merge" index +reason-empty+)))
      (dolist (o sources)
        (when (drops-record-p o content) (return-from v-merge (refuse v "merge" index +reason-drops-specifics+))))
      (let ((record (make-obs :content content :timestamp (newest-timestamp sources) :relevance (highest-relevance sources)
                              :kind (common-field sources #'obs-kind) :subject (common-field sources #'obs-subject)
                              :scope (common-scope sources) :origin "model" :status (obs-status (first sources))
                              :event-date (common-event-date sources))))
        (dolist (o sources)
          (dolist (id (obs-possibly-updates o))
            (unless (or (member-str id source-ids) (member-str id (obs-possibly-updates record)))
              (setf (obs-possibly-updates record) (append (obs-possibly-updates record) (list id)))))
          (dolist (id (obs-conflicts o))
            (unless (or (member-str id source-ids) (member-str id (obs-conflicts record)))
              (setf (obs-conflicts record) (append (obs-conflicts record) (list id))))))
        (dolist (o sources)
          (dolist (id (obs-source-ids o))
            (unless (member-str id (obs-source-ids record))
              (setf (obs-source-ids record) (append (obs-source-ids record) (list id))))))
        (v-apply-labels record item nil)
        (setf (obs-from-user record)
              (and (null (added-specifics content (mapcar #'obs-content sources)))
                   (every #'user-priority-p sources)))
        (multiple-value-bind (targets reason) (v-supersedes v (jget item "supersedes") source-ids record)
          (when (string/= reason "") (return-from v-merge (refuse v "merge" index reason)))
          (dolist (o sources)
            (dolist (id (obs-supersedes o))
              (unless (or (member-str id source-ids) (member-str id targets)) (setf targets (append targets (list id))))))
          (setf (obs-supersedes record) targets))
        (v-settle v record source-ids)
        (v-accept v record source-ids)
        (incf (vresult-merges (v-result v)))))))

(defun v-label (v index item)
  (unless (hash-table-p item) (return-from v-label (refuse v "record" index +reason-malformed+)))
  (let* ((id (trim-space (jstr item "id"))) (candidate (gethash id (v-shown v))))
    (cond ((null candidate) (return-from v-label (refuse v "record" index +reason-foreign-id+)))
          ((not (gethash id (v-candidates v))) (return-from v-label (refuse v "record" index +reason-not-candidate+)))
          ((gethash id (v-used v)) (return-from v-label (refuse v "record" index +reason-used+)))
          ((gethash id (v-superseded v)) (return-from v-label (refuse v "record" index +reason-superseded+))))
    (let ((record (copy-obs candidate)))
      (setf (obs-id record) "" (obs-token-count record) 0 (obs-supersedes record) (copy-list (obs-supersedes candidate)))
      (v-apply-labels record item t)
      (when (nth-value 1 (gethash "supersedes" item))
        (multiple-value-bind (targets reason) (v-supersedes v (jget item "supersedes") (list id) record)
          (when (string/= reason "") (return-from v-label (refuse v "record" index reason)))
          (dolist (tg targets)
            (unless (member-str tg (obs-supersedes record))
              (setf (obs-supersedes record) (append (obs-supersedes record) (list tg)))))))
      (v-settle v record (list id))
      (when (same-labels-p record candidate)
        (setf (gethash id (v-used v)) t)
        (incf (vresult-unchanged (v-result v)))
        (return-from v-label))
      (when (string/= (obs-kind record) (obs-kind candidate))
        (setf (obs-origin record) "model" (obs-from-user record) nil))
      (v-accept v record (list id)))))

(defun v-links (v items)
  (loop for item in items for i from 0
        do (if (not (hash-table-p item))
               (refuse v "link" i +reason-malformed+)
               (let ((link (cons (trim-space (jstr item "id")) (trim-space (jstr item "updates"))))
                     (word (trim-space (jstr item "verdict"))))
                 (cond ((not (member link (vinput-links (v-in v)) :test #'equal)) (refuse v "link" i +reason-not-link+))
                       ((not (member-str word '("confirm" "reject"))) (refuse v "link" i +reason-verdict+))
                       ((find link (v-verdicts v) :key #'verdict-link :test #'equal) (refuse v "link" i +reason-link-settled+))
                       (t (push-end (make-verdict :index i :link link :confirm (string= word "confirm")) (v-verdicts v))))))))

(defun v-settle-remaining (v)
  (dolist (d (v-verdicts v))
    (unless (verdict-settled d)
      (let ((later (car (verdict-link d))))
        (if (or (gethash later (v-used v)) (gethash later (v-superseded v)))
            (dolist (e (v-verdicts v))
              (when (and (not (verdict-settled e)) (string= (car (verdict-link e)) later))
                (setf (verdict-settled e) t)
                (refuse v "link" (verdict-index e) +reason-superseded+)))
            (let ((record (copy-obs (gethash later (v-shown v))))
                  (before (+ (vresult-confirmed (v-result v)) (vresult-rejected (v-result v)))))
              (setf (obs-id record) "" (obs-token-count record) 0
                    (obs-supersedes record) (copy-list (obs-supersedes record))
                    (obs-possibly-updates record) (copy-list (obs-possibly-updates record)))
              (v-settle v record (list later))
              (unless (= (+ (vresult-confirmed (v-result v)) (vresult-rejected (v-result v))) before)
                (let ((n (length (vresult-records (v-result v)))))
                  (v-accept v record (list later))
                  (when (> (length (vresult-records (v-result v))) n)
                    (incf (vresult-link-records (v-result v))))))))))))

(defun v-reflection (v index item)
  (unless (hash-table-p item) (return-from v-reflection (refuse v "reflection" index +reason-malformed+)))
  (let ((content (one-line-of (jget item "content"))) (supporting '()))
    (when (string= content "") (return-from v-reflection (refuse v "reflection" index +reason-empty+)))
    (flet ((support (id known)
             (let* ((resolved (v-resolve v id)) (cited (v-record v resolved)))
               (unless (or (and (null cited) known)
                           (and cited (drops-record-p cited content))
                           (member-str resolved supporting))
                 (push-end resolved supporting)))))
      (dolist (id (unique-strings (jget item "supportingIds")))
        (unless (gethash id (v-shown v)) (return-from v-reflection (refuse v "reflection" index +reason-foreign-id+)))
        (support id t))
      (let ((superseded (unique-strings (jget item "supersedes"))))
        (dolist (id superseded)
          (let ((old (gethash id (v-reflections v))))
            (unless old (return-from v-reflection (refuse v "reflection" index +reason-foreign-id+)))
            (when (drops-specifics-p (refl-content old) content)
              (return-from v-reflection (refuse v "reflection" index +reason-drops-specifics+)))
            (dolist (s (refl-supporting old)) (support s nil))))
        (unless supporting (return-from v-reflection (refuse v "reflection" index +reason-no-support+)))
        (let ((id (hash-id content)) (result (v-result v)))
          (when (member-str id superseded) (return-from v-reflection (refuse v "reflection" index +reason-self+)))
          (when (or (nth-value 1 (gethash id (folded-refl-by-id (vinput-folded (v-in v)))))
                    (find id (vresult-reflections result) :key #'refl-id :test #'string=))
            (incf (vresult-unchanged result))
            (return-from v-reflection))
          (push-end (make-refl :id id :content content :supporting supporting :supersedes superseded
                               :token-count (estimate-tokens (reflection-summary-line (make-refl :id id :content content))))
                    (vresult-reflections result)))))))

(defun v-aliases (v items)
  (let ((proposed '()) (positions '()))
    (loop for item in items for i from 0
          do (if (not (hash-table-p item))
                 (refuse v "alias" i +reason-malformed+)
                 (progn (push-end (make-subject-alias :from (trim-space (jstr item "from")) :to (trim-space (jstr item "to"))
                                                      :reason (one-line-of (jget item "reason")))
                                  proposed)
                        (push-end i positions))))
    (when proposed
      (let ((subjects (append (vinput-subjects (v-in v)) (subjects-of (vresult-records (v-result v))))))
        (multiple-value-bind (accepted refused)
            (accept-new-subject-aliases subjects (folded-aliases (vinput-folded (v-in v))) proposed)
          (dolist (r refused)
            (let ((p (position (car r) proposed :test #'eq)))
              (refuse v "alias" (if p (nth p positions) -1) (cdr r))))
          (setf (vresult-aliases (v-result v)) (subseq accepted 0 (min (length accepted) +max-subject-aliases-per-entry+))))))))

(defun branch-roles (entries)
  (let ((out (make-set)))
    (loop for e across (coerce entries 'simple-vector)
          do (when (and (string= (entry-type e) "message") (hash-table-p (entry-message e)))
               (setf (gethash (entry-id e) out) (let ((r (jget (entry-message e) "role"))) (if (stringp r) r "")))))
    out))

(defun from-user-message-p (o roles)
  (and (string= (obs-origin o) "code") (obs-source-ids o) (equal (gethash (first (obs-source-ids o)) roles) "user")))

(defun v-curated (v items)
  (let ((listed (make-set)) (roles (branch-roles (vinput-branch (v-in v)))) (cited (make-set)))
    (dolist (m (vinput-curated (v-in v))) (setf (gethash (cmem-name m) listed) t))
    (loop for item in items for i from 0
          do (block one
               (unless (hash-table-p item) (refuse v "curated" i +reason-malformed+) (return-from one))
               (let ((name (trim-space (jstr item "name"))))
                 (unless (gethash name listed) (refuse v "curated" i +reason-not-curated+) (return-from one))
                 (when (gethash name cited) (refuse v "curated" i +reason-used+) (return-from one))
                 (let* ((ids (unique-strings (jget item "supportingIds"))) (user nil) (foreign (null ids)))
                   (dolist (id ids)
                     (let ((o (gethash id (v-shown v))))
                       (unless o (setf foreign t) (return))
                       (setf user (or user (from-user-message-p o roles)))))
                   (cond (foreign (refuse v "curated" i +reason-foreign-id+))
                         ((not user) (refuse v "curated" i +reason-no-user-support+))
                         (t (setf (gethash name cited) t)
                            (push-end (cons name ids) (vresult-cited (v-result v)))))))))))

(defun v-definitions (v items)
  (let ((seen (make-set)) (offer (vinput-offer (v-in v))))
    (loop for item in items for i from 0
          do (cond ((null offer) (refuse v "definition" i +reason-not-offered+))
                   ((not (hash-table-p item)) (refuse v "definition" i +reason-malformed+))
                   (t (let ((kind (one-line-of (jget item "kind"))) (name (one-line-of (jget item "name")))
                            (text (jstr item "text")))
                        (cond ((not (member-str kind (offer-kinds offer))) (refuse v "definition" i +reason-not-offered+))
                              ((or (string= name "") (string= (trim-space text) "")) (refuse v "definition" i +reason-empty+))
                              ((gethash (cat kind "/" name) seen) (refuse v "definition" i +reason-defined-twice+))
                              (t (setf (gethash (cat kind "/" name) seen) t)
                                 (push-end (list kind name text) (vresult-definitions (v-result v)))))))))))

(defun v-rules (v items)
  (let ((seen '()) (offer (vinput-offer (v-in v))))
    (loop for item in items for i from 0
          do (cond ((or (null offer) (null (offer-remedies offer))) (refuse v "rule" i +reason-not-offered+))
                   ((not (hash-table-p item)) (refuse v "rule" i +reason-malformed+))
                   (t (let ((r (cons (one-line-of (jget item "detector")) (one-line-of (jget item "remedy")))))
                        (cond ((not (and (member-str (car r) (offer-detectors offer)) (member-str (cdr r) (offer-remedies offer))))
                               (refuse v "rule" i +reason-not-offered+))
                              ((member r seen :test #'equal) (refuse v "rule" i +reason-defined-twice+))
                              (t (push r seen) (push-end r (vresult-rules (v-result v)))))))))))

(defun validate-level1 (args in)
  "consolidate.Validate: args is the tool's decoded arguments (nil when the response did not
call it)."
  (unless (hash-table-p args) (return-from validate-level1 (make-vresult :failure +failure-no-call+)))
  (let ((v (make-vstate :in in)) (folded (vinput-folded in)))
    (dolist (o (folded-observations folded)) (setf (gethash (obs-id o) (v-edges v)) (obs-supersedes o)))
    (dolist (o (vinput-active in))
      (setf (gethash (obs-id o) (v-shown v)) o (gethash (obs-id o) (v-edges v)) (obs-supersedes o)))
    (dolist (o (vinput-candidates in))
      (setf (gethash (obs-id o) (v-shown v)) o (gethash (obs-id o) (v-candidates v)) t
            (gethash (obs-id o) (v-edges v)) (obs-supersedes o)))
    (dolist (r (vinput-reflections in)) (setf (gethash (refl-id r) (v-reflections v)) r))
    (dolist (o (append (folded-active folded) (vinput-active in) (vinput-candidates in)))
      (dolist (id (obs-supersedes o)) (setf (gethash id (v-standing-superseded v)) t)))
    (dolist (r (append (folded-reflections folded) (vinput-reflections in)))
      (dolist (id (refl-supporting r)) (setf (gethash id (v-standing-cited v)) t)))
    (v-links v (json-items (jget args "links")))
    (loop for item in (json-items (jget args "merges")) for i from 0 do (v-merge v i item))
    (loop for item in (json-items (jget args "records")) for i from 0 do (v-label v i item))
    (v-settle-remaining v)
    (loop for item in (json-items (jget args "reflections")) for i from 0 do (v-reflection v i item))
    (v-aliases v (json-items (jget args "aliases")))
    (v-curated v (json-items (jget args "curated")))
    (v-definitions v (json-items (jget args "definitions")))
    (v-rules v (json-items (jget args "rules")))
    (let ((r (v-result v)))
      (setf (vresult-replaced r) (v-replaced v))
      (when (zerop (vresult-accounted r))
        (setf (vresult-failure r) (if (vresult-refusals r) +failure-none-valid+ +failure-nothing+)
              (vresult-records r) nil (vresult-reflections r) nil (vresult-aliases r) nil
              (vresult-replaced r) (make-set) (vresult-cited r) nil))
      r)))

(defun level1-union (result records)
  "consolidate.Union: (values drop reflections kept-back)."
  (let ((by-id (make-set)) (drop '()) (reflections '()) (kept 0))
    (dolist (o records) (setf (gethash (obs-id o) by-id) o))
    (dolist (r (vresult-records result)) (setf (gethash (obs-id r) by-id) r))
    (dolist (o records)
      (multiple-value-bind (replacement ok) (gethash (obs-id o) (vresult-replaced result))
        (when ok
          (let ((r (gethash replacement by-id)))
            (if (or (null r) (string= replacement (obs-id o)) (drops-record-p o (obs-content r)))
                (incf kept)
                (unless (member-str (obs-id o) drop) (push-end (obs-id o) drop)))))))
    (dolist (r (vresult-reflections result))
      (let ((supporting '()))
        (dolist (id (refl-supporting r))
          (let ((o (gethash id by-id)))
            (if (and o (drops-record-p o (refl-content r)))
                (incf kept)
                (push-end id supporting))))
        (when supporting
          (let ((copy (copy-refl r))) (setf (refl-supporting copy) supporting) (push-end copy reflections)))))
    (values drop reflections kept)))

(defun refusal-summary (refusals)
  (join (mapcar (lambda (r) (format nil "~A ~D: ~A" (first r) (second r) (third r))) refusals) "; "))

(defun level1-counts (result kept-back)
  "hooks.level1Counts as an alist sorted by key (rules.Level1Counts' keys)."
  (let ((counts (list (cons "level1-union-kept" kept-back))))
    (flet ((inc (k) (let ((c (assoc k counts :test #'string=))) (if c (incf (cdr c)) (push (cons k 1) counts)))))
      (dolist (r (vresult-refusals result))
        (unless (member-str (first r) '("definition" "rule"))
          (inc "level1-refused")
          (cond ((member-str (third r) (list +reason-drops-specifics+ +reason-no-support+)) (inc "level1-specifics-refused"))
                ((string= (third r) +reason-cross-scope+) (inc "cross-scope-supersede"))))))
    (sort counts #'string< :key #'car)))
