;;;; The JSONL and JSON transcript readers of memory/transcript beyond the spike's two
;;;; (transcript.lisp holds readLines, ClaudeCode and Generic): each one ports its Go function
;;;; rule for rule, and reads the decoded lines into Pi-shaped entries with the harness's ids.

(in-package "OM")

(defun thinking-block (s) (jobject "type" "thinking" "thinking" s))

(defun tool-call-block (id name arguments)
  (jobject "type" "toolCall" "id" id "name" name "arguments" arguments))

(defun tool-result-message (id ts call-id tool-name body error-p)
  (make-message id ts (jobject "role" "toolResult" "toolCallId" call-id "toolName" tool-name
                               "content" (vector (text-block body)) "isError" (jbool error-p))
                nil))

(defun role-message (id ts role content)
  "A user or assistant entry over a non-empty list of blocks."
  (make-message id ts (jobject "role" role "content" (jvector content)) nil))

(defun numbered-id (id n)
  "The id of a source line's n-th result: the line's id, then id#1, id#2..."
  (if (> n 0) (format nil "~A#~D" id n) id))

;;; codex.go

(defun codex-context-p (body)
  (let ((b (trim-space body)))
    (or (some (lambda (p) (has-prefix b p))
              '("<environment_context>" "<user_instructions>" "# AGENTS.md instructions" "<turn_aborted>"))
        (string= b ""))))

(defun read-codex (lines)
  "Codex: a rollout's response_item lines; consecutive assistant-side items are one entry."
  (let ((tool-names (make-set)) (out '()))
    (with-assistant-group (assistant flush out)
      (loop for l in lines for i from 0
            do (when (string= (str (jget l "type")) "response_item")
                 (let* ((p (jget l "payload"))
                        (id (format nil "cx~6,'0D" i))
                        (ts (str (jget l "timestamp")))
                        (type (str (jget p "type"))))
                   (cond
                     ((string= type "message")
                      (let ((role (str (jget p "role"))) (body ""))
                        (dolist (b (content-blocks (jget p "content")))
                          (when (member-str (str (jget b "type")) '("input_text" "output_text" "text"))
                            (setf body (cat body (str (jget b "text"))))))
                        (cond ((string= role "assistant")
                               (unless (string= (trim-space body) "")
                                 (assistant id ts (text-block body))))
                              ((and (string= role "user") (not (codex-context-p body)))
                               (flush)
                               (push (role-message id ts "user" (list (text-block body))) out)))))
                     ((string= type "reasoning")
                      (let ((summary ""))
                        (dolist (b (content-blocks (jget p "summary")))
                          (setf summary (cat summary (str (jget b "text")))))
                        (unless (string= summary "")
                          (assistant id ts (thinking-block summary)))))
                     ((member-str type '("function_call" "custom_tool_call" "local_shell_call"))
                      (let* ((call (str (jget p "call_id")))
                             (name (let ((n (str (jget p "name")))) (if (string= n "") "shell" n)))
                             (args (jget p "input"))
                             (s (str (jget p "arguments"))))
                        (setf (gethash call tool-names) name)
                        (cond ((string/= s "")
                               (multiple-value-bind (decoded ok) (try-json-any s)
                                 (setf args (if ok decoded s))))
                              ((jpresent-p p "action") (setf args (jget p "action"))))
                        (assistant id ts (tool-call-block call name args))))
                     ((member-str type '("function_call_output" "custom_tool_call_output"))
                      (flush)
                      (let* ((call (str (jget p "call_id")))
                             (body (result-text (jget p "output"))))
                        (when (and (string= body "") (stringp (jget p "output")))
                          (setf body (jget p "output")))
                        (push (tool-result-message id ts call (or (gethash call tool-names) "") body nil) out)))))))
      (flush))
    (nreverse out)))

;;; copilot.go

(defun read-copilot (lines)
  "Copilot: a Copilot CLI events.jsonl, one session event per line."
  (let ((tool-names (make-set)) (out '()))
    (dolist (l lines)
      (let ((data (jget l "data")) (id (str (jget l "id"))) (ts (str (jget l "timestamp"))))
        (unless (or (jbool-p (jget l "ephemeral")) (string/= (str (jget l "agentId")) "")
                    (string= id "") (not (hash-table-p data)))
          (let ((type (str (jget l "type"))))
            (cond
              ((string= type "user.message")
               (let ((c (str (jget data "content"))))
                 (unless (string= c "") (push (role-message id ts "user" (list (text-block c))) out))))
              ((string= type "assistant.message")
               (let ((content '()))
                 (let ((r (str (jget data "reasoningText"))))
                   (unless (string= r "") (push (thinking-block r) content)))
                 (let ((c (str (jget data "content"))))
                   (unless (string= c "") (push (text-block c) content)))
                 (dolist (r (jlist (jget data "toolRequests")))
                   (let ((call-id (str (jget r "toolCallId"))) (name (str (jget r "name")))
                         (args (jget r "arguments")))
                     (setf (gethash call-id tool-names) name)
                     (when (stringp args)
                       (multiple-value-bind (parsed ok) (try-json-any args)
                         (when ok (setf args parsed))))
                     (push (tool-call-block call-id name args) content)))
                 (when content (push (role-message id ts "assistant" (reverse content)) out))))
              ((string= type "tool.execution_complete")
               (let* ((call-id (str (jget data "toolCallId")))
                      (success (jbool-p (jget data "success")))
                      (r (jget data "result"))
                      (e (jget data "error"))
                      (body (if (hash-table-p r) (str (jget r "content")) "")))
                 (when (and (hash-table-p e) (string= body ""))
                   (setf body (str (jget e "message"))))
                 (push (tool-result-message id ts call-id (or (gethash call-id tool-names) "") body (not success)) out))))))))
    (nreverse out)))

;;; cursor.go

(defun read-cursor (lines)
  "Cursor: agent-transcript lines; each line's position is its id."
  (let ((out '()))
    (loop for l in lines for i from 0
          do (let ((role (str (jget l "role"))))
               (when (member-str role '("user" "assistant"))
                 (let ((id (format nil "cu~6,'0D" (1+ i))) (content '()))
                   (loop for b in (content-blocks (jget (jget l "message") "content")) for j from 0
                         do (let ((type (str (jget b "type"))))
                              (cond ((string= type "text") (push (text-block (str (jget b "text"))) content))
                                    ((and (string= type "tool_use") (string= role "assistant"))
                                     (push (tool-call-block (format nil "~A.~D" id j) (str (jget b "name")) (jget b "input"))
                                           content)))))
                   (when content (push (role-message id "" role (reverse content)) out))))))
    (nreverse out)))

;;; deepagents.go

(defun read-deepagents (lines)
  "DeepAgents: TranscriptRecord lines; a tool result answers the earliest open call of its tool."
  (let ((out '()) (pending (make-set)))
    (dolist (l lines)
      (let ((id (str (jget l "record_id"))) (ts (str (jget l "timestamp"))) (role (str (jget l "role"))))
        (unless (string= id "")
          (cond
            ((string= role "user")
             (let ((content '()))
               (dolist (b (content-blocks (jget l "content")))
                 (when (string= (str (jget b "type")) "text") (push (text-block (str (jget b "text"))) content)))
               (when content (push (role-message id ts "user" (reverse content)) out))))
            ((string= role "assistant")
             (let ((content '()))
               (dolist (b (content-blocks (jget l "content")))
                 (let ((type (str (jget b "type"))))
                   (cond ((string= type "text") (push (text-block (str (jget b "text"))) content))
                         ((string= type "thinking") (push (thinking-block (str (jget b "thinking"))) content))
                         ((string= type "tool_use")
                          (let ((name (str (jget b "name"))))
                            (setf (gethash name pending) (append (gethash name pending) (list (str (jget b "id")))))
                            (push (tool-call-block (str (jget b "id")) name (jget b "input")) content))))))
               (when content (push (role-message id ts "assistant" (reverse content)) out))))
            ((string= role "tool")
             (let* ((name (str (jget l "name"))) (ids (gethash name pending)) (call-id ""))
               (when ids (setf call-id (first ids) (gethash name pending) (rest ids)))
               (push (tool-result-message id ts call-id name (result-text (jget l "content")) nil) out)))))))
    (nreverse out)))

;;; droid.go

(defun read-droid (lines)
  "Droid: whole message lines, each read as a Claude Code line chained to the one before."
  (let ((cc '()) (parent ""))
    (dolist (l lines)
      (let* ((msg (jget l "message")) (id (str (jget l "id"))) (role (str (jget msg "role"))))
        (when (and (string= (str (jget l "type")) "message") (string/= id "") (member-str role '("user" "assistant")))
          (let ((v (str (jget msg "visibility"))))
            (unless (or (string= v "user_only") (and (string= v "llm_only") (string= role "user")))
              (push (jobject "type" role "uuid" id "parentUuid" parent "timestamp" (jget l "timestamp")
                             "message" (jobject "id" id "role" role "content" (jget msg "content")))
                    cc)
              (setf parent id))))))
    (read-claude-code (nreverse cc))))

;;; pi.go

(defun read-pi (lines)
  "Pi: the active branch of a Pi session file, walked back from the newest entry."
  (let ((by-id (make-set)) (leaf "") (out '()) (seen (make-set)))
    (dolist (l lines)
      (let ((id (str (jget l "id"))) (type (str (jget l "type"))))
        (unless (or (string= id "") (string= type "session") (string= type "title"))
          (setf (gethash id by-id) l leaf id))))
    (loop with id = leaf
          while (and (string/= id "") (not (gethash id seen)) (gethash id by-id))
          do (setf (gethash id seen) t)
             (push (entry-from-map (gethash id by-id)) out)
             (setf id (str (jget (gethash id by-id) "parentId"))))
    out))

;;; gemini.go

(defun merge-gemini-calls (old patch)
  "mergeCalls: a $patch's tool calls merged into a record's by call id."
  (let ((out '()) (index (make-set)) (n 0))
    (dolist (raw (jlist old))
      (let ((copied (copy-jobject raw)))
        (setf (gethash (str (jget copied "id")) index) n)
        (push copied out)
        (incf n)))
    (setf out (nreverse out))
    (let ((out (coerce out 'vector)))
      (setf out (make-array (length out) :initial-contents out :adjustable t :fill-pointer t))
      (dolist (u (jlist patch))
        (let ((i (gethash (str (jget u "id")) index)))
          (if (null i)
              (progn (setf (gethash (str (jget u "id")) index) (fill-pointer out))
                     (vector-push-extend (if (hash-table-p u) u :null) out))
              (let ((c (aref out i)))
                (when (and (hash-table-p u) (hash-table-p c))
                  (maphash (lambda (k v) (setf (gethash k c) v)) u))))))
      (coerce out 'simple-vector))))

(defun gemini-result (v)
  "geminiResult: a tool call's result as text."
  (if (stringp v)
      v
      (let ((parts '()))
        (dolist (p (content-blocks v))
          (let ((fr (jget p "functionResponse")))
            (if (hash-table-p fr)
                (let* ((resp (jget fr "response")) (o (str (jget resp "output"))))
                  (cond ((string/= o "") (push o parts))
                        ((not (jnil-p (jget resp "error"))) (push (go-sprint (jget resp "error")) parts))))
                (let ((tx (str (jget p "text"))))
                  (unless (string= tx "") (push tx parts))))))
        (join-lines (nreverse parts)))))

(defun read-gemini (lines)
  "Gemini: a chat recording's JSONL (records re-appear under their id; $rewindTo, $set and
$patch lines), or the legacy single-JSON session."
  (let ((by-id (make-set)) (order (make-array 0 :adjustable t :fill-pointer t)))
    ;; by-id maps an id to (position . record).
    (labels ((add (l)
               (let ((id (str (jget l "id"))))
                 (unless (or (string= id "") (jnil-p (jget l "type")))
                   (let ((r (gethash id by-id)))
                     (if r
                         (setf (cdr r) l)
                         (progn (setf (gethash id by-id) (cons (fill-pointer order) l))
                                (vector-push-extend id order)))))))
             (checkpoint (msgs)
               (setf by-id (make-set) order (make-array 0 :adjustable t :fill-pointer t))
               (dolist (m msgs) (when (hash-table-p m) (add m)))))
      (dolist (l lines)
        (let ((to (str (jget l "$rewindTo"))))
          (cond
            ((string/= to "")
             (let ((r (gethash to by-id)))
               (when r
                 (loop for i from (car r) below (fill-pointer order) do (remhash (aref order i) by-id))
                 (setf (fill-pointer order) (car r)))))
            ((hash-table-p (jget l "$set"))
             (let ((msgs (jget (jget l "$set") "messages")))
               (when (and (vectorp msgs) (not (stringp msgs))) (checkpoint (jlist msgs)))))
            ((hash-table-p (jget l "$patch"))
             (let* ((patch (jget l "$patch")) (updates (jlist (jget patch "updates"))))
               (unless updates (setf updates (list patch)))
               (dolist (u updates)
                 (let ((r (gethash (str (jget u "id")) by-id)))
                   (when r
                     (let ((merged (copy-jobject (cdr r))))
                       (when (hash-table-p u)
                         (maphash (lambda (k v)
                                    (cond ((string= k "toolCalls")
                                           (setf (gethash k merged) (merge-gemini-calls (jget (cdr r) k) v)))
                                          ((string/= k "id") (setf (gethash k merged) v))))
                                  u))
                       (setf (cdr r) merged)))))))
            ((and (vectorp (jget l "messages")) (not (stringp (jget l "messages"))) (jnil-p (jget l "type")))
             (checkpoint (jlist (jget l "messages"))))
            (t (add l))))))
    (let ((answered (make-set)) (out '()))
      (loop for id across order
            do (let ((l (cdr (gethash id by-id))))
                 (when (string= (str (jget l "type")) "user")
                   (dolist (p (content-blocks (jget l "content")))
                     (let ((fr (jget p "functionResponse")))
                       (when (hash-table-p fr) (setf (gethash (str (jget fr "id")) answered) t)))))))
      (loop for id across order
            do (let* ((l (cdr (gethash id by-id))) (ts (str (jget l "timestamp"))) (type (str (jget l "type"))))
                 (cond
                   ((string= type "user")
                    (let ((content '()) (n 0))
                      (dolist (p (content-blocks (jget l "content")))
                        (let ((fr (jget p "functionResponse")))
                          (if (hash-table-p fr)
                              (let* ((rid (numbered-id id n))
                                     (resp (jget fr "response"))
                                     (body (str (jget resp "output")))
                                     (error-p nil))
                                (incf n)
                                (unless (jnil-p (jget resp "error"))
                                  (setf body (go-sprint (jget resp "error")) error-p t))
                                (push (tool-result-message rid ts (str (jget fr "id")) (str (jget fr "name")) body error-p) out))
                              (let ((tx (str (jget p "text"))))
                                (unless (string= tx "") (push (text-block tx) content))))))
                      (when (and content (= n 0)) (push (role-message id ts "user" (reverse content)) out))))
                   ((string= type "gemini")
                    (let ((content '()) (results '()))
                      (dolist (th (content-blocks (jget l "thoughts")))
                        (let ((d (str (jget th "description"))))
                          (unless (string= d "") (push (thinking-block d) content))))
                      (dolist (p (content-blocks (jget l "content")))
                        (unless (string= (str (jget p "text")) "") (push (text-block (str (jget p "text"))) content)))
                      (loop for tc in (content-blocks (jget l "toolCalls")) for i from 0
                            do (let ((call-id (str (jget tc "id"))))
                                 (push (tool-call-block call-id (str (jget tc "name")) (jget tc "args")) content)
                                 (unless (or (jnil-p (jget tc "result")) (gethash call-id answered))
                                   (push (tool-result-message (format nil "~A#r~D" id i) ts call-id (str (jget tc "name"))
                                                              (gemini-result (jget tc "result"))
                                                              (string= (str (jget tc "status")) "error"))
                                         results))))
                      (when content
                        (push (role-message id ts "assistant" (reverse content)) out)
                        (dolist (r (reverse results)) (push r out))))))))
      (nreverse out))))

;;; kimi.go

(defun read-kimi (lines)
  "Kimi: a wire log; the content parts and tool calls of a step are one assistant entry."
  (let ((tool-names (make-set)) (out '()))
    (with-assistant-group (assistant flush out)
      (loop for l in lines for i from 0
            do (let ((m (jget l "message")))
                 (when (hash-table-p m)
                   (let* ((p (jget m "payload"))
                          (id (format nil "kw~6,'0D" i))
                          (ts (unix-time (jget l "timestamp")))
                          (type (str (jget m "type"))))
                     (cond
                       ((string= type "TurnBegin")
                        (flush)
                        (let ((body (result-text (jget p "user_input"))))
                          (unless (string= body "") (push (role-message id ts "user" (list (text-block body))) out))))
                       ((string= type "ContentPart")
                        (let ((ptype (str (jget p "type"))))
                          (cond ((string= ptype "text")
                                 (let ((tx (str (jget p "text")))) (unless (string= tx "") (assistant id ts (text-block tx)))))
                                ((string= ptype "think")
                                 (let ((tx (str (jget p "think")))) (unless (string= tx "") (assistant id ts (thinking-block tx))))))))
                       ((string= type "ToolCall")
                        (let* ((fn (jget p "function"))
                               (name (str (jget fn "name")))
                               (args (str (jget fn "arguments"))))
                          (setf (gethash (str (jget p "id")) tool-names) name)
                          (multiple-value-bind (decoded ok) (try-json-any args)
                            (when ok (setf args decoded)))
                          (assistant id ts (tool-call-block (str (jget p "id")) name args))))
                       ((string= type "ToolResult")
                        (flush)
                        (let* ((call (str (jget p "tool_call_id")))
                               (rv (jget p "return_value"))
                               (body (result-text (jget rv "output"))))
                          (when (string= body "") (setf body (str (jget rv "message"))))
                          (push (tool-result-message id ts call (or (gethash call tool-names) "") body (jbool-p (jget rv "is_error")))
                                out)))
                       ((string= type "TurnEnd") (flush)))))))
      (flush))
    (nreverse out)))

;;; qwen.go

(defun read-qwen (lines)
  "Qwen: chat records chained by parentUuid, walked back from the newest."
  (let ((by-id (make-set)) (leaf "") (chain '()) (seen (make-set)) (out '()))
    (dolist (l lines)
      (let ((id (str (jget l "uuid"))))
        (unless (string= id "") (setf (gethash id by-id) l leaf id))))
    (loop with id = leaf
          while (and (string/= id "") (not (gethash id seen)) (gethash id by-id))
          do (setf (gethash id seen) t)
             (push (gethash id by-id) chain)
             (setf id (str (jget (gethash id by-id) "parentUuid"))))
    ;; push built the chain oldest first.
    (dolist (l chain)
      (let* ((id (str (jget l "uuid"))) (ts (str (jget l "timestamp")))
             (parts (content-blocks (jget (jget l "message") "parts")))
             (type (str (jget l "type"))))
        (cond
          ((string= type "user")
           (when (jnil-p (jget l "subtype"))
             (let ((content '()))
               (dolist (p parts)
                 (when (and (string/= (str (jget p "text")) "") (not (eq (jget p "thought") :true)))
                   (push (text-block (str (jget p "text"))) content)))
               (when content (push (role-message id ts "user" (reverse content)) out)))))
          ((string= type "assistant")
           (let ((content '()))
             (dolist (p parts)
               (cond ((not (jnil-p (jget p "functionCall")))
                      (let ((fc (jget p "functionCall")))
                        (push (tool-call-block (str (jget fc "id")) (str (jget fc "name")) (jget fc "args")) content)))
                     ((eq (jget p "thought") :true) (push (thinking-block (str (jget p "text"))) content))
                     ((string/= (str (jget p "text")) "") (push (text-block (str (jget p "text"))) content))))
             (when content (push (role-message id ts "assistant" (reverse content)) out))))
          ((string= type "tool_result")
           (let* ((result (jget l "toolCallResult"))
                  (error-p (or (string= (str (jget result "status")) "error") (not (jnil-p (jget result "errorType")))))
                  (n 0))
             (dolist (p parts)
               (let ((fr (jget p "functionResponse")))
                 (when (hash-table-p fr)
                   (let* ((rid (numbered-id id n))
                          (resp (jget fr "response"))
                          (body (str (jget resp "output"))))
                     (incf n)
                     (when (and (string= body "") (not (jnil-p (jget resp "error"))))
                       (setf body (go-sprint (jget resp "error"))))
                     (push (tool-result-message rid ts (str (jget fr "id")) (str (jget fr "name")) body error-p) out))))))))))
    (nreverse out)))

;;; kiro.go

(defun read-kiro (lines)
  "Kiro: the V3 {id, timestamp, payload} records or the V2 {kind, data} records."
  (let ((tool-names (make-set)) (seen (make-set)) (out '()))
    (flet ((uniq (id)
             (let ((n (incf (gethash id seen 0))))
               (if (> n 1) (format nil "~A#~D" id (1- n)) id))))
      (dolist (l lines)
        (let ((p (jget l "payload")))
          (if (hash-table-p p)
              (let ((id (str (jget l "id"))) (ts (str (jget l "timestamp"))) (type (str (jget p "type"))))
                (unless (string= id "")
                  (cond
                    ((string= type "user")
                     (let ((c (str (jget p "content"))))
                       (unless (string= c "") (push (role-message (uniq id) ts "user" (list (text-block c))) out))))
                    ((string= type "assistant")
                     (let ((c (str (jget p "content"))) (op (str (jget p "operationType"))))
                       (cond ((string= op "Say")
                              (unless (string= c "") (push (role-message (uniq id) ts "assistant" (list (text-block c))) out)))
                             ((string= op "Reasoning")
                              (unless (or (string= c "") (string= c "..."))
                                (push (role-message (uniq id) ts "assistant" (list (thinking-block c))) out))))))
                    ((string= type "tool_call")
                     (let ((call-id (str (jget p "toolCallId"))) (name (str (jget p "toolName"))))
                       (setf (gethash call-id tool-names) name)
                       (push (role-message (uniq id) ts "assistant" (list (tool-call-block call-id name (jget p "args")))) out)))
                    ((string= type "tool_result")
                     (let ((call-id (str (jget p "toolCallId"))))
                       (push (tool-result-message (uniq id) ts call-id (or (gethash call-id tool-names) "")
                                                  (result-text (jget p "content")) (not (jbool-p (jget p "success"))))
                             out))))))
              (let* ((data (jget l "data")) (id (str (jget data "message_id"))))
                (unless (string= id "")
                  (let ((ts (unix-time (jget (jget data "meta") "timestamp"))) (content '()) (n 0))
                    (dolist (c (content-blocks (jget data "content")))
                      (let ((kind (str (jget c "kind"))))
                        (cond
                          ((string= kind "text")
                           (let ((tx (str (jget c "data")))) (unless (string= tx "") (push (text-block tx) content))))
                          ((string= kind "thinking")
                           (let ((tx (str (jget (jget c "data") "text")))) (unless (string= tx "") (push (thinking-block tx) content))))
                          ((string= kind "toolUse")
                           (let* ((u (jget c "data")) (call-id (str (jget u "toolUseId"))) (name (str (jget u "name"))))
                             (setf (gethash call-id tool-names) name)
                             (push (tool-call-block call-id name (jget u "input")) content)))
                          ((string= kind "toolResult")
                           (let* ((r (jget c "data")) (call-id (str (jget r "toolUseId"))) (parts '()))
                             (dolist (rc (content-blocks (jget r "content")))
                               (let ((d (jget rc "data")))
                                 (cond ((stringp d) (push d parts))
                                       ((not (jnil-p d)) (push (json-string d) parts)))))
                             (push (tool-result-message (uniq (format nil "~A#~D" id n)) ts call-id (or (gethash call-id tool-names) "")
                                                        (join-lines (nreverse parts)) (string= (str (jget r "status")) "error"))
                                   out)
                             (incf n))))))
                    (let* ((kind (str (jget l "kind")))
                           (role (cond ((string= kind "Prompt") "user") ((string= kind "AssistantMessage") "assistant") (t ""))))
                      (when (and (string/= role "") content)
                        (push (role-message (uniq id) ts role (reverse content)) out))))))))))
    (nreverse out)))

;;; more.go

(defun read-qoder (lines)
  "Qoder: Qwen Code's reader when the messages carry parts, else Claude Code's."
  (dolist (l lines (read-claude-code lines))
    (let ((msg (jget l "message")))
      (when (hash-table-p msg)
        (when (jpresent-p msg "parts") (return (read-qwen lines)))
        (when (jpresent-p msg "content") (return (read-claude-code lines)))))))

(defun read-cline (lines)
  "Cline: a messages.json document, each message read as a chained Claude Code line."
  (when lines
    (let ((cc '()) (parent ""))
      (dolist (m (jlist (jget (first lines) "messages")))
        (let ((id (str (jget m "id"))) (role (str (jget m "role"))))
          (unless (or (string= id "") (not (member-str role '("user" "assistant"))))
            (let ((ts (if (floatp (jget m "ts")) (unix-millis (jget m "ts")) "")))
              (push (jobject "type" role "uuid" id "parentUuid" parent "timestamp" ts
                             "message" (jobject "id" id "role" role "content" (jget m "content")))
                    cc)
              (setf parent id)))))
      (read-claude-code (nreverse cc)))))

(defun read-neovate (lines)
  "Neovate: NormalizedMessage lines in file order."
  (let ((out '()))
    (dolist (l lines)
      (let ((id (str (jget l "uuid"))) (ts (str (jget l "timestamp"))) (role (str (jget l "role"))))
        (unless (or (string/= (str (jget l "type")) "message") (string= id "")
                    (string= (str (jget l "uiContent")) "Chat history compacted successfully."))
          (cond
            ((string= role "user")
             (let ((content '()))
               (dolist (b (content-blocks (jget l "content")))
                 (when (string= (str (jget b "type")) "text") (push (text-block (str (jget b "text"))) content)))
               (when content (push (role-message id ts "user" (reverse content)) out))))
            ((string= role "assistant")
             (let ((content '()))
               (dolist (b (content-blocks (jget l "content")))
                 (let ((type (str (jget b "type"))))
                   (cond ((string= type "text") (push (text-block (str (jget b "text"))) content))
                         ((string= type "reasoning") (push (thinking-block (str (jget b "text"))) content))
                         ((string= type "tool_use")
                          (push (tool-call-block (str (jget b "id")) (str (jget b "name")) (jget b "input")) content)))))
               (when content (push (role-message id ts "assistant" (reverse content)) out))))
            ((string= role "tool")
             (loop for b in (content-blocks (jget l "content")) for i from 0
                   do (when (string= (str (jget b "type")) "tool-result")
                        (let ((r (jget b "result")))
                          (push (tool-result-message (numbered-id id i) ts (str (jget b "toolCallId")) (str (jget b "toolName"))
                                                     (result-text (jget r "llmContent")) (jbool-p (jget r "isError")))
                                out)))))))))
    (nreverse out)))

;;; more2.go

(defun read-iflow (lines)
  "IFlow: Claude Code-style records in file order, each chained to the one before."
  (let ((cc '()) (parent ""))
    (dolist (l lines)
      (let ((type (str (jget l "type"))) (id (str (jget l "uuid"))))
        (when (and (member-str type '("user" "assistant")) (string/= id ""))
          (let ((c (copy-jobject l)) (msg (jget l "message")))
            (setf (gethash "parentUuid" c) parent (gethash "logicalParentUuid" c) nil)
            (when (hash-table-p msg)
              (let ((m (copy-jobject msg)) (content '()))
                (dolist (b (content-blocks (jget msg "content")))
                  (when (and (string= (str (jget b "type")) "thinking") (hash-table-p (jget b "thinking")))
                    (setf b (jobject "type" "thinking" "thinking" (str (jget b "text")))))
                  (push b content))
                (when content (setf (gethash "content" m) (jvector (nreverse content))))
                (setf (gethash "message" c) m)))
            (push c cc)
            (setf parent id)))))
    (read-claude-code (nreverse cc))))

(defun read-cortex (lines)
  "Cortex: merged lines (the last copy of an id stands at its first place) or flat lines
grouped by message."
  (let ((by-id (make-set)) (order '()) (out '()))
    ;; A message is (role ts . content-list).
    (dolist (l lines)
      (let* ((id (str (jget l "message_id"))) (flat (string/= id "")))
        (unless flat (setf id (str (jget l "id"))))
        (unless (string= id "")
          (let ((m (gethash id by-id)))
            (unless m
              (setf m (list "" "" '()) (gethash id by-id) m)
              (push id order))
            (setf (first m) (str (jget l "role")))
            (when (string= (second m) "")
              (setf (second m) (first-string l "user_sent_time" "assistant_sent_time" "created_on")))
            (setf (third m) (if flat
                                (append (third m) (content-blocks (jget l "content")))
                                (content-blocks (jget l "content"))))))))
    (dolist (id (nreverse order))
      (destructuring-bind (role ts blocks) (gethash id by-id)
        (let ((content '()) (n 0))
          (dolist (b blocks)
            (let ((type (str (jget b "type"))))
              (cond
                ((string= type "text")
                 (unless (jbool-p (jget b "internalOnly")) (push (text-block (str (jget b "text"))) content)))
                ((string= type "thinking")
                 (push (thinking-block (str (jget (jget b "thinking") "text"))) content))
                ((string= type "tool_use")
                 (let ((tu (jget b "tool_use")))
                   (push (tool-call-block (str (jget tu "tool_use_id")) (str (jget tu "name")) (jget tu "input")) content)))
                ((string= type "tool_result")
                 (let ((tr (jget b "tool_result")) (rid (numbered-id id n)))
                   (incf n)
                   (push (tool-result-message rid ts (str (jget tr "tool_use_id")) (str (jget tr "name"))
                                              (result-text (jget tr "content")) (string= (str (jget tr "status")) "error"))
                         out))))))
          (unless (or (null content) (not (member-str role '("user" "assistant")))
                      (and (string= role "user") (> n 0)))
            (push (role-message id ts role (reverse content)) out)))))
    (nreverse out)))

(defun read-auggie (lines)
  "Auggie: a session document's chatHistory exchanges."
  (when lines
    (let ((out '()))
      (dolist (item (jlist (jget (first lines) "chatHistory")))
        (unless (jbool-p (jget item "isHistorySummary"))
          (let* ((ex (jget item "exchange")) (id (str (jget ex "request_id"))))
            (unless (string= id "")
              (let ((ts (str (jget item "finishedAt"))) (n 0))
                (dolist (node (content-blocks (jget ex "request_nodes")))
                  (let ((tr (jget node "tool_result_node")))
                    (when (hash-table-p tr)
                      (push (make-message (format nil "~A#~D" id n) ts
                                          (jobject "role" "toolResult" "toolCallId" (str (jget tr "tool_use_id"))
                                                   "content" (vector (text-block (result-text (jget tr "content"))))
                                                   "isError" (jbool (jbool-p (jget tr "is_error"))))
                                          nil)
                            out)
                      (incf n))))
                (let ((req (str (jget ex "request_message"))))
                  (unless (string= req "") (push (role-message id ts "user" (list (text-block req))) out)))
                (let ((content '()))
                  (let ((resp (str (jget ex "response_text"))))
                    (unless (string= resp "") (push (text-block resp) content)))
                  (dolist (node (content-blocks (jget ex "response_nodes")))
                    (let ((tu (jget node "tool_use")))
                      (when (hash-table-p tu)
                        (let ((args (str (jget tu "input_json"))))
                          (multiple-value-bind (parsed ok) (try-json-any args)
                            (when ok (setf args parsed)))
                          (push (tool-call-block (str (jget tu "tool_use_id")) (str (jget tu "tool_name")) args) content)))))
                  (when content (push (role-message (cat id ":a") ts "assistant" (reverse content)) out))))))))
      (nreverse out))))

;;; The registry (generic.go's Formats).

(defparameter *transcript-formats*
  '(("claude-code" . read-claude-code) ("droid" . read-droid) ("deepagents" . read-deepagents)
    ("cursor" . read-cursor) ("qoder" . read-qoder) ("cline" . read-cline) ("neovate" . read-neovate)
    ("iflow" . read-iflow) ("cortex" . read-cortex) ("auggie" . read-auggie) ("kiro" . read-kiro)
    ("copilot" . read-copilot) ("gemini" . read-gemini) ("qwen" . read-qwen) ("kimi" . read-kimi)
    ("codex" . read-codex) ("pi" . read-pi) ("generic" . read-generic))
  "The readers by harness name, as om's --harness flag names them.")

(defun transcript-format (name)
  (let ((f (cdr (assoc name *transcript-formats* :test #'string=))))
    (unless f (error "transcript: unknown format ~A" name))
    f))

(defun transcript-file-entries (format path)
  "File.Entries: the file at path read in the named format; a missing file is empty."
  (funcall (transcript-format format) (read-transcript-lines path)))
