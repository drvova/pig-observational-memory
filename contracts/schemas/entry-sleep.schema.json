{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "om.sleep entry",
  "description": "One sleep pass's record (docs/memory-v2.md, \"Sleep\"; docs/brain-memory.md, decision 13): the duplicates it hid, the links of shared keys, the records decay lowers, the project records verified or retired against HEAD, and the checks of level-1 supersedes and lessons, the contradictions the joint-consistency check found and the promise syndromes it rechecked, each only what no earlier sleep record on the branch said. It never deletes a record. Source: memory/ledger/sleep.go (SleepData), written by memory/hooks/sleep_v2.go (RunSleep) and lisp/src/sleep.lisp.",
  "$ref": "defs.schema.json#/$defs/customEntry",
  "properties": {
    "customType": {
      "const": "om.sleep"
    },
    "data": {
      "type": "object",
      "required": ["version", "trigger", "throughEntryId", "records"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": 1},
        "trigger": {"enum": ["compaction", "idle", "manual"]},
        "throughEntryId": {"$ref": "defs.schema.json#/$defs/entryId"},
        "records": {"type": "integer", "minimum": 0},
        "duplicates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "of", "by"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "defs.schema.json#/$defs/recordId"},
              "of": {"$ref": "defs.schema.json#/$defs/recordId"},
              "by": {"enum": ["hash", "error"]}
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "ids"],
            "additionalProperties": false,
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "ids": {"type": "array", "minItems": 2, "items": {"$ref": "defs.schema.json#/$defs/recordId"}}
            }
          }
        },
        "decayed": {"type": "array", "items": {"$ref": "defs.schema.json#/$defs/recordId"}},
        "verified": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "head", "verdict"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "defs.schema.json#/$defs/recordId"},
              "head": {"type": "string", "minLength": 1},
              "verdict": {"enum": ["holds", "changed"]}
            }
          }
        },
        "retired": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "head", "reason"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "defs.schema.json#/$defs/recordId"},
              "head": {"type": "string", "minLength": 1},
              "reason": {"const": "gone"}
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "verdict"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "defs.schema.json#/$defs/recordId"},
              "kind": {"enum": ["supersede", "lesson"]},
              "verdict": {"enum": ["holds", "challenged"]},
              "by": {"type": "array", "items": {"$ref": "defs.schema.json#/$defs/recordId"}}
            }
          }
        },
        "contradictions": {
          "description": "The joint-consistency check's findings (memory/sleep/consistency.go): records of one scope whose preferences no strict order satisfies, a minimal conflicting set in ledger order, the values in cycle order (each used over the next, the last over the first), and the steps the check spent on their cluster. The fold labels a believed member contested; nothing is resolved.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ids", "cycle", "steps"],
            "additionalProperties": false,
            "properties": {
              "ids": {"type": "array", "minItems": 1, "items": {"$ref": "defs.schema.json#/$defs/recordId"}},
              "cycle": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
              "scope": {"type": "string", "minLength": 1},
              "steps": {"type": "integer", "minimum": 1}
            }
          }
        },
        "unchecked": {"description": "Clusters the joint-consistency check left over its bounds (sleep.MaxClusterRecords, MaxCheckSteps).", "type": "integer", "minimum": 1},
        "promises": {"description": "The compactions' promise syndromes the pass checked against the ledger and their summaries' text (ledger.SleepPromiseChecks), each compaction once: a protected record lost is named by id.", "type": "array", "items": {"$ref": "defs.schema.json#/$defs/promiseCheck"}}
      }
    }
  }
}
