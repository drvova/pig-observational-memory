;;;; memory/legacyquery (frozen): the recognizer of the memory tool's removed query language, a
;;;; port of its lexer and parser (lexer.go, parser.go), Substitute (substitute.go) and the strict
;;;; legacy-to-snippet hint (hint.go) over om.FormatReadStrict (om/snippet.go). It never runs a
;;;; query: level 0 reads an old save or edit as a note, the detectors read what an old read asked
;;;; for, and om.Retired() and /om:status print each retired defined query's equivalent snippet
;;;; (docs/lisp-port-status.md). Positions count characters, as Go counts runes.

(defpackage "OM.LEGACY" (:use "COMMON-LISP" "OM.BASE" "OM.KERNEL" "OM.READERS" "OM.ENGINE"))

(in-package "OM.LEGACY")

(defparameter +sources+ '("notes" "reflections" "history" "saved" "recall" "harness"))
(defparameter +stages+ '("search" "where" "since" "until" "from" "through" "sort" "limit" "count" "group"))
(defparameter +writes+ '("save" "edit" "forget" "feedback" "define" "propose" "harness" "rollback"))
(defparameter +lq-max-limit+ 200 "om.MaxLimit.")
(defparameter +input-parameter+ "input")
(defparameter +harness-forget+ "harness forget")

(defparameter +write-args+
  '(("save" ("name" "type" "description") ("body" "scope" "quote"))
    ("edit" ("name") ("type" "description" "body"))
    ("forget" ("name") ())
    ("feedback" ("name" "outcome" "quote") ())
    ("propose" ("detector" "remedy") ("text" "kind" "fullness"))
    ("harness" ("kind" "name" "text") ())
    ("harness forget" ("kind" "name") ())))

(defun mem (s list) (and (member s list :test #'string=) t))

;;; Errors

(define-condition query-error (error)
  ((pos :initarg :pos :initform 0 :reader qe-pos)
   (msg :initarg :msg :reader qe-msg)
   (hint :initarg :hint :initform "" :reader qe-hint))
  (:report (lambda (c s) (write-string (query-error-text c) s))))

(defun query-error-text (e)
  "Error.Error: \"at character P: msg; hint\"."
  (let ((s (if (plusp (qe-pos e)) (format nil "at character ~D: ~A" (qe-pos e) (qe-msg e)) (qe-msg e))))
    (if (string/= (qe-hint e) "") (concatenate 'string s "; " (qe-hint e)) s)))

;;; The lexer

(defstruct tok kind (text "") (pos 0) (start 0) (end 0))

(defun kind-string (k)
  (case k (:word "word") (:string "quoted text") (:pipe "|") (:eq "=") (:tilde "~") (t "end of query")))

(defun lq-clip-runes (s n) (if (<= (length s) n) s (concatenate 'string (subseq s 0 n) "…")))

(defun describe-tok (tk)
  (case (tok-kind tk)
    (:word (go-quote (tok-text tk)))
    (:string (concatenate 'string "quoted text " (go-quote (lq-clip-runes (tok-text tk) 30))))
    (:eof "the end of the query")
    (t (go-quote (kind-string (tok-kind tk))))))

(defun fail-at (tk hint fmt &rest args)
  (error 'query-error :pos (tok-pos tk) :msg (apply #'format nil fmt args) :hint hint))

(defun word-rune-p (c) (not (or (space-p c) (find c "\"|=~"))))

(defun lex-string (query i pos)
  "lexString: (values token next next-pos)."
  (let ((start i) (start-pos pos) (n (length query)) (b (make-string-output-stream)))
    (incf i) (incf pos)
    (loop while (< i n)
          do (let ((c (char query i)))
               (cond ((char= c #\")
                      (return-from lex-string
                        (values (make-tok :kind :string :text (get-output-stream-string b) :pos start-pos :start start :end (1+ i))
                                (1+ i) (1+ pos))))
                     ((and (char= c #\\) (< (1+ i) n))
                      (let ((next (char query (1+ i))))
                        (case next
                          ((#\" #\\) (write-char next b))
                          (#\n (write-char #\Newline b))
                          (#\t (write-char #\Tab b))
                          (t (write-char c b) (write-char next b)))
                        (incf i 2) (incf pos 2)))
                     (t (write-char c b) (incf i) (incf pos)))))
    (error 'query-error :pos start-pos :msg "unterminated quote" :hint "close the text with \" (write \\\" for a quote inside it)")))

(defun lex (query)
  "lex: the tokens, ending with one :eof."
  (let ((out '()) (pos 1) (i 0) (n (length query)))
    (loop while (< i n)
          do (let ((c (char query i)))
               (cond ((space-p c) (incf i) (incf pos))
                     ((find c "|=~")
                      (push (make-tok :kind (case c (#\| :pipe) (#\= :eq) (t :tilde)) :text (string c) :pos pos :start i :end (1+ i)) out)
                      (incf i) (incf pos))
                     ((char= c #\")
                      (multiple-value-bind (tk next next-pos) (lex-string query i pos)
                        (push tk out) (setf i next pos next-pos)))
                     (t (let ((start i) (start-pos pos))
                          (loop while (and (< i n) (word-rune-p (char query i))) do (incf i) (incf pos))
                          (push (make-tok :kind :word :text (subseq query start i) :pos start-pos :start start :end i) out))))))
    (coerce (nreverse (cons (make-tok :kind :eof :pos pos :start n :end n) out)) 'simple-vector)))

;;; The parser

(defstruct lstage kind (words "") (value "") (field "") (op nil) (desc nil) (n 0) (event nil) (asof nil))

(defstruct lquery (source "") (id "") (offset 0) (paged nil) (stages '()) (write "") (args '())
  define forget (n 0))

(defun lq-arg (q key) (cdr (assoc key (lquery-args q) :test #'string=)))

(defstruct (parser (:conc-name p-)) query tokens (i 0))

(defun lq-peek (p) (aref (p-tokens p) (p-i p)))
(defun lq-peek-at (p k) (aref (p-tokens p) (min (+ (p-i p) k) (1- (length (p-tokens p))))))
(defun next-tok (p)
  (let ((tk (lq-peek p))) (unless (eq (tok-kind tk) :eof) (incf (p-i p))) tk))

(defun word-p (tk &optional text) (and (eq (tok-kind tk) :word) (or (null text) (string= (tok-text tk) text))))
(defun value-tok-p (tk) (member (tok-kind tk) '(:word :string)))

(defun legacy-parse (query)
  "legacyquery.Parse: the lquery, or a query-error."
  (let* ((p (make-parser :query query :tokens (lex query))) (first (lq-peek p)))
    (when (eq (tok-kind first) :eof)
      (error 'query-error :msg "empty query"
                          :hint (format nil "start with a source (~A) or a write (~A)" (join +sources+ ", ") (join +writes+ ", "))))
    (when (eq (tok-kind first) :word)
      (let ((text (tok-text first)))
        (cond ((string= text "define") (return-from legacy-parse (parse-define p)))
              ((mem text '("save" "edit" "forget" "feedback" "propose")) (return-from legacy-parse (parse-write p)))
              ((string= text "rollback") (return-from legacy-parse (parse-rollback p)))
              ((string= text "harness")
               (let ((next (lq-peek-at p 1)))
                 (unless (member (tok-kind next) '(:eof :pipe))
                   (return-from legacy-parse (parse-write p))))))))
    (let ((q (parse-read p nil)) (tk (lq-peek p)))
      (unless (eq (tok-kind tk) :eof)
        (fail-at tk "separate stages with |" "unexpected ~A" (describe-tok tk)))
      q)))

(defun parse-read (p in-define)
  (let ((tk (next-tok p)))
    (unless (and (word-p tk) (mem (tok-text tk) +sources+))
      (fail-at tk (if (and (word-p tk) (mem (tok-text tk) +stages+))
                      (format nil "a stage needs a source first, e.g. notes | ~A ..." (tok-text tk))
                      (format nil "start with a source: ~A; or a write: ~A" (join +sources+ ", ") (join +writes+ ", ")))
               "unknown source ~A" (describe-tok tk)))
    (let ((q (make-lquery :source (tok-text tk))))
      (when (string= (lquery-source q) "recall")
        (let ((id (next-tok p)))
          (when (or (not (value-tok-p id)) (string= (trim-space (tok-text id)) ""))
            (fail-at id "write recall <id>: a note or reflection id, an entry id or a saved memory name"
                     "recall needs an id, got ~A" (describe-tok id)))
          (setf (lquery-id q) (trim-space (tok-text id))))
        (when (word-p (lq-peek p) "offset")
          (next-tok p)
          (let* ((n (next-tok p)) (v (and (word-p n) (atoi (tok-text n)))))
            (when (or (null v) (< v 0))
              (fail-at n "write recall <entry id> offset N with the offset a paged recall named"
                       "offset needs a whole number from 0, got ~A" (describe-tok n)))
            (setf (lquery-offset q) v (lquery-paged q) t)))
        (let ((next (lq-peek p)))
          (when (eq (tok-kind next) :pipe)
            (fail-at next "run recall on its own; to filter records use notes, reflections, history or saved" "recall takes no stages")))
        (return-from parse-read q))
      (loop
        (let ((tk (lq-peek p)))
          (when (or (eq (tok-kind tk) :eof) (and in-define (eq (tok-kind tk) :string)))
            (setf (lquery-stages q) (nreverse (lquery-stages q)))
            (return q))
          (unless (eq (tok-kind tk) :pipe)
            (fail-at tk "separate stages with |" "unexpected ~A" (describe-tok tk)))
          (next-tok p)
          (push (parse-stage p) (lquery-stages q)))))))

(defun field-tok (p stage)
  (let ((tk (next-tok p)))
    (unless (word-p tk)
      (fail-at tk (format nil "name a field of the source, e.g. ~A id" stage) "~A needs a field, got ~A" stage (describe-tok tk)))
    tk))

(defun leap-p (y) (and (zerop (mod y 4)) (or (/= 0 (mod y 100)) (zerop (mod y 400)))))

(defun valid-date-p (s)
  "time.Parse(\"2006-01-02\", s) succeeds."
  (and (= (length s) 10) (char= (char s 4) #\-) (char= (char s 7) #\-)
       (every #'digit-char-p (concatenate 'string (subseq s 0 4) (subseq s 5 7) (subseq s 8 10)))
       (let ((y (parse-integer s :end 4)) (m (parse-integer s :start 5 :end 7)) (d (parse-integer s :start 8)))
         (and (<= 1 m 12) (<= 1 d (case m ((1 3 5 7 8 10 12) 31) ((4 6 9 11) 30) (t (if (leap-p y) 29 28))))))))

(defun parse-stage (p)
  (let ((tk (next-tok p)))
    (unless (and (word-p tk) (mem (tok-text tk) +stages+))
      (fail-at tk (if (and (word-p tk) (mem (tok-text tk) +sources+))
                      "a query has one source, at its start"
                      (concatenate 'string "stages are: " (join +stages+ ", ")))
               "unknown stage ~A" (describe-tok tk)))
    (let* ((kind (tok-text tk)) (s (make-lstage :kind kind)))
      (cond
        ((string= kind "search")
         (let ((w (next-tok p)))
           (when (or (not (value-tok-p w)) (string= (trim-space (tok-text w)) ""))
             (fail-at w "write search \"words\": every word must appear" "search needs words, got ~A" (describe-tok w)))
           (setf (lstage-words s) (tok-text w))))
        ((string= kind "where")
         (let ((f (field-tok p kind)))
           (setf (lstage-field s) (tok-text f))
           (let ((op (next-tok p)))
             (unless (member (tok-kind op) '(:eq :tilde))
               (fail-at op "write where field=value (equals) or where field~\"text\" (contains)"
                        "where needs = or ~~ after ~A, got ~A" (tok-text f) (describe-tok op)))
             (setf (lstage-op s) (char (tok-text op) 0))
             (let ((v (next-tok p)))
               (unless (value-tok-p v)
                 (fail-at v "quote a value with spaces: where field~\"some text\"" "where ~A~A needs a value, got ~A"
                          (tok-text f) (tok-text op) (describe-tok v)))
               (setf (lstage-value s) (tok-text v))))))
        ((mem kind '("since" "until"))
         (let ((d (next-tok p)))
           (unless (and (value-tok-p d) (valid-date-p (tok-text d)))
             (fail-at d (format nil "write the date as YYYY-MM-DD, e.g. ~A 2023-05-20" kind) "~A needs a date, got ~A" kind (describe-tok d)))
           (setf (lstage-value s) (tok-text d))
           (modifiers p s)))
        ((mem kind '("from" "through"))
         (let ((id (next-tok p)))
           (when (or (not (value-tok-p id)) (string= (trim-space (tok-text id)) ""))
             (fail-at id (format nil "write ~A <entry id>, an id from history or a summary line" kind)
                      "~A needs an entry id, got ~A" kind (describe-tok id)))
           (setf (lstage-value s) (trim-space (tok-text id)))
           (modifiers p s)))
        ((string= kind "sort")
         (setf (lstage-field s) (tok-text (field-tok p kind)))
         (let ((d (lq-peek p)))
           (when (and (word-p d) (mem (tok-text d) '("desc" "asc")))
             (next-tok p)
             (setf (lstage-desc s) (string= (tok-text d) "desc")))))
        ((string= kind "limit")
         (let* ((n (next-tok p)) (v (and (word-p n) (atoi (tok-text n)))))
           (when (or (null v) (< v 1) (> v +lq-max-limit+))
             (fail-at n (format nil "write limit N with N from 1 to ~D; narrow with search or where for fewer rows" +lq-max-limit+)
                      "limit needs a whole number from 1 to ~D, got ~A" +lq-max-limit+ (describe-tok n)))
           (setf (lstage-n s) v)))
        ((string= kind "count")
         (when (word-p (lq-peek p) "by")
           (next-tok p)
           (setf (lstage-field s) (tok-text (field-tok p "count by")))))
        ((string= kind "group")
         (let ((by (next-tok p)))
           (unless (word-p by "by")
             (fail-at by "write group by field" "group needs by, got ~A" (describe-tok by)))
           (setf (lstage-field s) (tok-text (field-tok p "group by"))))))
      s)))

(defun modifiers (p s)
  (loop
    (let ((tk (lq-peek p)))
      (unless (and (word-p tk) (mem (tok-text tk) '("event" "asof"))) (return))
      (next-tok p)
      (let ((text (tok-text tk)) (kind (lstage-kind s)))
        (cond ((and (string= text "event") (not (mem kind '("since" "until"))))
               (fail-at tk "event compares event dates: write since DATE event or until DATE event" "~A takes no event" kind))
              ((and (string= text "asof") (not (mem kind '("until" "through"))))
               (fail-at tk "asof reads the memory as it stood at an end bound: write until DATE asof or through ID asof" "~A takes no asof" kind))
              ((or (and (string= text "event") (lstage-event s)) (and (string= text "asof") (lstage-asof s)))
               (fail-at tk (format nil "write ~A once" text) "~A given twice" text))
              ((or (and (string= text "event") (lstage-asof s)) (and (string= text "asof") (lstage-event s)))
               (fail-at tk "the point-in-time view (asof) is read at entry time; drop event, or asof" "event and asof cannot be combined")))
        (if (string= text "event") (setf (lstage-event s) t) (setf (lstage-asof s) t))))))

(defun write-usage (write)
  (cond ((string= write "save") "save name=<name> type=user|feedback|project|reference|lesson description=\"one sentence\" [body=\"why and how to apply it\"] [scope=global|project] [quote=\"the user's words that confirm it\"]")
        ((string= write "edit") "edit name=<name> [type=...] [description=\"...\"] [body=\"...\"]")
        ((string= write "forget") "forget name=<name>")
        ((string= write "feedback") "feedback name=<name> outcome=helped|harmed quote=\"words from this conversation that show it\"")
        ((string= write "define") "define <name> = <query> \"what it returns\"")
        ((string= write "propose") "propose detector=<detector> remedy=<remedy> [text=\"one line for your worker prompt\"] [kind=<kind>] [fullness=<number>]")
        ((string= write "harness") "harness kind=format|schema|instructions|summary|detector|remedy name=<name> text=\"the declarative definition\"")
        ((string= write +harness-forget+) "harness forget kind=<kind> name=<name>")
        ((string= write "rollback") "rollback <generation> [model=\"provider/id\"]")
        (t write)))

(defun parse-write (p)
  (let* ((tk (next-tok p)) (q (make-lquery :write (tok-text tk))) (form (tok-text tk)))
    (when (and (string= form "harness") (word-p (lq-peek p) "forget"))
      (next-tok p)
      (setf (lquery-forget q) t form +harness-forget+))
    (destructuring-bind (required optional) (cdr (assoc form +write-args+ :test #'string=))
      (let ((allowed (append required optional)) (usage (write-usage form)))
        (loop
          (let ((k (next-tok p)))
            (when (eq (tok-kind k) :eof) (return))
            (unless (word-p k)
              (fail-at k (concatenate 'string "write " usage) "expected key=value, got ~A" (describe-tok k)))
            (unless (mem (tok-text k) allowed)
              (fail-at k (format nil "~A takes ~A: ~A" (tok-text tk) (join allowed ", ") usage) "unknown key ~A" (go-quote (tok-text k))))
            (when (assoc (tok-text k) (lquery-args q) :test #'string=)
              (fail-at k "give each key once" "~A given twice" (tok-text k)))
            (let ((eq (next-tok p)))
              (unless (eq (tok-kind eq) :eq)
                (fail-at eq (format nil "write ~A=value, quoting a value with spaces" (tok-text k))
                         "~A needs = and a value, got ~A" (tok-text k) (describe-tok eq))))
            (let ((v (next-tok p)))
              (unless (value-tok-p v)
                (fail-at v (format nil "quote a value with spaces: ~A=\"some text\"" (tok-text k))
                         "~A= needs a value, got ~A" (tok-text k) (describe-tok v)))
              (setf (lquery-args q) (append (lquery-args q) (list (cons (tok-text k) (tok-text v))))))))
        (dolist (key required)
          (unless (assoc key (lquery-args q) :test #'string=)
            (fail-at tk (concatenate 'string "write " usage) "~A needs ~A=" (tok-text tk) key)))))
    q))

(defun parse-rollback (p)
  (let* ((tk (next-tok p)) (usage (write-usage "rollback")) (n (next-tok p))
         (gen (and (word-p n) (atoi (tok-text n)))))
    (declare (ignorable tk))
    (when (or (null gen) (< gen 0))
      (fail-at n (format nil "write ~A: N is a generation number, 0 for the seeds alone" usage)
               "rollback needs a generation number, got ~A" (describe-tok n)))
    (let ((q (make-lquery :write "rollback" :n gen)) (k (next-tok p)))
      (unless (eq (tok-kind k) :eof)
        (unless (word-p k "model")
          (fail-at k (concatenate 'string "write " usage) "rollback takes only model=, got ~A" (describe-tok k)))
        (let ((eq (next-tok p)))
          (unless (eq (tok-kind eq) :eq)
            (fail-at eq (concatenate 'string "write " usage) "model needs = and a value, got ~A" (describe-tok eq))))
        (let ((v (next-tok p)))
          (unless (value-tok-p v)
            (fail-at v "quote the model id: model=\"provider/id\"" "model= needs a value, got ~A" (describe-tok v)))
          (setf (lquery-args q) (list (cons "model" (tok-text v)))))
        (let ((rest (lq-peek p)))
          (unless (eq (tok-kind rest) :eof)
            (fail-at rest (concatenate 'string "write " usage) "unexpected ~A" (describe-tok rest)))))
      q)))

(defun parse-define (p)
  (next-tok p)
  (let* ((usage (write-usage "define")) (name (next-tok p)))
    (unless (word-p name)
      (fail-at name (concatenate 'string "write " usage) "define needs a name, got ~A" (describe-tok name)))
    (let ((eq (next-tok p)))
      (unless (eq (tok-kind eq) :eq)
        (fail-at eq (concatenate 'string "write " usage) "define ~A needs = and a query, got ~A" (tok-text name) (describe-tok eq))))
    (let ((body (lq-peek p)))
      (when (and (word-p body) (mem (tok-text body) +writes+))
        (fail-at body "define a read query: a source and its stages" "a defined query cannot write"))
      (parse-read p t)
      (let ((end (tok-end (aref (p-tokens p) (1- (p-i p))))) (desc (next-tok p)))
        (when (or (not (eq (tok-kind desc) :string)) (string= (trim-space (tok-text desc)) ""))
          (fail-at desc (concatenate 'string "end with what it returns in quotes: " usage) "define needs a description"))
        (let ((rest (lq-peek p)))
          (unless (eq (tok-kind rest) :eof)
            (fail-at rest "the description ends the define" "unexpected ~A" (describe-tok rest))))
        (make-lquery :write "define"
                     :define (list (tok-text name) (trim-space (subseq (p-query p) (tok-start body) end)) (tok-text desc)))))))

(defun try-parse (query)
  "Parse: (values query nil), or (values nil error-text)."
  (handler-case (values (legacy-parse query) nil)
    (query-error (e) (values nil (query-error-text e)))))

;;; Substitute

(defun substitute-input (query input)
  "legacyquery.Substitute: every $input replaced by input, escaped inside a quoted text, else a
bare word when it is one and a quoted text otherwise."
  (let* ((placeholder "$input")
         (escaped (with-output-to-string (o)
                    (loop for c across input
                          do (case c (#\\ (write-string "\\\\" o)) (#\" (write-string "\\\"" o))
                                   (#\Newline (write-string "\\n" o)) (#\Tab (write-string "\\t" o))
                                   (t (write-char c o))))))
         (bare (and (string/= input "") (every #'word-rune-p input)))
         (quoted nil) (i 0) (n (length query)))
    (with-output-to-string (b)
      (loop while (< i n)
            do (cond ((and quoted (char= (char query i) #\\) (< (1+ i) n))
                      (write-string query b :start i :end (+ i 2)) (incf i 2))
                     ((char= (char query i) #\")
                      (setf quoted (not quoted)) (write-char #\" b) (incf i))
                     ((and (<= (+ i (length placeholder)) n) (string= placeholder query :start2 i :end2 (+ i (length placeholder))))
                      (cond (quoted (write-string escaped b))
                            (bare (write-string input b))
                            (t (write-char #\" b) (write-string escaped b) (write-char #\" b)))
                      (incf i (length placeholder)))
                     (t (write-char (char query i) b) (incf i)))))))

;;; om.FormatReadStrict (om/snippet.go formatRead with strict on; the CheckSnippet it runs after
;;; always passes for what this writer prints, so it is not run)

(defparameter +read-funcs+ '("Notes" "Reflections" "History" "Files" "Commits" "Attempts" "Dropped" "Saved" "Layer" "Retired" "Recall"))

(defun hex-run-p (s start end)
  (loop for i from start below end always (find (char s i) "0123456789abcdef")))

(defun valid-id-p (id)
  "ids.Valid: a record id (12 hex) or an entry id (8 hex, or a UUID), with \" (off-path)\" allowed after it."
  (let ((id (if (has-suffix id " (off-path)") (subseq id 0 (- (length id) 11)) id)))
    (or (and (= (length id) 12) (hex-run-p id 0 12))
        (and (= (length id) 8) (hex-run-p id 0 8))
        (and (= (length id) 36)
             (every (lambda (p) (char= (char id p) #\-)) '(8 13 18 23))
             (hex-run-p id 0 8) (hex-run-p id 9 13) (hex-run-p id 14 18) (hex-run-p id 19 23) (hex-run-p id 24 36)))))

(defun lower-alnum-p (c) (or (char<= #\a c #\z) (char<= #\0 c #\9)))

(defun snippet-field-p (s)
  (and (<= 1 (length s) 64) (char<= #\a (char s 0) #\z)
       (every (lambda (c) (or (lower-alnum-p c) (char= c #\_))) s)))

(defun snippet-name-p (s)
  (and (<= 1 (length s) 64) (lower-alnum-p (char s 0))
       (every (lambda (c) (or (lower-alnum-p c) (char= c #\-))) s)))

(defun snippet-date-p (s)
  (and (= (length s) 10) (char= (char s 4) #\-) (char= (char s 7) #\-)
       (every #'digit-char-p (remove #\- s)) (= (count #\- s) 2)))

(defun raw-value (s)
  (if (find-if (lambda (c) (or (char= c #\`) (char= c #\Return))) s) (go-quote s) (concatenate 'string "`" s "`")))

(defstruct opts (search '()) (where '()) (contains '()) (from "") (through "") (since "") (until "")
  (by-event nil) (asof nil) (sort-field "") (sort-desc nil) limit offset)

(defun format-read-strict (fn id o tail)
  "om.FormatReadStrict: (values snippet nil), or (values nil why)."
  (let ((err nil) (parts '()))
    (labels ((fail (fmt &rest args) (unless err (setf err (apply #'format nil fmt args))))
             (add (method &rest args) (push (format nil "~A(~{~A~^, ~})" method args) parts))
             (word (s) (go-quote s))
             (field (s) (unless (snippet-field-p s) (fail "~A is not a field name" (go-quote s))) (word s))
             (idv (s) (unless (valid-id-p s) (fail "~A is not a record or entry id" (go-quote s))) (raw-value s))
             (date (s) (unless (snippet-date-p s) (fail "~A is not a YYYY-MM-DD date" (go-quote s))) (raw-value s)))
      (unless (member fn +read-funcs+ :test #'string=) (return-from format-read-strict (values nil (format nil "~A is not a read" fn))))
      (unless (or (string= tail "") (string= tail "Matched"))
        (return-from format-read-strict (values nil (format nil "~A is not a field a snippet selects" tail))))
      (dolist (s (opts-search o)) (add "Search" (word s)))
      (dolist (pr (opts-where o)) (add "Where" (field (car pr)) (word (cdr pr))))
      (dolist (pr (opts-contains o)) (add "Contains" (field (car pr)) (word (cdr pr))))
      (when (string/= (opts-from o) "") (add "From" (idv (opts-from o))))
      (when (string/= (opts-through o) "") (add "Through" (idv (opts-through o))))
      (when (string/= (opts-since o) "") (add "Since" (date (opts-since o))))
      (when (string/= (opts-until o) "") (add "Until" (date (opts-until o))))
      (when (opts-by-event o) (add "ByEvent"))
      (when (opts-asof o) (add "AsOf"))
      (when (string/= (opts-sort-field o) "") (add "SortBy" (field (opts-sort-field o)) (if (opts-sort-desc o) "true" "false")))
      (when (opts-limit o)
        (unless (<= 1 (opts-limit o) +lq-max-limit+) (fail "limit ~D is outside 1 to ~D" (opts-limit o) +lq-max-limit+))
        (add "Limit" (itoa (opts-limit o))))
      (when (opts-offset o)
        (when (or (string/= fn "Recall") (< (opts-offset o) 0)) (fail "an offset pages a recall only"))
        (add "Offset" (itoa (opts-offset o))))
      (let ((args '()))
        (cond ((string= fn "Recall")
               (unless (or (valid-id-p id) (snippet-name-p id))
                 (fail "~A is not a record id, an entry id or a saved name" (go-quote id)))
               (push (raw-value id) args))
              ((string/= id "") (fail "~A takes no id" fn)))
        (when err (return-from format-read-strict (values nil err)))
        (when parts (setf args (append args (list (concatenate 'string "om." (join (reverse parts) "."))))))
        (values (format nil "om.~A(~{~A~^, ~})~A" fn args (if (string= tail "") "" (concatenate 'string "." tail))) nil)))))

;;; Hint

(defparameter +source-funcs+
  '(("notes" . "Notes") ("reflections" . "Reflections") ("history" . "History") ("saved" . "Saved")
    ("harness" . "Layer") ("recall" . "Recall")))

(defparameter +write-equivalents+
  '(("save" . "om.Save") ("edit" . "om.Edit") ("forget" . "om.ForgetMemory") ("feedback" . "om.Feedback")
    ("define" . "a kept func (om.Define only says defined tools are retired)")
    ("propose" . "nothing: rules are proposed inside the compaction's consolidation request (om.Propose says so)")
    ("harness" . "om.LayerForget (definitions are proposed inside the compaction's consolidation request)")
    ("rollback" . "om.LayerRollback")))

(defun hint (query)
  "legacyquery.Hint: (values snippet reason), the snippet \"\" with why there is none."
  (when (search "$input" query)
    (return-from hint (values "" "it takes $input: keep a func with a parameter instead")))
  (multiple-value-bind (q err) (try-parse query)
    (if err (values "" (concatenate 'string "it does not parse: " err)) (hint-of q))))

(defun hint-of (q)
  "legacyquery.HintOf."
  (when (string/= (lquery-write q) "")
    (return-from hint-of
      (values "" (format nil "it is a write (~A); its replacement is ~A" (lquery-write q)
                         (cdr (assoc (lquery-write q) +write-equivalents+ :test #'string=))))))
  (let ((fn (cdr (assoc (lquery-source q) +source-funcs+ :test #'string=))) (o (make-opts)))
    (when (string= (lquery-source q) "recall")
      (when (lquery-paged q) (setf (opts-offset o) (lquery-offset q)))
      (multiple-value-bind (s why) (format-read-strict fn (lquery-id q) o "")
        (return-from hint-of (if s (values s "") (values "" (concatenate 'string "no snippet: " why))))))
    (let ((phase 0) (tail "") (seen '()) (event '()) (asof nil))
      (flet ((field (f) (if (and (string= (lquery-source q) "history") (string= f "content")) "text" f))
             (none (why) (return-from hint-of (values "" why))))
        (dolist (s (lquery-stages q))
          (let ((kind (lstage-kind s)))
            (cond ((mem kind '("search" "where" "since" "until" "from" "through"))
                   (when (/= phase 0) (none "no exact equivalent: a filter after sort, limit or count")))
                  ((string= kind "sort")
                   (when (/= phase 0) (none "no exact equivalent: sort after limit or count"))
                   (setf phase 1))
                  ((string= kind "limit")
                   (when (> phase 1) (none "no exact equivalent: limit after count"))
                   (setf phase 2))
                  ((string= kind "count")
                   (when (string/= (lstage-field s) "")
                     (none (format nil "no exact equivalent in one call: count by reads every row; read with om.Limit(200) and call .Count(\"~A\") on the list" (lstage-field s))))
                   (when (= phase 2) (none "no exact equivalent: count after limit"))
                   (setf phase 3 tail "Matched"))
                  ((string= kind "group")
                   (none (format nil "no exact equivalent in one call: group by reads every row; read with om.Limit(200) and call .Group(\"~A\") on the list" (lstage-field s)))))
            (when (mem kind '("since" "until" "from" "through" "sort" "limit"))
              (when (mem kind seen) (none (format nil "no exact equivalent: ~A given twice" kind)))
              (push kind seen))
            (cond ((string= kind "search") (setf (opts-search o) (append (opts-search o) (list (lstage-words s)))))
                  ((string= kind "where")
                   (let ((pr (cons (field (lstage-field s)) (lstage-value s))))
                     (if (eql (lstage-op s) #\~)
                         (setf (opts-contains o) (append (opts-contains o) (list pr)))
                         (setf (opts-where o) (append (opts-where o) (list pr))))))
                  ((string= kind "since") (setf (opts-since o) (lstage-value s)) (push (cons kind (lstage-event s)) event))
                  ((string= kind "until") (setf (opts-until o) (lstage-value s)) (push (cons kind (lstage-event s)) event)
                   (setf asof (or asof (lstage-asof s))))
                  ((string= kind "from") (setf (opts-from o) (lstage-value s)))
                  ((string= kind "through") (setf (opts-through o) (lstage-value s)) (setf asof (or asof (lstage-asof s))))
                  ((string= kind "sort") (setf (opts-sort-field o) (field (lstage-field s)) (opts-sort-desc o) (lstage-desc s)))
                  ((string= kind "limit") (setf (opts-limit o) (lstage-n s))))))
        (let ((since-event (cdr (assoc "since" event :test #'string=)))
              (until-event (cdr (assoc "until" event :test #'string=))))
          (when (and (mem "since" seen) (mem "until" seen) (not (eq since-event until-event)))
            (none "no exact equivalent: event on only one of since and until"))
          (setf (opts-by-event o) (or since-event until-event))
          (when (and asof (mem "until" seen) (mem "through" seen))
            (none "no exact equivalent: asof with both until and through"))
          (setf (opts-asof o) asof)
          (multiple-value-bind (s why) (format-read-strict fn "" o tail)
            (if s (values s "") (values "" (concatenate 'string "no snippet: " why)))))))))

;;; What old calls asked for (rules/detect.go legacyAsk)

(defun legacy-ask (query)
  "legacyAsk: (values recalled searches t) for a read, (values nil nil nil) for a write or a
query that does not parse."
  (when (string= (trim-space query) "") (return-from legacy-ask (values nil nil nil)))
  (let ((q (try-parse query)))
    (if (or (null q) (string/= (lquery-write q) ""))
        (values nil nil nil)
        (values (if (string= (lquery-source q) "recall") (list (lquery-id q)) '())
                (loop for s in (lquery-stages q) when (string= (lstage-kind s) "search") collect (lstage-words s))
                t))))

(export '(legacy-parse try-parse hint hint-of substitute-input legacy-ask lquery-write lquery-args lq-arg))
