;;;; memory/extract/output.go: level 0's reading of tool output (docs/memory-v2.md, "Tool
;;;; output"): value records, one per value kind and raw spelling per session, and evidence
;;;; records, at most eight verbatim lines of a result that failed or matched a failure grammar.
;;;; The scanners are a transliteration of the Go ones over ASCII character classes: a character
;;;; of code 128 or more is one class, "other", as a byte of 0x80 or more is in Go, so a scan
;;;; reads the same on characters as on bytes.

(in-package "OM.ENGINE")

(defparameter +value-kinds+
  '("path" "error" "sha" "url" "kv" "ip" "issue" "test" "branch" "symbol" "version"))

(defparameter +max-evidence-lines+ 8)
(defparameter +max-evidence-line-chars+ 160)
(defparameter +max-new-values+ 20)
(defparameter +max-url-chars+ 120)
(defparameter +max-value-chars+ 160)
(defparameter +evidence-separator+ " ⏎ ")

;;; Classes of a call: 0 none, 1 test, 2 build, 3 search, 4 git (outputClass).

;;; Character classes

(declaim (inline ox-code))
(defun ox-code (s i) (char-code (char s i)))
(defun ox-digit-p (c) (<= 48 c 57))
(defun ox-upper-p (c) (<= 65 c 90))
(defun ox-lower-p (c) (<= 97 c 122))
(defun ox-alpha-p (c) (or (ox-upper-p c) (ox-lower-p c)))
(defun ox-alnum-p (c) (or (ox-alpha-p c) (ox-digit-p c)))
(defun ox-ident-p (c) (or (ox-alnum-p c) (= c 95)))
(defun ox-hex-p (c) (or (ox-digit-p c) (<= 97 c 102)))
(defun ox-blank-p (c) (or (<= c 32) (= c 127)))
(defun ox-in (c chars) (find (code-char c) chars))

(defun ox-trim (s)
  (let ((start 0) (end (length s)))
    (loop while (and (< start end) (ox-blank-p (ox-code s start))) do (incf start))
    (loop while (and (> end start) (ox-blank-p (ox-code s (1- end)))) do (decf end))
    (subseq s start end)))

(defun ox-lower (s)
  (map 'string (lambda (c) (if (char<= #\A c #\Z) (char-downcase c) c)) s))

(defun ox-has-alnum (s) (some (lambda (c) (ox-alnum-p (char-code c))) s))

(defun ox-first-word (s)
  (let ((i (position-if (lambda (c) (ox-blank-p (char-code c))) s)))
    (if i (subseq s 0 i) s)))

(defun ox-index (s sub &optional (start 0)) (search sub s :start2 start))

;;; facts

(defstruct ofacts (values '()) (evidence '()) (shapes (make-set)) (seen (make-set)) failed)

(defun ofacts-value (f kind value)
  (when (or (string= value "") (> (length value) +max-value-chars+)) (return-from ofacts-value))
  (let ((key (cat kind ":" value)))
    (when (gethash key (ofacts-seen f)) (return-from ofacts-value))
    (unless (string= (redact-secrets value) value) (return-from ofacts-value))
    (setf (gethash key (ofacts-seen f)) t)
    (push-end (cons kind value) (ofacts-values f))))

(defun ofacts-line (f text)
  (let ((text (evidence-line text)))
    (when (or (string= text "") (>= (length (ofacts-evidence f)) +max-evidence-lines+))
      (return-from ofacts-line))
    (let ((shape (line-shape text)))
      (unless (gethash shape (ofacts-shapes f))
        (setf (gethash shape (ofacts-shapes f)) t)
        (push-end text (ofacts-evidence f))))))

(defparameter +lockfiles+
  '("go.sum" "package-lock.json" "poetry.lock" "Cargo.lock" "yarn.lock" "pnpm-lock.yaml" "composer.lock"
    "Gemfile.lock" "uv.lock" "bun.lockb"))

(defun lockfile-p (p)
  (let* ((i (position-if (lambda (c) (find c "/\\")) p :from-end t))
         (base (if i (subseq p (1+ i)) p)))
    (and (member-str base +lockfiles+) t)))

(defun output-facts-of (call text failed)
  "outputFactsOf."
  (let* ((f (make-ofacts)) (state (file-tool-state call)))
    (when (member state '("written" "edited" "deleted") :test #'equal) (return-from output-facts-of f))
    (when (equal state "read")
      (dolist (arg +path-args+)
        (let ((p (arg-string (tcall-args call) arg)))
          (when (and p (lockfile-p p)) (return-from output-facts-of f)))))
    (let* ((lines (output-lines text))
           (class (output-class call))
           (reading (or (equal state "read") (= class 3))))
      (unless reading
        (test-facts f lines)
        (diagnostic-facts f lines (or (= class 1) (= class 2)) failed))
      (when (= class 3) (search-facts f call text))
      (when (= class 4) (git-facts f lines))
      (unless reading
        (stack-facts f lines)
        (marker-facts f lines))
      (dolist (line lines) (scan-values f line (= class 4)))
      (when (and failed (null (ofacts-evidence f))) (fallback-evidence f lines))
      (when (and (not failed) (not (ofacts-failed f))) (setf (ofacts-evidence f) '()))
      f)))

;;; Noise

(defun output-lines (text)
  (let ((text (strip-ansi text)) (out '()))
    (dolist (line (split text (string #\Newline)) out)
      (loop while (has-suffix line (string #\Return)) do (setf line (subseq line 0 (1- (length line)))))
      (let ((i (position #\Return line :from-end t)))
        (when i (setf line (subseq line (1+ i)))))
      (unless (noise-line-p line) (push-end line out)))))

(defun strip-ansi (s)
  (unless (find (code-char 27) s) (return-from strip-ansi s))
  (let ((n (length s)))
    (with-output-to-string (b)
      (let ((i 0))
        (loop while (< i n)
              do (let ((c (ox-code s i)))
                   (cond ((/= c 27) (write-char (char s i) b))
                         ((>= (1+ i) n) (setf i n))
                         ((= (ox-code s (1+ i)) 91)
                          (let ((j (+ i 2)))
                            (loop while (and (< j n) (<= #x30 (ox-code s j) #x3f)) do (incf j))
                            (loop while (and (< j n) (<= #x20 (ox-code s j) #x2f)) do (incf j))
                            (when (and (< j n) (<= #x40 (ox-code s j) #x7e)) (incf j))
                            (setf i (1- j))))
                         ((= (ox-code s (1+ i)) 93)
                          (let ((j (+ i 2)))
                            (loop while (and (< j n) (/= (ox-code s j) 7)
                                             (or (/= (ox-code s j) 27) (>= (1+ j) n) (/= (ox-code s (1+ j)) 92)))
                                  do (incf j))
                            (cond ((and (< j n) (= (ox-code s j) 7)) (incf j))
                                  ((< j n) (incf j 2)))
                            (setf i (1- j))))
                         (t (incf i))))
                 (incf i))))))

(defparameter +progress-prefixes+
  '("Downloading " "Downloaded " "Collecting " "Fetching " "Resolving " "Receiving objects" "Counting objects"
    "Compressing objects" "Writing objects" "Unpacking objects" "Enumerating objects" "remote: Counting"
    "remote: Compressing" "remote: Enumerating" "remote: Total" "Progress: "))

(defparameter +bar-chars+ "█▓▒░■━")

(defun noise-line-p (line)
  (let ((tx (ox-trim line)))
    (when (string= tx "") (return-from noise-line-p nil))
    (when (or (percent-start-p tx) (rate-p tx) (contains tx "=====>") (contains tx "[######"))
      (return-from noise-line-p t))
    (dolist (p +progress-prefixes+)
      (when (has-prefix tx p) (return-from noise-line-p t)))
    (let ((run 0))
      (loop for c across tx
            do (if (find c +bar-chars+)
                   (when (>= (incf run) 6) (return-from noise-line-p t))
                   (setf run 0))))
    (binary-line-p tx)))

(defun percent-start-p (tx)
  (let ((i 0) (n (length tx)))
    (loop while (and (< i n) (< i 3) (ox-digit-p (ox-code tx i))) do (incf i))
    (when (= i 0) (return-from percent-start-p nil))
    (when (and (< i n) (char= (char tx i) #\.))
      (let ((j (1+ i)))
        (loop while (and (< j n) (ox-digit-p (ox-code tx j))) do (incf j))
        (when (> j (1+ i)) (setf i j))))
    (and (< i n) (char= (char tx i) #\%))))

(defun rate-p (tx)
  (let ((from 0))
    (loop
      (let ((k (ox-index tx "B/s" from)))
        (unless k (return nil))
        (setf from (1+ k))
        (let ((j (1- k)))
          (when (and (>= j 0) (char= (char tx j) #\i)) (decf j))
          (when (and (>= j 0) (find (char tx j) "kKMG"))
            (decf j)
            (when (and (>= j 0) (char= (char tx j) #\Space)) (decf j))
            (when (and (>= j 0) (ox-digit-p (ox-code tx j))) (return t))))))))

(defun binary-line-p (tx)
  (when (and (not (find #\Space tx)) (> (length tx) 400)) (return-from binary-line-p t))
  (let ((run 0))
    (loop for c across tx
          for code = (char-code c)
          do (if (or (ox-alnum-p code) (find c "+/="))
                 (when (>= (incf run) 200) (return-from binary-line-p t))
                 (setf run 0))))
  nil)

(defun evidence-line (line)
  (let ((line (ox-trim line)))
    (if (or (string= line "") (regex-match-p +exit-code+ line))
        ""
        (clip (escape-role-labels (strip-times line)) +max-evidence-line-chars+))))

(defun strip-times (line)
  (let ((n (length line)) (i 0))
    (ox-trim
     (with-output-to-string (b)
       (loop while (< i n)
             do (let ((j (duration-at line i)))
                  (if (> j i)
                      (setf i j)
                      (let ((j (timestamp-at line i)))
                        (if (> j i)
                            (setf i j)
                            (let ((j (percent-counter-at line i)))
                              (if (> j i)
                                  (setf i j)
                                  (progn (write-char (char line i) b) (incf i)))))))))))))

(defun ox-number (s i)
  (let ((j i) (n (length s)))
    (loop while (and (< j n) (ox-digit-p (ox-code s j))) do (incf j))
    (when (= j i) (return-from ox-number i))
    (when (and (< j n) (char= (char s j) #\.))
      (let ((k (1+ j)))
        (loop while (and (< k n) (ox-digit-p (ox-code s k))) do (incf k))
        (when (> k (1+ j)) (setf j k))))
    j))

(defun duration-unit (s i)
  (dolist (u '("ms" "µs" "us" "ns" "min" "s" "m" "h") i)
    (when (has-prefix (subseq s i) u)
      (let ((end (+ i (length u))))
        (unless (and (< end (length s)) (ox-alpha-p (ox-code s end)))
          (return end))))))

(defun duration-at (s i)
  (let ((j i) (n (length s)))
    (when (and (< j n) (char= (char s j) #\Space)) (incf j))
    (cond ((and (< j n) (char= (char s j) #\())
           (let ((k (ox-number s (1+ j))))
             (when (= k (1+ j)) (return-from duration-at i))
             (when (and (< k n) (char= (char s k) #\Space)) (incf k))
             (let ((u (duration-unit s k)))
               (if (or (= u k) (>= u n) (char/= (char s u) #\))) i (1+ u)))))
          ((and (> j i) (has-prefix (subseq s j) "in "))
           (let ((k (ox-number s (+ j 3))))
             (when (= k (+ j 3)) (return-from duration-at i))
             (let ((u (duration-unit s k)))
               (if (or (= u k) (and (< u n) (ox-alnum-p (ox-code s u)))) i u))))
          (t i))))

(defun digits-at-p (s i n)
  (and (<= (+ i n) (length s))
       (loop for k from i below (+ i n) always (ox-digit-p (ox-code s k)))))

(defun timestamp-at (s i)
  (let ((n (length s)))
    (when (and (> i 0) (ox-alnum-p (ox-code s (1- i)))) (return-from timestamp-at i))
    (unless (and (digits-at-p s i 4) (<= (+ i 19) n) (char= (char s (+ i 4)) #\-) (digits-at-p s (+ i 5) 2)
                 (char= (char s (+ i 7)) #\-) (digits-at-p s (+ i 8) 2)
                 (find (char s (+ i 10)) "T ") (digits-at-p s (+ i 11) 2) (char= (char s (+ i 13)) #\:)
                 (digits-at-p s (+ i 14) 2) (char= (char s (+ i 16)) #\:) (digits-at-p s (+ i 17) 2))
      (return-from timestamp-at i))
    (let ((j (+ i 19)))
      (when (and (< j n) (find (char s j) ".,"))
        (let ((k (1+ j)))
          (loop while (and (< k n) (ox-digit-p (ox-code s k))) do (incf k))
          (when (> k (1+ j)) (setf j k))))
      (cond ((and (< j n) (char= (char s j) #\Z)) (incf j))
            ((and (< j n) (find (char s j) "+-") (digits-at-p s (1+ j) 2))
             (let ((k (+ j 3)))
               (when (and (< k n) (char= (char s k) #\:)) (incf k))
               (when (digits-at-p s k 2) (setf j (+ k 2))))))
      (when (and (< j n) (char= (char s j) #\Space)) (incf j))
      j)))

(defun percent-counter-at (s i)
  (let ((j i) (n (length s)))
    (when (and (< j n) (char= (char s j) #\Space)) (incf j))
    (when (or (>= j n) (char/= (char s j) #\[)) (return-from percent-counter-at i))
    (let ((k (1+ j)))
      (loop while (and (< k n) (char= (char s k) #\Space)) do (incf k))
      (let ((d k))
        (loop while (and (< k n) (ox-digit-p (ox-code s k))) do (incf k))
        (if (or (= k d) (>= (1+ k) n) (char/= (char s k) #\%) (char/= (char s (1+ k)) #\]))
            i
            (+ k 2))))))

(defun line-shape (line)
  (with-output-to-string (b)
    (loop for i from 0 below (length line)
          do (if (ox-digit-p (ox-code line i))
                 (when (or (= i 0) (not (ox-digit-p (ox-code line (1- i))))) (write-char #\# b))
                 (write-char (char line i) b)))))

;;; Classes

(defparameter +search-tools+
  '("grep" "glob" "search" "ripgrep" "findfiles" "grepsearch" "searchfiles" "filesearch" "codebasesearch"
    "find" "ls" "listfiles" "listdir" "listdirectory"))

(defun command-segments (command)
  (let ((out '()) (words '()) (b (make-string-output-stream)) (in-word nil) (quote-char nil))
    (flet ((flush ()
             (let ((w (get-output-stream-string b)))
               (when in-word (push-end w words)))
             (setf in-word nil)))
      (loop for c across command
            do (cond (quote-char (if (char= c quote-char) (setf quote-char nil) (write-char c b)))
                     ((find c "'\"") (setf quote-char c in-word t))
                     ((find c (list #\Space #\Tab)) (flush))
                     ((find c (list #\& #\| #\; #\Newline #\( #\)))
                      (flush)
                      (when words (push-end words out))
                      (setf words '()))
                     (t (write-char c b) (setf in-word t))))
      (flush)
      (when words (push-end words out))
      out)))

(defparameter +wrappers+ '("sudo" "env" "time" "nice" "nohup" "command" "exec" "npx" "bunx" "pnpx" "xvfb-run"))

(defun program-of (words)
  "programOf: (values program next)."
  (let ((i 0) (n (length words)))
    (loop while (< i n)
          do (let ((w (nth i words)))
               (cond ((and (find #\= w) (not (has-prefix w "-"))) (incf i))
                     ((member-str w +wrappers+) (incf i))
                     ((and (string= w "timeout") (< (1+ i) n)) (incf i 2))
                     ((and (member-str w '("uv" "poetry" "pipenv" "pdm" "hatch" "rye")) (< (1+ i) n)
                           (string= (nth (1+ i) words) "run"))
                      (incf i 2))
                     (t (return)))))
    (when (>= i n) (return-from program-of (values "" "")))
    (let* ((prog (nth i words))
           (k (position #\/ prog :from-end t))
           (prog (if k (subseq prog (1+ k)) prog))
           (next (if (< (1+ i) n) (nth (1+ i) words) "")))
      (when (and (or (has-prefix prog "python") (string= prog "py")) (string= next "-m") (< (+ i 2) n))
        (setf prog (nth (+ i 2) words) next (if (< (+ i 3) n) (nth (+ i 3) words) "")))
      (values prog next))))

(defun segment-class (prog next)
  (flet ((in (&rest names) (member-str prog names)))
    (cond ((in "pytest" "py.test" "tox" "nox" "jest" "vitest" "mocha" "ava" "phpunit" "rspec" "ctest" "unittest" "nextest") 1)
          ((in "go") (cond ((string= next "test") 1)
                           ((member-str next '("build" "vet" "install" "run" "generate")) 2)
                           (t 0)))
          ((in "cargo") (cond ((member-str next '("test" "nextest")) 1)
                              ((member-str next '("build" "check" "clippy" "run")) 2)
                              (t 0)))
          ((in "npm" "pnpm" "yarn" "bun" "deno")
           (cond ((member-str next '("test" "t")) 1)
                 ((member-str next '("" "install" "i" "add" "ci" "remove" "uninstall" "update" "upgrade" "view" "info"
                                     "ls" "list" "outdated" "audit" "init" "publish" "login" "whoami" "config"))
                  0)
                 (t 2)))
          ((in "mvn" "mvnw" "gradle" "gradlew" "dotnet" "sbt" "bazel" "make" "gmake")
           (if (or (contains next "test") (string= next "check") (string= next "verify")) 1 2))
          ((in "tsc" "gcc" "g++" "clang" "clang++" "cc" "c++" "mypy" "pyright" "eslint" "ruff" "flake8" "pylint"
               "rustc" "javac" "golangci-lint" "cmake" "ninja" "swiftc" "biome" "staticcheck" "shellcheck" "vue-tsc" "tsx" "node")
           2)
          ((in "grep" "egrep" "fgrep" "rg" "ag" "ack" "find" "fd" "ls" "tree" "locate") 3)
          ((in "git") (if (member-str next '("grep" "ls-files")) 3 4))
          (t 0))))

(defun output-class (call)
  (when (member-str (tool-key (tcall-name call)) +search-tools+) (return-from output-class 3))
  (let ((command (shell-command (tcall-args call))) (best 0))
    (unless command (return-from output-class 0))
    (dolist (words (command-segments command) best)
      (let ((c (multiple-value-call #'segment-class (program-of words))))
        (when (and (/= c 0) (or (= best 0) (< c best))) (setf best c))))))

;;; Extractors

(defun ox-indented-p (line) (or (has-prefix line (string #\Tab)) (has-prefix line "  ")))

(defun failing-count-p (tx label)
  (let ((k (ox-index tx label)))
    (when k
      (let* ((start (+ k (length label))) (j start))
        (loop while (and (< j (length tx)) (ox-digit-p (ox-code tx j))) do (incf j))
        (and (> j start) (string/= (subseq tx start j) "0"))))))

(defun test-facts (f lines)
  (let ((assertions 0) (v (coerce lines 'vector)))
    (loop for i from 0 below (length v)
          do (let* ((line (aref v i)) (tx (ox-trim line)))
               (cond ((has-prefix tx "--- FAIL: ")
                      (setf (ofacts-failed f) t)
                      (ofacts-value f "test" (ox-first-word (subseq tx (length "--- FAIL: "))))
                      (ofacts-line f tx)
                      (loop for k from (1+ i) below (length v)
                            while (and (<= k (+ i 3)) (ox-indented-p (aref v k))
                                       (not (has-prefix (ox-trim (aref v k)) "--- ")))
                            do (ofacts-line f (aref v k))))
                     ((and (or (has-prefix tx "FAILED ") (has-prefix tx "ERROR ")) (contains tx "::"))
                      (let* ((id (subseq tx (1+ (position #\Space tx))))
                             (k (ox-index id " - ")))
                        (when k (setf id (subseq id 0 k)))
                        (setf (ofacts-failed f) t)
                        (ofacts-value f "test" (ox-trim id))
                        (ofacts-line f tx)))
                     ((and (has-prefix line "E   ") (< assertions 3))
                      (incf assertions)
                      (ofacts-line f tx))
                     ((and (has-prefix tx "=") (has-suffix tx "=") (or (contains tx " failed") (contains tx " error")))
                      (setf (ofacts-failed f) t)
                      (ofacts-line f tx))
                     ((or (has-prefix tx "FAIL ") (has-prefix tx (cat "FAIL" (string #\Tab))) (string= tx "FAIL"))
                      (setf (ofacts-failed f) t)
                      (ofacts-line f tx))
                     ((and (has-prefix tx "● ") (not (has-prefix tx "● Console")))
                      (setf (ofacts-failed f) t)
                      (ofacts-value f "test" (ox-trim (subseq tx (length "● "))))
                      (ofacts-line f tx))
                     ((and (has-prefix tx "Tests:") (contains tx "failed"))
                      (setf (ofacts-failed f) t)
                      (ofacts-line f tx))
                     ((and (has-prefix tx "test ") (has-suffix tx " ... FAILED"))
                      (setf (ofacts-failed f) t)
                      (ofacts-value f "test" (ox-trim (subseq tx (length "test ") (- (length tx) (length " ... FAILED")))))
                      (ofacts-line f tx))
                     ((has-prefix tx "test result: FAILED")
                      (setf (ofacts-failed f) t)
                      (ofacts-line f tx))
                     ((and (has-prefix tx "Tests run:") (contains tx "Failures:")
                           (or (failing-count-p tx "Failures: ") (failing-count-p tx "Errors: ")))
                      (setf (ofacts-failed f) t)
                      (ofacts-line f tx))
                     ((and (has-suffix tx " FAILED") (contains tx " > "))
                      (setf (ofacts-failed f) t)
                      (ofacts-value f "test" (ox-trim (subseq tx 0 (- (length tx) (length " FAILED")))))
                      (ofacts-line f tx))
                     ((or (has-prefix tx "BUILD FAILED") (has-prefix tx "BUILD FAILURE") (has-prefix tx "[ERROR] BUILD FAILURE"))
                      (setf (ofacts-failed f) t)
                      (ofacts-line f tx)))))))

(defun diagnostic-severity (tx)
  (let ((k (position #\: tx)) (n (length tx)))
    (when (or (null k) (<= k 0) (not (find #\. tx :end k)) (find #\Space tx :end k))
      (return-from diagnostic-severity ""))
    (let* ((j (1+ k)) (start j))
      (loop while (and (< j n) (ox-digit-p (ox-code tx j))) do (incf j))
      (when (or (= j start) (>= j n) (char/= (char tx j) #\:)) (return-from diagnostic-severity ""))
      (incf j)
      (let ((col j))
        (when (and (< j n) (ox-digit-p (ox-code tx j)))
          (loop while (and (< j n) (ox-digit-p (ox-code tx j))) do (incf j))
          (if (or (>= j n) (char/= (char tx j) #\:)) (setf j col) (incf j))))
      (let ((rest (ox-lower (ox-trim (subseq tx j)))))
        (cond ((or (has-prefix rest "error:") (has-prefix rest "error[") (has-prefix rest "fatal error:")) "error")
              ((or (has-prefix rest "warning:") (has-prefix rest "note:") (has-prefix rest "info:")) "other")
              (t "none"))))))

(defun eslint-error-p (tx)
  (let ((j 0) (n (length tx)))
    (loop while (and (< j n) (ox-digit-p (ox-code tx j))) do (incf j))
    (when (or (= j 0) (>= j n) (char/= (char tx j) #\:)) (return-from eslint-error-p nil))
    (let ((k (1+ j)))
      (loop while (and (< k n) (ox-digit-p (ox-code tx k))) do (incf k))
      (and (> k (1+ j)) (has-prefix (subseq tx k) "  error  ")))))

(defun diagnostic-facts (f lines build failed)
  "diagnosticFacts: tsc's and eslint's shapes in any command's output, the others in a build's
or a test's (build)."
  (let ((arrow nil))
    (dolist (line lines)
      (let ((tx (ox-trim line)))
        (cond ((and build (or (has-prefix tx "error[") (has-prefix tx "error:")))
               (setf (ofacts-failed f) t)
               (ofacts-line f tx)
               (setf arrow t))
              ((and build arrow (has-prefix tx "--> "))
               (ofacts-line f tx)
               (setf arrow nil))
              ((or (contains tx ": error TS") (and build (string= (diagnostic-severity tx) "error")))
               (setf (ofacts-failed f) t)
               (ofacts-line f tx))
              ((and build failed (string= (diagnostic-severity tx) "none"))
               (ofacts-line f tx))
              ((eslint-error-p tx)
               (setf (ofacts-failed f) t)
               (ofacts-line f tx)))))))

(defun search-facts (f call text)
  (let ((pattern (str (jget (tcall-args call) "pattern"))))
    (when (string= pattern "")
      (let ((command (shell-command (tcall-args call))))
        (when command
          (dolist (words (command-segments command))
            (let ((prog (program-of words)))
              (when (member-str prog '("grep" "rg" "egrep" "ag" "ack"))
                (dolist (w (rest words))
                  (unless (or (has-prefix w "-") (string= w prog))
                    (setf pattern w)
                    (return)))
                (return)))))))
    (when (and (>= (length pattern) 3) (not (ox-digit-p (ox-code pattern 0))) (contains text pattern)
               (every (lambda (c) (ox-ident-p (char-code c))) pattern))
      (ofacts-value f "symbol" pattern))))

(defparameter +git-status-labels+
  '("modified:" "new file:" "deleted:" "renamed:" "both modified:" "both added:" "typechange:" "copied:"))

(defun quoted-name (tx)
  (let ((k (position #\' tx)))
    (if (null k)
        ""
        (let ((end (position #\' tx :start (1+ k))))
          (if end (subseq tx (1+ k) end) "")))))

(defun git-path (f p)
  (let ((p (ox-trim p)))
    (when (or (string= p "") (find #\Space p)) (return-from git-path))
    (if (find #\/ p)
        (multiple-value-bind (v ok) (path-value p) (when ok (ofacts-value f "path" v)))
        (when (has-extension-p p) (ofacts-value f "path" p)))))

(defun git-facts (f lines)
  (dolist (line lines)
    (let ((tx (ox-trim line)))
      (cond ((has-prefix tx "On branch ")
             (ofacts-value f "branch" (ox-first-word (subseq tx (length "On branch ")))))
            ((or (has-prefix tx "Switched to branch '") (has-prefix tx "Switched to a new branch '") (has-prefix tx "Your branch is "))
             (ofacts-value f "branch" (quoted-name tx)))
            ((has-prefix tx "Saved working directory and index state WIP on ")
             (let* ((rest (subseq tx (length "Saved working directory and index state WIP on "))) (k (position #\: rest)))
               (when (and k (> k 0)) (ofacts-value f "branch" (subseq rest 0 k)))))
            ((and (has-prefix tx "* ") (plusp (length (ox-first-word (subseq tx 2)))) (not (has-prefix tx "* (")))
             (ofacts-value f "branch" (ox-first-word (subseq tx 2))))
            ((or (has-prefix tx "CONFLICT ") (has-prefix tx "error: ") (has-prefix tx "fatal: ")
                 (has-prefix tx "Automatic merge failed") (has-prefix tx "! [rejected]"))
             (setf (ofacts-failed f) t)
             (ofacts-line f tx)))
      (dolist (label +git-status-labels+)
        (when (has-prefix tx label)
          (let* ((rest (ox-trim (subseq tx (length label)))) (k (ox-index rest " -> ")))
            (when k
              (git-path f (subseq rest 0 k))
              (setf rest (subseq rest (+ k (length " -> ")))))
            (git-path f rest))))
      (when (and (> (length line) 3) (char= (char line 2) #\Space) (find (char line 0) " MADRCU?!")
                 (find (char line 1) " MADRCU?!") (or (char/= (char line 0) #\Space) (char/= (char line 1) #\Space)))
        (let* ((rest (subseq line 3)) (k (ox-index rest " -> ")))
          (when k (setf rest (subseq rest (+ k (length " -> ")))))
          (git-path f rest))))))

(defun python-frames (f frames)
  (when (null frames) (return-from python-frames))
  (ofacts-line f (first frames))
  (let ((project -1))
    (loop for fr in frames for k from 0
          do (unless (or (contains fr "site-packages") (contains fr "dist-packages") (contains fr "/usr/lib") (contains fr "<frozen"))
               (setf project k)))
    (when (> project 0) (ofacts-line f (nth project frames))))
  (ofacts-line f (car (last frames))))

(defun error-line-p (tx)
  (when (or (has-prefix tx "Error:") (has-prefix tx "Exception in thread") (has-prefix tx "Uncaught "))
    (return-from error-line-p t))
  (let ((found nil))
    (scan-error-types tx (lambda (v) (declare (ignore v)) (setf found t)))
    found))

(defun stack-facts (f lines)
  (let* ((v (coerce lines 'vector)) (n (length v)) (i 0))
    (loop while (< i n)
          do (let ((tx (ox-trim (aref v i))))
               (cond ((string= tx "Traceback (most recent call last):")
                      (setf (ofacts-failed f) t)
                      (let ((frames '()) (k (1+ i)))
                        (loop while (< k n)
                              do (let ((ft (ox-trim (aref v k))))
                                   (cond ((has-prefix ft "File \"") (push-end ft frames))
                                         ((or (ox-indented-p (aref v k)) (string= ft "")))
                                         (t (return))))
                                 (incf k))
                        (when (< k n) (ofacts-line f (aref v k)))
                        (python-frames f frames)
                        (setf i k)))
                     ((or (has-prefix tx "panic: ") (has-prefix tx "fatal error: "))
                      (setf (ofacts-failed f) t)
                      (ofacts-line f tx)
                      (let ((shown 0))
                        (loop for k from (1+ i) below n
                              while (< shown 2)
                              do (let ((ft (ox-trim (aref v k))))
                                   (when (and (has-prefix (aref v k) (string #\Tab)) (contains ft ".go:"))
                                     (let ((p (ox-index ft " +0x")))
                                       (when p (setf ft (subseq ft 0 p))))
                                     (ofacts-line f ft)
                                     (incf shown))))))
                     ((and (has-prefix tx "thread '") (contains tx "' panicked at "))
                      (setf (ofacts-failed f) t)
                      (ofacts-line f tx)
                      (when (and (< (1+ i) n) (not (has-prefix (ox-trim (aref v (1+ i))) "note:")))
                        (ofacts-line f (aref v (1+ i)))))
                     ((and (has-prefix tx "at ") (ox-indented-p (aref v i))
                           (or (= i 0) (not (has-prefix (ox-trim (aref v (1- i))) "at "))))
                      (when (> i 0)
                        (let ((head (ox-trim (aref v (1- i)))))
                          (when (error-line-p head)
                            (setf (ofacts-failed f) t)
                            (ofacts-line f head)
                            (ofacts-line f tx)))))
                     ((has-prefix tx "Caused by: ")
                      (setf (ofacts-failed f) t)
                      (ofacts-line f tx))))
             (incf i))))

(defparameter +failure-starts+
  '("error:" "error[" "fatal:" "fatal error" "panic:" "npm err!" "exception:" "make: ***" "uncaught " "unhandled " "err!" "error ts"))
(defparameter +failure-contains+
  '("command not found" "no such file or directory" "permission denied" "connection refused"
    "traceback (most recent call last)" "segmentation fault" "command failed with exit code" "tool execution failed"))

(defun marker-facts (f lines)
  (dolist (line lines)
    (let ((tx (ox-lower (ox-trim line))))
      (unless (string= tx "")
        (when (or (some (lambda (p) (has-prefix tx p)) +failure-starts+)
                  (some (lambda (p) (contains tx p)) +failure-contains+))
          (setf (ofacts-failed f) t)
          (ofacts-line f line))))))

(defparameter +failure-words+
  '("error" "fail" "fatal" "panic" "exception" "denied" "cannot" "unable" "refused" "timeout" "timed out" "not found" "invalid" "missing"))

(defun fallback-evidence (f lines)
  (let* ((v (coerce lines 'vector)) (first -1) (last -1))
    (loop for i from 0 below (length v)
          do (when (string/= (evidence-line (aref v i)) "")
               (when (< first 0) (setf first i))
               (setf last i)))
    (when (< first 0) (return-from fallback-evidence))
    (loop for i from first to last
          do (if (or (= i first) (= i last))
                 (ofacts-line f (aref v i))
                 (let ((tx (ox-lower (aref v i))))
                   (when (some (lambda (w) (contains tx w)) +failure-words+)
                     (ofacts-line f (aref v i))))))))

;;; The generic value scan

(defparameter +git-lines+ '("commit " "index " "Merge: " "HEAD is now at " "Saved working directory" "Author: "))

(defun git-line-p (line)
  (let ((tx (ox-trim line)))
    (some (lambda (p) (has-prefix tx p)) +git-lines+)))

(defun scan-values (f line git)
  (when (string= line "") (return-from scan-values))
  (let ((spans (url-spans line)))
    (dolist (sp spans) (ofacts-value f "url" (third sp)))
    (scan-paths line spans (lambda (v) (ofacts-value f "path" v)))
    (scan-kvs line (lambda (v) (ofacts-value f "kv" v)))
    (scan-ips line (lambda (v) (ofacts-value f "ip" v)))
    (scan-shas line (or git (git-line-p line)) (lambda (v) (ofacts-value f "sha" v)))
    (scan-error-types line (lambda (v) (ofacts-value f "error" v)))
    (scan-issues line (lambda (v) (ofacts-value f "issue" v)))
    (scan-versions line (lambda (v) (ofacts-value f "version" v)))))

(defparameter +url-stops+ "\"'<>`")

(defun ox-count-char (s c from end) (count c s :start from :end end))

(defun trim-url-end (line from end)
  (loop while (> end from)
        do (let ((c (char line (1- end))))
             (cond ((find c ".,;:!?") (decf end))
                   ((and (find c ")]}")
                         (< (ox-count-char line (char "([{" (position c ")]}")) from end) (ox-count-char line c from end)))
                    (decf end))
                   (t (return)))))
  end)

(defun url-spans (line)
  "urlSpans: a list of (start end value)."
  (let ((out '()) (i 0) (n (length line)))
    (loop
      (let ((k (ox-index line "http" i)))
        (unless k (return))
        (setf i (+ k 4))
        (let ((scheme (cond ((has-prefix (subseq line k) "https://") 8)
                            ((has-prefix (subseq line k) "http://") 7)
                            (t nil))))
          (when (and scheme (not (and (> k 0) (ox-alnum-p (ox-code line (1- k))))))
            (let ((end (+ k scheme)) (parens 0) (brackets 0))
              ;; A ) or ] the URL did not open ends it: "[![b](https://x/b.svg)](https://x)".
              (loop while (and (< end n) (not (ox-blank-p (ox-code line end))) (not (find (char line end) +url-stops+)))
                    do (case (char line end)
                         (#\( (incf parens))
                         (#\[ (incf brackets))
                         (#\) (decf parens))
                         (#\] (decf brackets)))
                       (when (or (< parens 0) (< brackets 0)) (return))
                       (incf end))
              (setf end (trim-url-end line (+ k scheme) end))
              (when (> end (+ k scheme))
                (let ((value (subseq line k end)))
                  (push-end (list k end (if (> (length value) +max-url-chars+) (subseq value 0 +max-url-chars+) value)) out))
                (setf i end)))))))
    out))

(defun path-char-p (c)
  (or (ox-alnum-p c) (ox-in c "_-./\\@~+%") (>= c 128)))

(defparameter +path-excluded+ '("node_modules/" "site-packages/" "dist-packages/" ".git/objects/"))
(defparameter +path-excluded-prefixes+ '("/proc/" "/usr/lib/" "/usr/local/lib/" "/usr/share/" "/sys/"))

(defun scan-paths (line urls add)
  (let ((n (length line)) (i 0))
    (loop while (< i n)
          do (if (or (not (path-char-p (ox-code line i))) (and (> i 0) (path-char-p (ox-code line (1- i)))))
                 (incf i)
                 (let ((end i))
                   (loop while (and (< end n) (path-char-p (ox-code line end))) do (incf end))
                   (when (and (= end (1+ i)) (ox-alpha-p (ox-code line i)) (< (1+ end) n) (char= (char line end) #\:)
                              (find (char line (1+ end)) "/\\") (or (= i 0) (not (ox-alnum-p (ox-code line (1- i))))))
                     (incf end)
                     (loop while (and (< end n) (path-char-p (ox-code line end))) do (incf end)))
                   (unless (some (lambda (sp) (and (>= i (first sp)) (< i (second sp)))) urls)
                     (multiple-value-bind (v ok) (path-value (subseq line i end))
                       (when ok (funcall add v))))
                   (setf i end))))))

(defun path-value (token)
  "pathValue: (values path ok)."
  (let ((start 0) (end (length token)))
    (loop while (and (< start end) (>= (ox-code token start) 128)) do (incf start))
    (loop while (and (> end start) (or (>= (ox-code token (1- end)) 128) (char= (char token (1- end)) #\.))) do (decf end))
    (let ((token (subseq token start end)))
      ;; A C-style escape (git's quoted "\345\216..."): the path's real spelling is not printed.
      (loop for i from 0 below (1- (length token))
            do (when (and (char= (char token i) #\\) (ox-digit-p (ox-code token (1+ i))))
                 (return-from path-value (values "" nil))))
      (when (find #\\ token)
        (setf token (with-output-to-string (b)
                      (loop for i from 0 below (length token)
                            do (if (char= (char token i) #\\)
                                   (when (or (= i 0) (char/= (char token (1- i)) #\\)) (write-char #\/ b))
                                   (write-char (char token i) b))))))
      (when (or (not (find #\/ token)) (> (length token) +max-value-chars+)) (return-from path-value (values "" nil)))
      (let ((base (subseq token (1+ (position #\/ token :from-end t)))))
        (unless (has-extension-p base) (return-from path-value (values "" nil))))
      (when (some (lambda (x) (contains token x)) +path-excluded+) (return-from path-value (values "" nil)))
      (when (some (lambda (x) (has-prefix token x)) +path-excluded-prefixes+) (return-from path-value (values "" nil)))
      (values token t))))

(defun has-extension-p (base)
  (let ((dot (position #\. base :from-end t)))
    (when (null dot) (return-from has-extension-p nil))
    (let ((ext (subseq base (1+ dot))))
      (and (<= 1 (length ext) 8)
           (every (lambda (c) (ox-alnum-p (char-code c))) ext)
           (some (lambda (c) (ox-alpha-p (char-code c))) ext)))))

(defparameter +secret-key-parts+ '("SECRET" "TOKEN" "PASSW" "API_KEY" "APIKEY" "PRIVATE" "CREDENTIAL" "AUTH"))

(defun key-like-p (value)
  (and (>= (length value) 40)
       (every (lambda (c) (or (ox-alnum-p (char-code c)) (find c "+/_=-"))) value)))

(defun scan-kvs (line add)
  (let ((n (length line)) (i 0))
    (loop while (< i n)
          do (block one
               (when (or (not (ox-upper-p (ox-code line i)))
                         (and (> i 0) (or (ox-ident-p (ox-code line (1- i))) (find (char line (1- i)) "$-"))))
                 (return-from one))
               (let ((j i))
                 (loop while (and (< j n) (let ((c (ox-code line j))) (or (ox-upper-p c) (ox-digit-p c) (= c 95)))) do (incf j))
                 (when (or (< (- j i) 2) (>= j n) (char/= (char line j) #\=))
                   (setf i (1- j))
                   (return-from one))
                 (let* ((v (1+ j)) (end v))
                   (loop while (and (< end n) (not (ox-blank-p (ox-code line end)))) do (incf end))
                   (when (or (= end v) (char= (char line v) #\=))
                     (setf i (1- end))
                     (return-from one))
                   (let ((key (subseq line i j)) (value (subseq line v end)))
                     (unless (or (some (lambda (p) (contains key p)) +secret-key-parts+) (key-like-p value))
                       (funcall add (subseq line i end))))
                   (setf i (1- end)))))
             (incf i))))

(defun scan-ips (line add)
  (let ((n (length line)) (i 0))
    (loop while (< i n)
          do (block one
               (when (or (not (ox-digit-p (ox-code line i)))
                         (and (> i 0) (or (ox-alnum-p (ox-code line (1- i))) (char= (char line (1- i)) #\.))))
                 (return-from one))
               (let ((j i) (ok t))
                 (dotimes (part 4)
                   (let ((start j))
                     (loop while (and (< j n) (< (- j start) 3) (ox-digit-p (ox-code line j))) do (incf j))
                     (when (or (= j start) (and (< j n) (ox-digit-p (ox-code line j))))
                       (setf ok nil) (return))
                     (when (> (parse-integer line :start start :end j) 255)
                       (setf ok nil) (return))
                     (when (< part 3)
                       (when (or (>= j n) (char/= (char line j) #\.))
                         (setf ok nil) (return))
                       (incf j))))
                 (unless ok (return-from one))
                 (when (and (< j n) (or (ox-alnum-p (ox-code line j))
                                        (and (char= (char line j) #\.) (< (1+ j) n) (ox-digit-p (ox-code line (1+ j))))))
                   (return-from one))
                 (let ((end j))
                   (when (and (< (1+ j) n) (char= (char line j) #\:) (ox-digit-p (ox-code line (1+ j))))
                     (let ((k (1+ j)))
                       (loop while (and (< k n) (ox-digit-p (ox-code line k))) do (incf k))
                       (when (and (<= (- k (1+ j)) 5) (<= (parse-integer line :start (1+ j) :end k) 65535)
                                  (or (>= k n) (not (ox-alnum-p (ox-code line k)))))
                         (setf end k))))
                   (funcall add (subseq line i end))
                   (setf i (1- end)))))
             (incf i))))

(defun scan-shas (line git add)
  (let ((n (length line)) (i 0))
    (loop while (< i n)
          do (block one
               (when (or (not (ox-hex-p (ox-code line i))) (and (> i 0) (ox-ident-p (ox-code line (1- i)))))
                 (return-from one))
               (let ((j i) (digit nil) (letter nil))
                 (loop while (and (< j n) (ox-hex-p (ox-code line j)))
                       do (if (ox-digit-p (ox-code line j)) (setf digit t) (setf letter t))
                          (incf j))
                 (when (and (< j n) (ox-ident-p (ox-code line j)))
                   (loop while (and (< j n) (ox-ident-p (ox-code line j))) do (incf j))
                   (setf i (1- j))
                   (return-from one))
                 (let ((len (- j i)))
                   (when (and digit letter (or (= len 40) (and git (<= 7 len 40))))
                     (funcall add (subseq line i j))))
                 (setf i (1- j))))
             (incf i))))

(defparameter +error-suffixes+ '("Error" "Exception" "Denied" "Timeout" "Overflow"))

(defun scan-error-types (line add)
  (let ((n (length line)) (i 0))
    (loop while (< i n)
          do (block one
               (when (or (not (ox-ident-p (ox-code line i))) (and (> i 0) (ox-ident-p (ox-code line (1- i)))))
                 (return-from one))
               (let ((j i))
                 (loop while (and (< j n) (ox-ident-p (ox-code line j))) do (incf j))
                 (let ((word (subseq line i j)))
                   (setf i (1- j))
                   (unless (ox-upper-p (ox-code word 0)) (return-from one))
                   (when (and (> (length word) 3) (has-prefix word "Err") (ox-upper-p (ox-code word 3)))
                     (funcall add word)
                     (return-from one))
                   (dolist (sfx +error-suffixes+)
                     (when (and (> (length word) (length sfx)) (has-suffix word sfx))
                       (funcall add word)
                       (return))))))
             (incf i))))

(defun scan-issues (line add)
  (let ((n (length line)) (i 0))
    (loop while (< i n)
          do (block one
               (when (or (char/= (char line i) #\#)
                         (and (> i 0) (or (ox-alnum-p (ox-code line (1- i))) (find (char line (1- i)) "&#"))))
                 (return-from one))
               (let ((j (1+ i)))
                 (loop while (and (< j n) (ox-digit-p (ox-code line j))) do (incf j))
                 (when (or (= j (1+ i)) (> (- j (1+ i)) 6) (and (< j n) (ox-ident-p (ox-code line j))))
                   (return-from one))
                 (funcall add (subseq line i j))
                 (setf i (1- j))))
             (incf i))))

(defun version-end (s i)
  (let ((j i) (n (length s)) (parts 0))
    (loop while (and (< j n) (ox-digit-p (ox-code s j))) do (incf j))
    (when (= j i) (return-from version-end -1))
    (loop while (and (< (1+ j) n) (char= (char s j) #\.) (ox-digit-p (ox-code s (1+ j))))
          do (incf j)
             (loop while (and (< j n) (ox-digit-p (ox-code s j))) do (incf j))
             (incf parts))
    (when (= parts 0) (return-from version-end -1))
    (when (and (< (1+ j) n) (char= (char s j) #\-) (ox-alnum-p (ox-code s (1+ j))))
      (incf j)
      (loop while (and (< j n) (or (ox-alnum-p (ox-code s j)) (char= (char s j) #\.))) do (incf j))
      (loop while (and (> j i) (char= (char s (1- j)) #\.)) do (decf j)))
    (if (and (< j n) (ox-ident-p (ox-code s j))) -1 j)))

(defun scan-versions (line add)
  (let ((n (length line)) (i 0))
    (loop while (< i n)
          do (block one
               (cond ((and (char= (char line i) #\@) (> i 0) (< (1+ i) n) (ox-digit-p (ox-code line (1+ i))))
                      (let ((end (version-end line (1+ i))))
                        (when (< end 0) (return-from one))
                        (let ((start i))
                          (loop while (and (> start 0) (let ((c (ox-code line (1- start)))) (or (ox-alnum-p c) (ox-in c "_./-"))))
                                do (decf start))
                          (when (and (> start 0) (char= (char line (1- start)) #\@)
                                     (or (= start 1) (not (ox-alnum-p (ox-code line (- start 2))))))
                            (decf start))
                          (when (ox-has-alnum (subseq line start i))
                            (funcall add (subseq line start end))))
                        (setf i (1- end))))
                     ((and (char= (char line i) #\v) (or (= i 0) (not (ox-alnum-p (ox-code line (1- i)))))
                           (< (1+ i) n) (ox-digit-p (ox-code line (1+ i))))
                      (let ((end (version-end line (1+ i))))
                        (when (< end 0) (return-from one))
                        (funcall add (subseq line i end))
                        (setf i (1- end))))))
             (incf i))))

;;; Records

(defun value-content (kind value count)
  (if (> count 1)
      (cat kind " " value " (seen " (itoa count) " times)")
      (cat kind " " value)))

(defun value-parts (o)
  "ValueParts: (values kind value count ok)."
  (unless (string= (obs-kind o) "value") (return-from value-parts (values "" "" 0 nil)))
  (multiple-value-bind (kind value found) (cut (obs-target o) ":")
    (when (or (not found) (string= kind "") (string= value "")) (return-from value-parts (values "" "" 0 nil)))
    (let ((count 1) (content (obs-content o)))
      (when (has-suffix content " times)")
        (let ((k (last-index content " (seen ")))
          (when (and k (<= (+ k (length " (seen ")) (- (length content) (length " times)"))))
            (let ((n (atoi (subseq content (+ k (length " (seen ")) (- (length content) (length " times)"))))))
              (when (and n (> n 1)) (setf count n))))))
      (values kind value count t))))

(defstruct ovalue kind value (count 0) (first-id "") (newest -1) (prior '()))

(defun x-output-records (x call result key display sources)
  "outputRecords."
  (unless (and (tresult-present result) (>= (tresult-index result) 0) (< (tresult-index result) (length (x-entries x))))
    (return-from x-output-records))
  (let ((f (output-facts-of call (tresult-text result) (tresult-failed result))) (added 0) (index (tresult-index result)))
    (dolist (v (ofacts-values f))
      (let* ((k (cat (car v) ":" (cdr v))) (st (gethash k (x-value-states x))))
        (block one
          (unless st
            (when (>= added +max-new-values+) (return-from one))
            (incf added)
            (setf st (make-ovalue :kind (car v) :value (cdr v) :first-id (entry-id (entry-at x index))))
            (setf (gethash k (x-value-states x)) st))
          (when (= (ovalue-newest st) index) (return-from one))
          (when (< (ovalue-newest st) 0) (push-end k (x-value-order x)))
          (incf (ovalue-count st))
          (setf (ovalue-newest st) index))))
    (when (ofacts-evidence f)
      (apply #'x-add x (make-obs :content (cat (tcall-name call) " " (go-quote (clip display 80)) " output: "
                                       (join (ofacts-evidence f) +evidence-separator+))
                         :kind "evidence" :tool (tcall-name call) :target key)
             sources))))

(defun x-load-values (x active)
  (dolist (o active)
    (unless (gethash (obs-id o) (x-superseded x))
      (multiple-value-bind (kind value count ok) (value-parts o)
        (when (and ok (obs-source-ids o))
          (let* ((k (cat kind ":" value)) (st (gethash k (x-value-states x))))
            (unless st
              (setf st (make-ovalue :kind kind :value value :first-id (first (obs-source-ids o))))
              (setf (gethash k (x-value-states x)) st))
            (setf (ovalue-count st) (max (ovalue-count st) count))
            (push-end (obs-id o) (ovalue-prior st))))))))

(defun x-emit-values (x)
  (dolist (k (x-value-order x))
    (let* ((st (gethash k (x-value-states x)))
           (o (make-obs :content (value-content (ovalue-kind st) (ovalue-value st) (ovalue-count st))
                        :kind "value" :target k
                        :source-ids (if (string/= (ovalue-first-id st) "") (list (ovalue-first-id st)) '()))))
      (setf (obs-supersedes o) (append (obs-supersedes o) (ovalue-prior st)))
      (x-add x o (ovalue-newest st)))))
