;;;; Truth maintenance against its contract cases (contracts/truth.md): contracts/truth.jsonl is
;;;; memory/ledger's output (truth_contract_test.go), which the fold, the labels and the
;;;; supersession decision here must equal.

(in-package "OM")

(defun truth-strings (v) (if (vectorp v) (coerce v 'list) '()))

(defun truth-alist (table)
  "A hash table (or a decoded object) as an alist sorted by key, or nil."
  (let ((out '()))
    (when (hash-table-p table)
      (maphash (lambda (k v) (push (cons k v) out)) table))
    (sort out #'string< :key #'car)))

(deftest truth-contract-cases
  (let ((cases (contract-cases "truth.jsonl")) (folds 0))
    (check (> (length cases) 6) t "cases read")
    (dolist (c cases)
      (let ((name (jget c "name")))
        (when (jget c "pairs")
          (check (map 'list (lambda (p) (supersession (observation-from (aref p 0)) (observation-from (aref p 1))))
                      (jget c "pairs"))
                 (truth-strings (jget c "decisions"))
                 (cat name ": decisions")))
        (when (jget c "plans")
          (check (map 'list (lambda (o) (intent-of (observation-from o))) (jget c "plans"))
                 (mapcar (lambda (x) (if (eq x :null) "" x)) (truth-strings (jget c "intents")))
                 (cat name ": intents")))
        (when (jget c "entries")
          (incf folds)
          (let* ((entries (map 'vector #'entry-from-map (jget c "entries")))
                 (f (fold-ledger entries)))
            (check (mapcar #'obs-id (folded-observations f)) (truth-strings (jget c "observations")) (cat name ": observations"))
            (check (mapcar #'obs-id (folded-active f)) (truth-strings (jget c "active")) (cat name ": active"))
            (check (mapcar #'refl-id (folded-reflections f)) (truth-strings (jget c "reflections")) (cat name ": reflections"))
            (check (truth-alist (folded-labels f)) (truth-alist (jget c "labels")) (cat name ": labels"))
            (check (truth-alist (truth-out (folded-truth f))) (truth-alist (jget c "out")) (cat name ": out"))
            (check (truth-alist (truth-forgotten (folded-truth f))) (truth-alist (jget c "forgotten")) (cat name ": forgotten"))
            (check (mapcar #'obs-id (projection-observations (full-projection* entries)))
                   (truth-strings (jget c "projection")) (cat name ": projection"))
            (dolist (clock (truth-strings (jget c "clocks")))
              (let* ((at (position #\: clock))
                     (decayed (decayed-records entries (folded-active f) (subseq clock 0 at) (parse-integer clock :start (1+ at)))))
                (check (loop for o in (folded-active f) when (gethash (obs-id o) decayed) collect (obs-id o))
                       (truth-strings (gethash clock (jget c "decayed")))
                       (cat name ": decayed " clock))))))))
    (check (> folds 6) t "fold cases")))

(defun random-decay-ledger (seed n)
  "memory/ledger decay_compose_test.go's randomDecayLedger in kind (its own generator): turns,
replies, compactions, level-0 batches on a small key pool with links to earlier records, drops,
level-1 merges and forgets, as a vector of entries."
  (let ((state seed) (out '()) (ids '()) (turn "") (rec 0))
    (labels ((rnd (k) (setf state (mod (+ (* state 1103515245) 12345) 2147483648)) (mod (floor state 65536) k))
             (pick (list) (nth (rnd (length list)) list))
             (entry (json) (entry-from-map (json-parse json)))
             (record (origin &key kind source)
               (let* ((id (format nil "~12,'0X" (+ (* seed 1000) (incf rec))))
                      (kind (or kind (pick '("fact" "attempt" "preference" "decision" "fact" "fact"))))
                      (source (or source (pick '("user-said" "tool-observed" "assistant-claim" ""))))
                      (keys (loop repeat (rnd 3) collect (pick '("a.go" "b.go" "c.go" "make ci" "go test"))))
                      (paths (remove-duplicates (remove-if (lambda (k) (search " " k)) keys) :test #'string= :from-end t))
                      (commands (remove-duplicates (remove-if-not (lambda (k) (search " " k)) keys) :test #'string= :from-end t))
                      (link (when (and ids (zerop (rnd 3)))
                              (format nil ",~S:[~S]" (pick '("supersedes" "possiblyUpdates" "conflicts" "respondsTo")) (pick ids)))))
                 (push id ids)
                 (format nil "{\"id\":~S,\"content\":\"record ~A\",\"timestamp\":\"2026-05-02T10:00:00.000Z\",\"relevance\":\"medium\",\"sourceEntryIds\":[~S],\"tokenCount\":5,\"origin\":~S,\"kind\":~S~@[,\"source\":~S~]~@[,\"outcome\":~S~]~@[~A~]~@[~A~]}"
                         id id turn origin kind (and (string/= source "") source)
                         (and (string= kind "attempt") (pick '("worked" "failed")))
                         (and (or paths commands)
                              (format nil ",\"keys\":{~{~A~^,~}}"
                                      (remove nil (list (and paths (format nil "\"paths\":[~{~S~^,~}]" paths))
                                                        (and commands (format nil "\"commands\":[~{~S~^,~}]" commands))))))
                         (and (string/= kind "forget") link))))
             (batch (id consolidated records)
               (entry (format nil "{\"type\":\"custom\",\"id\":~S,\"customType\":\"om.observations.recorded\",\"data\":{\"observations\":[~{~A~^,~}],\"coversUpToId\":~S,\"consolidated\":~A}}"
                              id records turn (if consolidated "true" "false"))))
             (dropped (id consolidated targets)
               (entry (format nil "{\"type\":\"custom\",\"id\":~S,\"customType\":\"om.observations.dropped\",\"data\":{\"observationIds\":[~{~S~^,~}],\"coversUpToId\":~S,\"consolidated\":~A}}"
                              id targets turn (if consolidated "true" "false")))))
      (dotimes (i n)
        (let ((id (format nil "e~3,'0D" i)) (r (rnd 10)))
          (cond ((or (< r 3) (string= turn ""))
                 (setf turn id)
                 (push (entry (format nil "{\"type\":\"message\",\"id\":~S,\"message\":{\"role\":\"user\",\"content\":\"message ~A\"}}" id id)) out))
                ((= r 3) (push (entry (format nil "{\"type\":\"message\",\"id\":~S,\"message\":{\"role\":\"assistant\",\"content\":\"ok\"}}" id)) out))
                ((= r 4) (push (entry (format nil "{\"type\":\"compaction\",\"id\":~S,\"summary\":\"s\",\"firstKeptEntryId\":~S,\"tokensBefore\":1}" id turn)) out))
                ((< r 8) (push (batch id nil (loop repeat (1+ (rnd 3)) collect (record "code"))) out))
                ((and (= r 8) (cdr ids))
                 (let ((a (pick ids)) (b (pick ids)))
                   (if (and (zerop (rnd 2)) (string/= a b))
                       (let ((m (record "model")))
                         (setf m (cat (subseq m 0 (1- (length m))) (format nil ",\"replaces\":[~S,~S]}" a b)))
                         (push (batch id t (list m)) out)
                         (push (dropped (cat id "d") t (list a b)) out))
                       (push (dropped id nil (list a)) out))))
                (ids
                 (let* ((target (pick ids)) (f (record "code" :kind "forget" :source "user-said")))
                   (setf f (cat (subseq f 0 (1- (length f))) (format nil ",\"forgets\":[{\"id\":~S}]}" target)))
                   (push (batch id nil (list f)) out)))
                (t (push (entry (format nil "{\"type\":\"message\",\"id\":~S,\"message\":{\"role\":\"user\",\"content\":\"m\"}}" id)) out))))))
    (coerce (nreverse out) 'simple-vector)))

(defun decay-sets-equal-p (a b)
  (and (= (hash-table-count a) (hash-table-count b))
       (loop for k being the hash-keys of a always (gethash k b))))

(deftest decay-composes
  ;; The semigroup property (decisions 6 and 12; memory/ledger TestDecayComposes): decay from a fold
  ;; checkpoint over the first k entries, advanced over the rest, in one batch or two, is decay
  ;; over the whole branch, for random ledgers, every k and both clocks.
  (let ((cases 0) (bad '()) (nonempty 0))
    (loop for seed from 1 to 30
          do (let* ((entries (random-decay-ledger seed (+ 30 (mod seed 40))))
                    (f (fold-ledger entries))
                    (active (folded-active f))
                    (by (folded-replaced-by f)))
               (dolist (clock '("compactions" "turns"))
                 (dolist (horizon '(1 2 4))
                   (let ((full (decayed-records entries active clock horizon)))
                     (when (plusp (hash-table-count full)) (incf nonempty))
                     (loop for k from 0 to (length entries)
                           do (let* ((checkpoint (decay-fold-advance (make-decay-fold) (subseq entries 0 k)))
                                     (before (decay-fold-clone checkpoint))
                                     (mid (+ k (floor (- (length entries) k) 2))))
                                (unless (decay-sets-equal-p (decay-fold-decayed (decay-fold-advance checkpoint (subseq entries k)) active by clock horizon) full)
                                  (push (list seed clock horizon k) bad))
                                (decay-fold-advance before (subseq entries k mid))
                                (unless (decay-sets-equal-p (decay-fold-decayed (decay-fold-advance before (subseq entries mid)) active by clock horizon) full)
                                  (push (list seed clock horizon k mid) bad))
                                (incf cases))))))))
    (check (first bad) nil "a checkpoint plus the rest is the full fold")
    (check (> cases 5000) t "cases")
    (check (> nonempty 30) t "decayed sets")))
