;;;; Level 1 on the image (docs/lisp-port-level1.md): validation's rules, the request over PiG's
;;;; model stream (one request event), accepted, refused and failed answers, the offer of the
;;;; consolidation instructions (decision 5), their hold and their settle at a later compaction,
;;;; and the cancellation crossing to models/streamResult.

(in-package "OM")

(defun l1-obs (id content &rest args)
  (apply #'make-obs :id id :content content :timestamp "2026-11-01 10:00" :relevance "medium"
                    :source-ids (list (cat "e" id)) :origin "code" args))

(defun l1-input (candidates &key active links)
  (make-vinput :candidates candidates :active active :folded (make-folded) :links links :branch #()))

(deftest level1-validation
  (let* ((a (l1-obs "aaaaaaaaaaaa" "The cache holds 30 entries."))
         (b (l1-obs "bbbbbbbbbbbb" "The cache holds 30 entries per shard."))
         (p (l1-obs "cccccccccccc" "Deploy on port 8080." :status "proposed"))
         (f (l1-obs "dddddddddddd" "Deployed on port 8080."))
         (in (l1-input (list a b p f))))
    ;; Only ids the prompt showed.
    (let ((r (validate-level1 (json-parse "{\"records\":[{\"id\":\"eeeeeeeeeeee\",\"subject\":\"cache\"}]}") in)))
      (check (vresult-failure r) "the output has no valid record")
      (check (third (first (vresult-refusals r))) "cites an id outside its input"))
    ;; The whole-item rule: 300 does not carry 30.
    (let ((r (validate-level1 (json-parse "{\"merges\":[{\"ids\":[\"aaaaaaaaaaaa\",\"bbbbbbbbbbbb\"],\"content\":\"The cache holds 300 entries per shard.\"}]}") in)))
      (check (third (first (vresult-refusals r))) "drops specifics of what it replaces"))
    ;; Records with different statuses never merge.
    (let ((r (validate-level1 (json-parse "{\"merges\":[{\"ids\":[\"cccccccccccc\",\"dddddddddddd\"],\"content\":\"Deploy on port 8080.\"}]}") in)))
      (check (third (first (vresult-refusals r))) +reason-merge-statuses+))
    ;; A plan never supersedes a fact.
    (let ((r (validate-level1 (json-parse "{\"records\":[{\"id\":\"cccccccccccc\",\"supersedes\":[\"dddddddddddd\"]}]}") in)))
      (check (third (first (vresult-refusals r))) +reason-status-replace+))
    ;; A merge that keeps every specific: one record replacing both, naming them.
    (let ((r (validate-level1 (json-parse "{\"merges\":[{\"ids\":[\"aaaaaaaaaaaa\",\"bbbbbbbbbbbb\"],\"content\":\"The cache holds 30 entries per shard.\",\"subject\":\"cache\"}]}") in)))
      (check (vresult-failure r) "")
      (check (obs-replaces (first (vresult-records r))) '("aaaaaaaaaaaa" "bbbbbbbbbbbb"))
      (check (obs-source-ids (first (vresult-records r))) '("eaaaaaaaaaaaa" "ebbbbbbbbbbbb"))
      (multiple-value-bind (drop reflections kept) (level1-union r (list a b))
        (declare (ignore reflections))
        (check drop '("aaaaaaaaaaaa" "bbbbbbbbbbbb"))
        (check kept 0)))
    ;; Only listed possible updates are settled.
    (let* ((later (l1-obs "ffffffffffff" "The cache holds 40 entries." :possibly-updates (list "aaaaaaaaaaaa")))
           (in (l1-input (list a later) :links (list (cons "ffffffffffff" "aaaaaaaaaaaa")))))
      (let ((r (validate-level1 (json-parse "{\"links\":[{\"id\":\"ffffffffffff\",\"updates\":\"aaaaaaaaaaaa\",\"verdict\":\"confirm\"},{\"id\":\"aaaaaaaaaaaa\",\"updates\":\"ffffffffffff\",\"verdict\":\"reject\"}]}") in)))
        (check (vresult-confirmed r) 1)
        (check (obs-supersedes (first (vresult-records r))) '("aaaaaaaaaaaa"))
        (check (third (first (vresult-refusals r))) +reason-not-link+)
        (check (vresult-link-records r) 1)))
    ;; A definition the input did not offer.
    (let ((r (validate-level1 (json-parse "{\"definitions\":[{\"kind\":\"instructions\",\"name\":\"consolidation\",\"text\":\"x\"}]}") in)))
      (check (third (first (vresult-refusals r))) +reason-not-offered+))
    (let ((r (validate-level1 (json-parse "{\"definitions\":[{\"kind\":\"detector\",\"name\":\"d\",\"text\":\"x\"}],\"rules\":[{\"detector\":\"a\",\"remedy\":\"b\"}]}")
                              (make-vinput :candidates (list a) :folded (make-folded) :branch #() :offer (make-offer)))))
      (check (mapcar #'third (vresult-refusals r)) (list +reason-not-offered+ +reason-not-offered+) "decision 5: text only"))
    (check (vresult-failure (validate-level1 nil in)) "the response did not call consolidate_memory")))

(deftest level1-prompt-and-tool
  (check (has-prefix (consolidate-system-prompt "") "You consolidate the memory of a coding session") t "kernel-consolidate first")
  (check (and (search "What is worth doing:" (consolidate-system-prompt "")) t) t "then the seed")
  (check (and (search (cat "Additional instructions for this model:" (string #\Newline) "Keep it short.")
                      (consolidate-system-prompt "Keep it short.")) t) t)
  (multiple-value-bind (name description parameters) (consolidate-tool (make-offer))
    (declare (ignore description))
    (let ((props (jget parameters "properties")))
      (check name "consolidate_memory")
      (check (coerce (jget (jget (jget (jget (jget props "definitions") "items") "properties") "kind") "enum") 'list) '("instructions"))
      (check (nth-value 1 (gethash "rules" props)) nil "no rules: no remedy is offered")))
  (check (nth-value 1 (gethash "definitions" (jget (nth-value 2 (consolidate-tool)) "properties"))) nil))

;;; Over the image

(defstruct l1host phost (requests '()) (reply nil) (hold nil) (stream-results 0))

(defun l1-answer (l method params)
  (cond ((string= method "models/getApiKeyAndHeaders") (jobject "auth" (jobject "ok" :true "apiKey" "test-key")))
        ((string= method "models/isUsingOAuth") (jobject "value" :false))
        ((string= method "models/hasConfiguredAuth") (jobject "value" :true))
        ((string= method "models/stream")
         (push (jget params "request") (l1host-requests l))
         (jobject "stream" "s1"))
        ((string= method "models/streamResult")
         (incf (l1host-stream-results l))
         (jobject "message" (funcall (l1host-reply l) (first (l1host-requests l))) "events" 1))
        (t (phost-answer (l1host-phost l) method params))))

(defun l1-candidate-ids (request)
  "The candidate ids the request's user text shows."
  (let* ((text (jget (aref (jget (aref (jget request "messages") 0) "content") 0) "text"))
         (start (search "CANDIDATES" text)) (out '()))
    (dolist (line (split (subseq text start) (string #\Newline)) out)
      (when (and (> (length line) 14) (char= (char line 0) #\[) (char= (char line 13) #\]))
        (push-end (subseq line 1 13) out)))))

(defun tool-call-message (args &key (stop "toolUse"))
  (jobject "role" "assistant" "stopReason" stop
           "content" (vector (jobject "type" "toolCall" "id" "c1" "name" "consolidate_memory" "arguments" args))
           "usage" (jobject "input" 900 "output" 40 "cacheRead" 0 "cacheWrite" 0 "totalTokens" 940)))

(defun l1-compact (stream id dir l branch)
  (jget (jget (jget (peer-exchange stream id "event/sessionBeforeCompact"
                                   (jobject "scope" (pig-scope dir) "data" (before-compact-data branch "qu"))
                                   :host (lambda (m p) (l1-answer l m p)))
                    "result")
              "result")
        "compaction"))

(defun l1-branch ()
  (concatenate 'simple-vector (pig-turn "p" "Deploy on port 8080 and cache in /var/cache/app.") (pig-turn "q" "Now the saver.")))

(deftest level1-over-the-image
  (let* ((branch (l1-branch))
         (h (make-phost :branch branch :model (jobject "provider" "p" "id" "m" "contextWindow" 200000 "maxTokens" 32000)))
         (l (make-l1host :phost h)) (events '()))
    (with-pig (stream dir)
      (write-file* (format nil "~Asettings.json" dir) "{}")
      (om.server::with-request-observer ((lambda (event data) (push (cons event data) events)))
        ;; Accepted: a label of the first candidate.
        (setf (l1host-reply l) (lambda (request)
                                 (tool-call-message (jobject "records" (vector (jobject "id" (first (l1-candidate-ids request))
                                                                                        "subject" "deploy" "relevance" "high"))))))
        (let* ((c (l1-compact stream 1 dir l branch)) (report (jget (jget c "details") "consolidation"))
               (request (first (l1host-requests l))))
          (check (jget report "applied") :true "applied")
          (check (jget report "requested") :true)
          (check (jget report "records") 1d0)
          (check (jget (jget c "usage") "input") 900d0 "the request's usage on the compaction")
          (check (has-prefix (jget request "systemPrompt") "You consolidate the memory") t)
          (check (and (search "consolidate_memory tool carrying your whole answer" (jget request "systemPrompt")) t) t)
          (check (jget (aref (jget request "tools") 0) "name") "consolidate_memory")
          (check (jget request "maxTokens") 32000d0)
          (check (jget request "apiKey") "test-key")
          (check (length events) 1 "one request event")
          (check (car (first events)) "model.request")
          (check (jget (cdr (first events)) "request") :true)
          (let ((l1 (find-if (lambda (a) (and (equal (car a) "om.observations.recorded") (eq (jget (cdr a) "consolidated") :true)))
                             (phost-appended h))))
            (check (and l1 t) t "level 1's records appended")
            (check (jget (aref (jget (cdr l1) "observations") 0) "subject") "deploy")
            (check (length (jget (aref (jget (cdr l1) "observations") 0) "replaces")) 1 "it names what it replaces")))
        ;; Refused: every proposal cites a foreign id; nothing appended by level 1.
        (setf (phost-branch h) branch (phost-appended h) '() events '()
              (l1host-reply l) (lambda (request) (declare (ignore request))
                                 (tool-call-message (jobject "records" (vector (jobject "id" "000000000000" "subject" "x"))))))
        (let ((report (jget (jget (l1-compact stream 2 dir l branch) "details") "consolidation")))
          (check (jget report "applied") :false)
          (check (jget report "reason") "the output has no valid record")
          (check (jget report "refused") 1d0)
          (check (find-if (lambda (a) (eq (jget (cdr a) "consolidated") :true)) (phost-appended h)) nil "nothing appended")
          (check (length events) 1))
        ;; Failed: the output cap, and a stream error.
        (setf (phost-branch h) branch (phost-appended h) '()
              (l1host-reply l) (lambda (request) (declare (ignore request)) (tool-call-message (jobject) :stop "length")))
        (check (jget (jget (jget (l1-compact stream 3 dir l branch) "details") "consolidation") "reason")
               "the response reached the output cap (stopReason length)")
        (setf (phost-branch h) branch (phost-appended h) '()
              (l1host-reply l) (lambda (request) (declare (ignore request))
                                 (jobject "role" "assistant" "stopReason" "error" "errorMessage" "overloaded" "content" (vector))))
        (check (jget (jget (jget (l1-compact stream 4 dir l branch) "details") "consolidation") "reason")
               "consolidate stream ended with stopReason \"error\": overloaded")
        (check (count "consolidate.stream_error" events :key #'car :test #'equal) 1 "a failed response logs its stream_error event")
        (check (length (l1host-requests l)) 4 "one request per compaction")))))

(deftest level1-merge-redacts-secrets-in-details
  ;; A merge whose text repeats a secret is redacted in the appended entry and in the projection
  ;; the compaction's details carry (hooks.TestV2Level1MergeRedactsSecretsInDetails).
  (let* ((value (concatenate 'string "Hb1Jc5Fd0Ge8" "QaT2Zq8Vt2" "Lm4"))
         (branch (concatenate 'simple-vector (pig-turn "p" "Deploy on port 8080 from the Makefile.")
                              (pig-turn "r" "Staging deploys use port 8080 and the Makefile too.") (pig-turn "q" "Now the saver.")))
         (h (make-phost :branch branch :model (jobject "provider" "p" "id" "m" "contextWindow" 200000 "maxTokens" 32000)))
         (l (make-l1host :phost h)))
    (with-pig (stream dir)
      (write-file* (format nil "~Asettings.json" dir) "{}")
      (setf (l1host-reply l)
            (lambda (request)
              (let ((ids (l1-candidate-ids request)))
                (tool-call-message (jobject "merges" (vector (jobject "ids" (vector (first ids) (second ids)) "subject" "deploy"
                                                                      "content" (cat "Staging deploys use port 8080 and the Makefile, with api_key=" value))))))))
      (let* ((c (l1-compact stream 1 dir l branch))
             (details (with-output-to-string (out) (write-json (jget c "details") out)))
             (appended (with-output-to-string (out) (dolist (a (phost-appended h)) (write-json (cdr a) out)))))
        (check (jget (jget (jget c "details") "consolidation") "merges") 1d0 "the merge is accepted")
        (check (search value details) nil "no value in the details")
        (check (search value appended) nil "no value appended")
        (check (and (search "[redacted:" details) t) t)))))

(deftest level1-offer-hold-and-settle
  (let* ((branch (l1-branch))
         (h (make-phost :branch branch :model (jobject "provider" "p" "id" "m" "contextWindow" 200000 "maxTokens" 32000)))
         (l (make-l1host :phost h)))
    (with-pig (stream dir)
      (write-file* (format nil "~Asettings.json" dir) "{}")
      (setf (phost-home h) dir)
      (let* ((store (format nil "~A/observational-memory/memories" (string-right-trim "/" dir)))
             (ledger (format nil "~A/models/p_2fm.jsonl" store)))
        ;; Evidence that changed since no proposal: the offer is due.
        (om.layer::append-line ledger "{\"time\":\"2026-11-01T09:00:00Z\",\"model\":\"p/m\",\"kind\":\"pass\",\"outcome\":\"ok\",\"stage\":\"compaction\",\"tokens\":500,\"counts\":{\"level1-union-kept\":1},\"engine\":\"v2\",\"level1\":true}")
        (setf (l1host-reply l)
              (lambda (request)
                (tool-call-message (jobject "records" (vector (jobject "id" (first (l1-candidate-ids request)) "subject" "deploy"))
                                            "definitions" (vector (jobject "kind" "instructions" "name" "consolidation"
                                                                           "text" "Prefer one record per deploy target and keep its port."))))))
        (let* ((c (l1-compact stream 1 dir l branch)) (report (jget (jget c "details") "consolidation"))
               (request (first (l1host-requests l)))
               (text (jget (aref (jget (aref (jget request "messages") 0) "content") 0) "text")))
          (check (jget report "harnessOffered") :true)
          (check (jget report "defined") 1d0 "held")
          (check (and (search "You may define: instructions (instructions only \"consolidation\"" text) t) t "the offer is text only")
          (check (search "detector" (subseq text (search "HARNESS EVIDENCE" text))) nil "no detector is offered")
          (check (and (probe-file (format nil "~A/harness/p_2fm/held/instructions/consolidation.rows" store)) t) t "held in the Go layer")
          (check (and (notice-with-p h "held until a later compaction proves it") t) t))
        ;; The next compaction runs with the held text, credits it, and settles it clean.
        (setf (phost-branch h) branch (phost-appended h) '()
              (l1host-reply l) (lambda (request)
                                 (tool-call-message (jobject "records" (vector (jobject "id" (first (l1-candidate-ids request)) "subject" "deploy"))))))
        (let* ((c (l1-compact stream 2 dir l branch)) (request (first (l1host-requests l))))
          (check (jget (jget (jget c "details") "consolidation") "applied") :true)
          (check (and (search "Additional instructions for this model:" (jget request "systemPrompt")) t) t "the held text applies")
          (check (and (search "instructions/consolidation@" (json-string (om.layer::ev (car (last (om.layer::read-model-events ledger))) "ranHeld"))) t)
                 t "the pass credits it")
          (check (and (probe-file (format nil "~A/harness/p_2fm/instructions/consolidation.rows" store)) t) t "settled: written")
          (check (and (notice-with-p h "passed a clean pass and is written to the layer") t) t))))))

(deftest level1-cancel-crosses-to-the-stream
  (let* ((branch (l1-branch))
         (h (make-phost :branch branch :model (jobject "provider" "p" "id" "m" "contextWindow" 200000 "maxTokens" 32000)))
         (l (make-l1host :phost h)) (events '()) (cancel-for nil) (result-call nil))
    (with-pig (stream dir)
      (write-file* (format nil "~Asettings.json" dir) "{}")
      (om.server::with-request-observer ((lambda (event data) (push (cons event data) events)))
        (peer-send-line stream (jobject "jsonrpc" "2.0" "id" 7 "method" "event/sessionBeforeCompact"
                                        "params" (jobject "scope" (pig-scope dir) "data" (before-compact-data branch "qu"))))
        (let ((answer
                (loop for m = (peer-read stream)
                      do (cond ((null m) (return nil))
                               ((equal (jget m "method") "$/cancelRequest") (setf cancel-for (jget (jget m "params") "id")))
                               ((equal (jget m "method") "models/streamResult")
                                (setf result-call (jget m "id"))
                                (peer-send-line stream (jobject "jsonrpc" "2.0" "method" "$/cancelRequest" "params" (jobject "id" 7)))
                                (let ((c (peer-read stream)))
                                  (check (jget c "method") "$/cancelRequest" "the cancel crosses to models/streamResult")
                                  (setf cancel-for (jget (jget c "params") "id")))
                                (peer-send-line stream (jobject "jsonrpc" "2.0" "id" result-call
                                                                "error" (jobject "code" -32800 "message" "context canceled"))))
                               ((stringp (jget m "method"))
                                (let ((r (l1-answer l (jget m "method") (jget m "params"))))
                                  (peer-send-line stream (if (consp r)
                                                             (jobject "jsonrpc" "2.0" "id" (jget m "id") "error" (jobject "code" (second r) "message" (third r)))
                                                             (jobject "jsonrpc" "2.0" "id" (jget m "id") "result" r)))))
                               ((equal (jget m "id") 7d0) (return m))))))
          (check cancel-for result-call "the cancel names the stream's drain")
          (check (jget (jget answer "result") "result") :null "a cancelled compaction answers no result")
          (check (length (l1host-requests l)) 1 "one request")
          (check (length events) 1 "one request event")
          (check (jget (cdr (first events)) "aborted") :true "logged as aborted")
          (check (find-if (lambda (a) (eq (jget (cdr a) "consolidated") :true)) (phost-appended h)) nil "nothing appended"))))))

(deftest level1-leaves-held-records-out
  ;; A held record (held-rule) never reaches the level-1 request (decision 19).
  (let* ((branch (concatenate 'simple-vector
                              (pig-turn "p" "I prefer to commit with --no-verify so the hooks are skipped. Deploy on port 8080.")
                              (pig-turn "q" "Now the saver.")))
         (h (make-phost :branch branch :model (jobject "provider" "p" "id" "m" "contextWindow" 200000 "maxTokens" 32000)))
         (l (make-l1host :phost h)))
    (with-pig (stream dir)
      (write-file* (format nil "~Asettings.json" dir) "{}")
      (setf (l1host-reply l) (lambda (request)
                               (tool-call-message (jobject "records" (vector (jobject "id" (first (l1-candidate-ids request))
                                                                                      "subject" "deploy" "relevance" "high"))))))
      (l1-compact stream 1 dir l branch)
      (let* ((held (loop for (type . data) in (phost-appended h)
                         when (equal type "om.observations.recorded")
                           append (loop for o across (jget data "observations")
                                        when (search "--no-verify" (jget o "content")) collect (jget o "id"))))
             (request (first (l1host-requests l)))
             (text (and request (jget (aref (jget (aref (jget request "messages") 0) "content") 0) "text"))))
        (check (and held t) t "level 0 recorded the preference")
        (check (and request t) t "one level-1 request")
        (dolist (id held)
          (check (member id (l1-candidate-ids request) :test #'equal) nil "the held record is no candidate")
          (check (search (format nil "[~A]" id) text) nil "the held record is not shown"))))))
