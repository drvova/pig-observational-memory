;;;; ledger: cases copied from ledger/reldate_test.go and ledger/specifics_test.go.

(in-package "OM")

(defun day (y m d) (days-from-civil y m d))

(deftest resolve-relative-dates-patterns
  (let ((anchor (day 2023 5 24)))
    (dolist (c '(("User baked bread today." "User baked bread today [=2023-05-24].")
                 ("User baked bread yesterday." "User baked bread yesterday [=2023-05-23].")
                 ("User will bake tomorrow." "User will bake tomorrow [=2023-05-25].")
                 ("Today the user left." "Today [=2023-05-24] the user left.")
                 ("User ran last Tuesday." "User ran last Tuesday [=2023-05-23].")
                 ("User ran last Wednesday." "User ran last Wednesday [=2023-05-17].")
                 ("User ran last Friday." "User ran last Friday [=2023-05-19].")
                 ("User runs this Monday." "User runs this Monday [=2023-05-22].")
                 ("User runs this Friday." "User runs this Friday [=2023-05-26].")
                 ("User runs this Sunday." "User runs this Sunday [=2023-05-28].")
                 ("User runs next Friday." "User runs next Friday [=2023-05-26].")
                 ("User runs next Wednesday." "User runs next Wednesday [=2023-05-31].")
                 ("User moved last week." "User moved last week [=week of 2023-05-15].")
                 ("User moves next week." "User moves next week [=week of 2023-05-29].")
                 ("User moved last month." "User moved last month [=2023-04].")
                 ("User moves next month." "User moves next month [=2023-06].")
                 ("User moved last year." "User moved last year [=2022].")
                 ("User moves next year." "User moves next year [=2024].")
                 ("User called 3 days ago." "User called 3 days ago [=2023-05-21].")
                 ("User called one day ago." "User called one day ago [=2023-05-23].")
                 ("User called two weeks ago." "User called two weeks ago [=2023-05-10].")
                 ("User called a week ago." "User called a week ago [=2023-05-17].")
                 ("User called 2 months ago." "User called 2 months ago [=2023-03].")
                 ("User called a month ago." "User called a month ago [=2023-04].")
                 ("User will fly in 3 days." "User will fly in 3 days [=2023-05-27].")
                 ("User plans to fly in two weeks." "User plans to fly in two weeks [=2023-06-07].")
                 ("User's flight is due in a week." "User's flight is due in a week [=2023-05-31].")
                 ("User flies in 3 days from now." "User flies in 3 days [=2023-05-27] from now.")
                 ("User flew to Delhi the day before yesterday." "User flew to Delhi the day before yesterday [=2023-05-22].")
                 ("User flies the day after tomorrow." "User flies the day after tomorrow [=2023-05-26].")
                 ("User called day before yesterday." "User called day before yesterday [=2023-05-22].")
                 ("User hikes this weekend." "User hikes this weekend [=2023-05-27].")
                 ("User hiked last weekend." "User hiked last weekend [=2023-05-20].")
                 ("User hiked a couple of days ago." "User hiked a couple of days ago [=2023-05-22].")
                 ("User hiked a couple days ago." "User hiked a couple days ago [=2023-05-22].")
                 ("User met Ana yesterday and calls her tomorrow." "User met Ana yesterday [=2023-05-23] and calls her tomorrow [=2023-05-25].")
                 ("User skipped today's class." "User skipped today's [=2023-05-24] class.")))
      (check (resolve-relative-dates (first c) anchor) (second c) (first c)))))

(deftest resolve-relative-dates-calendar-edges
  (check (resolve-relative-dates "last month and 2 months ago" (day 2024 1 15)) "last month [=2023-12] and 2 months ago [=2023-11]")
  (check (resolve-relative-dates "one month ago" (day 2024 3 31)) "one month ago [=2024-02]")
  (check (resolve-relative-dates "this weekend, last weekend, next week" (day 2023 5 28))
         "this weekend [=2023-05-27], last weekend [=2023-05-20], next week [=week of 2023-05-29]")
  (check (resolve-relative-dates "finished in two weeks" (day 2023 5 24)) "finished in two weeks")
  (check (resolve-relative-dates "yesterday [=2023-05-23]" (day 2023 5 24)) "yesterday [=2023-05-23]")
  (check (resolve-relative-dates "She said \"see you tomorrow\" today" (day 2023 5 24)) "She said \"see you tomorrow\" today [=2023-05-24]")
  (check (resolve-relative-dates "tomorrow" nil) "tomorrow")
  (check (event-date "Ana booked it yesterday for tomorrow" (day 2023 5 24)) "")
  (check (event-date "Ana flies tomorrow" (day 2023 5 24)) "2023-05-25")
  (check (event-date "Ana moves next week" (day 2023 5 24)) ""))

(deftest specifics-numbers-dates-names
  (dolist (c '(("User got a peace lily two weeks ago and a snake plant last month." ("two weeks ago" "last month"))
               ("User bought a Gucci handbag for $1,200 and boots for $500." ("1200" "500" "gucci"))
               ("User asked for tips on organizing a closet." ())
               ("They visited Rhythm Central. The shop was busy." ("rhythm" "central"))))
    (check (specifics (first c)) (second c) (first c))))

(deftest missing-and-added-specifics
  (let ((text "User paid $1,200 for a Gucci handbag yesterday."))
    (check (missing-specifics text '("User owns a Gucci handbag bought for $1200 yesterday.")) '())
    (check (missing-specifics text '("User owns a designer handbag.")) '("1200" "yesterday" "gucci")))
  (let ((user '("Lisbon is my race: the half-marathon on March 8. I run long on Sunday and have €1,400 saved.")))
    (check (added-specifics "Your Lisbon's half on March 8 and the 1400 euros, with Sunday long runs." user) '())
    (check (added-specifics "For the Lisbon half, follow the Hanson plan for 18 weeks." user) '("18" "hanson")))
  (check (added-specifics "Race on the 8th." '("race on the 18th")) '("8"))
  (dolist (c '(("Fly to the US." "Can you tell us where to fly?" ("us"))
               ("I'd try Nice instead." "Somewhere nice and warm please" ("nice"))
               ("See you in May then" "may I go in spring" ("may"))
               ("Ask at Banks for a loan." "which bank should I use?" ("banks"))
               ("Walk in the Woods." "I like the woods" ("woods"))))
    (check (added-specifics (first c) (list (second c))) (third c) (first c))))

(deftest links-and-status
  (check (updates-specific-p "The connection pool size is 12." "The connection pool size is 8.") t)
  (check (updates-specific-p "The pool is 8, with 2 spares." "The pool is 8.") nil)
  (check (negation-conflict-p "the release ships Friday" "the release does not ship Friday") t)
  (check (sort (loop for k being the hash-keys of (negated-specifics "use Redis, not Memcached") collect k) #'string<) '("memcached"))
  (check (may-supersede-p "" "proposed") t)
  (check (may-supersede-p "proposed" "") nil)
  (check (may-supersede-p "retracted" "hypothetical") t)
  (check (may-supersede-p "retracted" "") nil))
