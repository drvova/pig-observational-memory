;;;; The core log against its contract cases (contracts/core.jsonl): memory/core's answers, which
;;;; src/core.lisp must equal byte for byte: the pure functions, a torn log's fold, a script's log
;;;; and markers, items, blocks and status lines, and the candidates and forget lines of a ledger.

(in-package "OM")

(defun core-strings (v) (if (and (vectorp v) (not (stringp v))) (map 'list (lambda (x) (if (eq x :null) "" x)) v) '()))

(defun core-cand-from (m)
  (let ((w (jget m "writer")))
    (om.layer::make-ccand :kind (str (jget m "kind")) :key (str (jget m "key")) :text (str (jget m "text"))
                          :scope (str (jget m "scope")) :via (str (jget m "via")) :roots (core-strings (jget m "roots"))
                          :tool-only (jtrue-p (jget m "toolOnly")) :one-time (jtrue-p (jget m "oneTime"))
                          :record (str (jget m "record")) :said (str (jget m "said")) :writer-model (str (jget w "model"))
                          :writer-session (str (jget w "session"))
                          :base (let ((b (jget m "base"))) (if (realp b) (truncate b) 0)))))

(defun core-cand-json (c)
  "A candidate as Go's encoding of core.Candidate writes it."
  (let ((h (make-hash-table :test 'equal)))
    (setf (gethash "kind" h) (om.layer::ccand-kind c) (gethash "text" h) (om.layer::ccand-text c)
          (gethash "scope" h) (om.layer::ccand-scope c) (gethash "base" h) (om.layer::ccand-base c))
    (loop for (k v) in `(("key" ,(om.layer::ccand-key c)) ("via" ,(om.layer::ccand-via c)) ("record" ,(om.layer::ccand-record c))
                         ("said" ,(om.layer::ccand-said c)))
          when (string/= v "") do (setf (gethash k h) v))
    (when (om.layer::ccand-roots c) (setf (gethash "roots" h) (coerce (om.layer::ccand-roots c) 'vector)))
    (when (om.layer::ccand-tool-only c) (setf (gethash "toolOnly" h) :true))
    (when (om.layer::ccand-one-time c) (setf (gethash "oneTime" h) :true))
    (let ((w (make-hash-table :test 'equal)))
      (when (string/= (om.layer::ccand-writer-model c) "") (setf (gethash "model" w) (om.layer::ccand-writer-model c)))
      (when (string/= (om.layer::ccand-writer-session c) "") (setf (gethash "session" w) (om.layer::ccand-writer-session c)))
      (setf (gethash "writer" h) w))
    (json-string h)))

(defun core-line-from (m)
  (let ((w (jget m "writer")))
    (om.layer::make-cline :op (str (jget m "op")) :id (str (jget m "id")) :of (str (jget m "of")) :kind (str (jget m "kind"))
                          :key (str (jget m "key")) :text (str (jget m "text")) :scope (str (jget m "scope"))
                          :via (str (jget m "via")) :roots (core-strings (jget m "roots")) :record (str (jget m "record"))
                          :tombstones (core-strings (jget m "tombstones"))
                          :base (let ((b (jget m "base"))) (if (realp b) (truncate b) 0)) :time (str (jget m "time"))
                          :writer-model (str (jget w "model")) :writer-session (str (jget w "session")))))

(defun core-item-json (it)
  (let ((h (make-hash-table :test 'equal)))
    (loop for (k v) in `(("id" ,(om.layer::citem-id it)) ("kind" ,(om.layer::citem-kind it)) ("key" ,(om.layer::citem-key it))
                         ("text" ,(om.layer::citem-text it)) ("scope" ,(om.layer::citem-scope it)) ("via" ,(om.layer::citem-via it))
                         ("record" ,(om.layer::citem-record it)) ("roots" ,(coerce (om.layer::citem-roots it) 'vector))
                         ("writerModel" ,(om.layer::citem-writer-model it)) ("writerSession" ,(om.layer::citem-writer-session it))
                         ("born" ,(om.layer::citem-born it)) ("gen" ,(om.layer::citem-gen it)) ("status" ,(om.layer::citem-status it))
                         ("with" ,(coerce (om.layer::citem-with it) 'vector)) ("replacedBy" ,(om.layer::citem-replaced-by it)))
          do (setf (gethash k h) v))
    (json-string h)))

(defun core-want-items (c) (map 'list #'json-string (or (jget c "items") #())))

(defvar *core-tests-here* (make-pathname :name nil :type nil :defaults *load-truename*))

(deftest core-contract-cases
  (let ((cases (contract-cases "core.jsonl")) (scripts 0))
    (check (>= (length cases) 7) t "cases read")
    (dolist (c cases)
      (let ((name (jget c "name")))
        (loop for p across (or (jget c "strip") #())
              do (check (om.layer::strip-values (aref p 0)) (aref p 1) (cat name ": " (aref p 0))))
        (loop for p across (or (jget c "intersect") #())
              for l = (core-strings p)
              do (check (om.layer::intersect-scopes (butlast l)) (car (last l)) (cat name ": " (join (butlast l) ","))))
        (loop for p across (or (jget c "family") #())
              do (check (om.layer::model-family (aref p 0)) (aref p 1) (cat name ": " (aref p 0))))
        (loop for p across (or (jget c "hints") #())
              do (check (om.layer::model-hint (aref p 0) (aref p 1)) (aref p 2) (cat name ": hint " (aref p 0))))
        (loop for p across (or (jget c "roots") #())
              do (check (om.layer::evidence-root (aref p 0) (aref p 1) (aref p 2)) (aref p 3) (cat name ": root " (aref p 1))))
        (loop for p across (or (jget c "commandPaths") #())
              do (check (om.layer::command-path (aref p 0)) (aref p 1) (cat name ": " (aref p 0))))
        (loop for p across (or (jget c "grepPaths") #())
              do (check (om.layer::grep-path (aref p 0) (aref p 1)) (aref p 2) (cat name ": grep " (aref p 0))))
        (loop for p across (or (jget c "userRoots") #())
              do (check (om.layer::user-root (aref p 0) (aref p 1)) (aref p 2) (cat name ": user root")))
        (loop for p across (or (jget c "projectRoots") #())
              do (check (om.layer::project-root-digest (aref p 0)) (aref p 1) (cat name ": project root")))
        (loop for p across (or (jget c "itemIds") #())
              do (check (om.layer::item-id (aref p 0) (aref p 1) (aref p 2) (aref p 3)) (aref p 4) (cat name ": item id")))
        (loop for s across (or (jget c "oneTime") #()) do (check (one-time-p s) t (cat name ": one-time " s)))
        (loop for s across (or (jget c "notOneTime") #()) do (check (one-time-p s) nil (cat name ": not one-time " s)))
        ;; A log folded as it stands.
        (when (and (jget c "log") (not (jget c "steps")))
          (let ((st (om.layer::core-fold (jget c "log") -1)))
            (check (list (om.layer::cstate-gen st) (om.layer::cstate-next st) (om.layer::cstate-torn st))
                   (mapcar (lambda (k) (truncate (or (jget c k) 0))) (list "gen" "next" "torn")) (cat name ": gen next torn"))
            (check (mapcar #'core-item-json (om.layer::cstate-items st)) (core-want-items c) (cat name ": items"))))
        ;; A script on a fresh log at the fixed clock.
        (when (jget c "steps")
          (incf scripts)
          (let* ((dir (format nil "/tmp/om-core-test-~D-~D/" (sb-posix:getpid) (random 1000000)))
                 (core (concatenate 'string dir "core"))
                 (om.layer::*now* (lambda () (om.layer::parse-rfc3339 "2026-11-07T09:00:00Z")))
                 (verdicts '()))
            (unwind-protect
                 (progn
                   (loop for s across (jget c "steps")
                         for op = (jget s "op")
                         do (cond ((string= op "promote")
                                   (push (nth-value 1 (om.layer::core-promote-all core (map 'list #'core-cand-from (jget s "candidates"))))
                                         verdicts))
                                  ((string= op "commit")
                                   (om.layer::core-commit core (lambda (st emit) (declare (ignore st))
                                                                 (loop for l across (jget s "lines") do (funcall emit (core-line-from l))))))
                                  ((string= op "pull") (om.layer::core-pull core (jget s "session")))))
                   (check (reverse verdicts) (map 'list #'core-strings (or (jget c "verdicts") #())) (cat name ": verdicts"))
                   (check (or (om.layer::read-file (om.layer::core-log-path core)) "") (or (jget c "log") "") (cat name ": log bytes"))
                   (check (or (om.layer::read-file (om.layer::core-consumed-path core)) "") (or (jget c "consumed") "") (cat name ": consumed bytes"))
                   (let ((st (om.layer::core-read core)))
                     (check (list (om.layer::cstate-gen st) (om.layer::cstate-next st)) (mapcar (lambda (k) (truncate (or (jget c k) 0))) (list "gen" "next")) (cat name ": gen next"))
                     (check (mapcar #'core-item-json (om.layer::cstate-items st)) (core-want-items c) (cat name ": items"))
                     (loop for v across (or (jget c "sections") #())
                           do (check (om.layer::core-section st (core-strings (jget v "scopes")) (jget v "model")) (jget v "text")
                                     (cat name ": section " (join (core-strings (jget v "scopes")) ","))))
                     (loop for d across (or (jget c "forgetDue") #())
                           do (check (and (om.layer::core-forget-due-p st (core-line-from (jget d "line"))) t) (jtrue-p (jget d "due"))
                                     (cat name ": forget due " (jget (jget d "line") "id"))))
                     (loop for v across (or (jget c "status") #())
                           do (multiple-value-bind (through ok) (om.layer::core-consumed core (jget v "session"))
                                (check (om.layer::core-status-lines st through ok) (core-strings (jget v "lines"))
                                       (cat name ": status " (jget v "session")))))))
              (sb-ext:delete-directory dir :recursive t))))
        ;; Candidates and forget lines from a ledger.
        (when (jget c "records")
          (let* ((records (map 'list #'observation-from (jget c "records")))
                 (labels (jget c "labels"))
                 (s (jget c "session")))
            (check (mapcar #'core-cand-json (om.layer::core-candidates records labels (core-strings (jget c "closed"))
                                                                     (jget s "scope") (str (jget (jget s "writer") "model"))
                                                                     (str (jget (jget s "writer") "session"))
                                                                     (truncate (jget s "base")) #'one-time-p))
                   (map 'list (lambda (x) (json-string (core-cand-from-roundtrip x))) (jget c "candidates"))
                   (cat name ": candidates"))
            (loop for f across (jget c "forgets")
                  do (multiple-value-bind (line ok)
                         (om.layer::forget-cline (observation-from (jget f "forget"))
                                                 (let ((v (jget f "forgotten"))) (if (vectorp v) (map (quote list) (function observation-from) v) nil))
                                                 (jget s "scope") (str (jget (jget s "writer") "model"))
                                                 (str (jget (jget s "writer") "session")) (truncate (jget s "base")))
                       (check (and ok t) (jtrue-p (jget f "ok")) (cat name ": forget ok"))
                       (when ok
                         (check (om.layer::encode-cline line)
                                (om.layer::encode-cline (core-line-from (jget f "line")))
                                (cat name ": forget line")))))))))
    (check (>= scripts 1) t "script cases")))

(defun core-cand-from-roundtrip (m)
  "Go's candidate as decoded, re-read through core-cand-json's member set (a hash table)."
  (json-parse (coerce (core-cand-json (core-cand-from m)) 'simple-string)))
