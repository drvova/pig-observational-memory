;;;; W6: the two-way peer (docs/lisp-port-peer.md): concurrent requests, a host call made in
;;;; the middle of a request, cancellation both ways, a lost connection failing the pending
;;;; calls, shutdown ending one connection only, and the first engine-rpc events over a scripted
;;;; host.

(in-package "OM")

(defun peer-send-line (stream object)
  (write-string (json-string object) stream)
  (write-char #\Newline stream)
  (finish-output stream))

(defun peer-read (stream)
  (let ((line (read-line stream nil nil)))
    (and line (json-parse (coerce line 'simple-string)))))

(defun peer-exchange (stream id method params &key (host (lambda (method params) (declare (ignore method params)) (jobject))) (seen nil))
  "Sends request id and answers the image's host calls with host (a result object, or
(:error code message)) until the answer to id arrives; returns it. seen, when given, is called
with each host call's method and params as it arrives."
  (peer-send-line stream (jobject "jsonrpc" "2.0" "id" id "method" method "params" params))
  (loop for m = (peer-read stream)
        do (cond ((null m) (return nil))
                 ((stringp (jget m "method"))
                  (when seen (funcall seen (jget m "method") (jget m "params")))
                  (when (nth-value 1 (gethash "id" m))
                    (let ((r (funcall host (jget m "method") (jget m "params"))))
                      (peer-send-line stream
                                      (if (and (consp r) (eq (car r) :error))
                                          (jobject "jsonrpc" "2.0" "id" (jget m "id")
                                                   "error" (jobject "code" (second r) "message" (third r)))
                                          (jobject "jsonrpc" "2.0" "id" (jget m "id") "result" r))))))
                 ((equal (jget m "id") (coerce id 'double-float)) (return m)))))

(defun peer-init (stream &rest params)
  (peer-exchange stream 1000 "initialize" (apply #'jobject "protocolVersion" 1 params)))

(defvar *peer-test-log* '())
(defvar *peer-test-mutex* (sb-thread:make-mutex))
(defun peer-note (x) (sb-thread:with-mutex (*peer-test-mutex*) (push x *peer-test-log*)))

(defmacro with-test-methods (names &body body)
  `(unwind-protect (progn ,@body)
     (dolist (n ',names) (remhash n om.server:*methods*))))

(deftest peer-concurrent-and-callbacks
  (with-server-dir (dir)
    (let ((socket (format nil "~Aengine.sock" dir)))
      (om.server:start-server :root dir :socket socket :idle-seconds 0)
      (with-test-methods ("test/slow" "test/fast" "test/callback")
        (om.server:define-method "test/slow" (params) (sleep 0.4) (jobject "who" "slow"))
        (om.server:define-method "test/fast" (params) (jobject "who" "fast"))
        (om.server:define-method "test/callback" (params)
          (let ((r (om.server::host-call "host/echo" "x" (jget params "x"))))
            (jobject "echoed" (jget r "x"))))
        (multiple-value-bind (stream sock) (test-connect socket)
          (check (jget (jget (peer-init stream) "result") "engine") "lisp" "initialize")
          ;; Two engine-rpc requests in flight: the fast one answers first.
          (peer-send-line stream (jobject "jsonrpc" "2.0" "id" 1 "method" "test/slow"))
          (peer-send-line stream (jobject "jsonrpc" "2.0" "id" 2 "method" "test/fast"))
          (check (jget (peer-read stream) "id") 2d0 "the fast request answers first")
          (check (jget (jget (peer-read stream) "result") "who") "slow")
          ;; A host call in the middle of a request, with ids counting up from 1.
          (let ((ids '()))
            (check (jget (jget (peer-exchange stream 3 "test/callback" (jobject "x" "a")
                                              :host (lambda (m p) (declare (ignore m)) (jobject "x" (cat (jget p "x") "!")))
                                              :seen (lambda (m p) (declare (ignore p)) (push m ids)))
                               "result") "echoed")
                   "a!" "the host's answer reaches the handler")
            (check ids '("host/echo")))
          ;; A host call answered with an error fails the request with it.
          (check (jget (jget (peer-exchange stream 4 "test/callback" (jobject "x" "b")
                                            :host (lambda (m p) (declare (ignore m p)) (list :error -32000 "no echo")))
                             "error") "code")
                 -32603d0 "a host error")
          (close stream)
          (sb-bsd-sockets:socket-close sock))))))

(deftest peer-cancel
  (with-server-dir (dir)
    (let ((socket (format nil "~Aengine.sock" dir)))
      (om.server:start-server :root dir :socket socket :idle-seconds 0)
      (with-test-methods ("test/spin" "test/long-call")
        (om.server:define-method "test/spin" (params)
          (loop (om.server::check-cancelled) (sleep 0.02)))
        (om.server:define-method "test/long-call" (params)
          (handler-case (om.server::host-call "models/streamResult" "stream" "1")
            (error (e) (peer-note (princ-to-string e)) (om.server::check-cancelled) (error e))))
        (multiple-value-bind (stream sock) (test-connect socket)
          (peer-init stream)
          ;; A handler polling its flag answers -32800 once cancelled.
          (peer-send-line stream (jobject "jsonrpc" "2.0" "id" 5 "method" "test/spin"))
          (sleep 0.1)
          (peer-send-line stream (jobject "jsonrpc" "2.0" "method" "$/cancelRequest" "params" (jobject "id" 5)))
          (let ((m (peer-read stream)))
            (check (jget m "id") 5d0)
            (check (jget (jget m "error") "code") -32800d0 "a cancelled request answers -32800"))
          ;; The cancel crosses to the host call in flight: the image sends $/cancelRequest for
          ;; it and goes on waiting for its answer.
          (peer-send-line stream (jobject "jsonrpc" "2.0" "id" 6 "method" "test/long-call"))
          (let ((call (peer-read stream)))
            (check (jget call "method") "models/streamResult")
            (peer-send-line stream (jobject "jsonrpc" "2.0" "method" "$/cancelRequest" "params" (jobject "id" 6)))
            (let ((cancel (peer-read stream)))
              (check (jget cancel "method") "$/cancelRequest" "the cancel is passed on")
              (check (jget (jget cancel "params") "id") (jget call "id")))
            (peer-send-line stream (jobject "jsonrpc" "2.0" "id" (jget call "id")
                                            "error" (jobject "code" -32800 "message" "context canceled"))))
          (check (jget (jget (peer-read stream) "error") "code") -32800d0 "the outer request answers -32800")
          (close stream)
          (sb-bsd-sockets:socket-close sock))))))

(deftest peer-connection-loss
  (setf *peer-test-log* '())
  (with-server-dir (dir)
    (let ((socket (format nil "~Aengine.sock" dir)))
      (om.server:start-server :root dir :socket socket :idle-seconds 0)
      (with-test-methods ("test/pending")
        (om.server:define-method "test/pending" (params)
          (handler-case (progn (om.server::host-call "host/compact") (peer-note :answered))
            (om.server::peer-closed () (peer-note :closed))))
        (multiple-value-bind (stream sock) (test-connect socket)
          (peer-init stream)
          (peer-send-line stream (jobject "jsonrpc" "2.0" "id" 7 "method" "test/pending"))
          (check (jget (peer-read stream) "method") "host/compact" "the call is pending")
          (close stream :abort t)
          (sb-bsd-sockets:socket-close sock))
        (loop repeat 50 until *peer-test-log* do (sleep 0.05))
        (check *peer-test-log* '(:closed) "the lost connection fails the pending call")
        (loop repeat 50 until (zerop (om.server::connection-count)) do (sleep 0.05))
        (check (om.server::connection-count) 0 "the connection is gone")))))

(deftest peer-shutdown-is-per-connection
  (with-server-dir (dir)
    (let ((socket (format nil "~Aengine.sock" dir)))
      (om.server:start-server :root dir :socket socket :idle-seconds 0)
      (multiple-value-bind (a sa) (test-connect socket)
        (multiple-value-bind (b sb) (test-connect socket)
          (peer-init a)
          (peer-init b)
          (check (json-string (jget (peer-exchange a 2 "shutdown" (jobject)) "result")) "{}" "shutdown answers")
          (check (and (probe-file socket) t) t "the image still runs")
          (check (jget (jget (peer-exchange a 3 "event/context" (jobject "messages" #())) "error") "message")
                 "not initialized" "the connection's state has ended")
          (check (json-string (jget (peer-exchange b 3 "event/context" (jobject "messages" #())) "result"))
                 "{\"edits\":[]}" "the other connection is served")
          (check (json-string (jget (peer-exchange b 4 "ping" (jobject)) "result")) "{}")
          (close a) (sb-bsd-sockets:socket-close sa)
          (close b) (sb-bsd-sockets:socket-close sb))))))

(defun pi-message (id parent role text &optional (timestamp "2026-05-01T10:00:00Z"))
  (jobject "type" "message" "id" id "parentId" parent "timestamp" timestamp
           "message" (jobject "role" role "content" (vector (jobject "type" "text" "text" text)))))

(deftest peer-events
  (with-server-dir (dir)
    (let ((socket (format nil "~Aengine.sock" dir))
          (branch (vector (pi-message "u1" "" "user" "Deploy on port 8080 and cache in /var/cache/app.")
                          (pi-message "a1" "u1" "assistant" "Running the checks.")))
          (appended '()) (calls '()))
      (with-open-file (out (format nil "~Asettings.json" dir) :direction :output)
        (write-string "{\"observational-memory\": {\"consolidate\": false}}" out))
      (om.server:start-server :root dir :socket socket :idle-seconds 0)
      (flet ((host (method params)
               (push method calls)
               (cond ((string= method "host/getBranch")
                      (let ((from (round (jget params "from"))))
                        (if (and (plusp from) (equal (jget params "anchorId") (jget (aref branch (1- from)) "id")))
                            (jobject "from" from "entries" (subseq branch from))
                            (jobject "from" 0 "entries" branch))))
                     ((string= method "host/appendEntry")
                      (push (cons (jget params "customType") (jget params "data")) appended)
                      (let ((e (jobject "type" "custom" "id" (format nil "x~D" (length appended))
                                        "customType" (jget params "customType") "data" (jget params "data"))))
                        (setf branch (concatenate 'simple-vector branch (vector e))))
                      (jobject))
                     ((string= method "host/projectTrusted") (jobject "value" :false))
                     ((string= method "host/configHome") (jobject "value" ""))
                     ((string= method "host/sessionModel") (jobject "model" :null))
                     ((string= method "host/sessionId") (jobject "value" "s1"))
                     (t (list :error -32601 (cat "method not found: " method))))))
        (multiple-value-bind (stream sock) (test-connect socket)
          (let ((init (jget (peer-init stream "agentDir" dir "configDirName" ".pig") "result")))
            (check (jget (jget init "tool") "name") "memory" "the tool spec")
            (check (length (jget init "buildId")) 16 "the build id"))
          (let ((scope (jobject "id" "1" "cwd" dir "hasUI" :false)))
            (check (json-string (jget (peer-exchange stream 1 "event/sessionStart" (jobject "scope" scope) :host #'host) "result"))
                   "{}" "session start")
            (let ((r (peer-exchange stream 2 "event/turnEnd" (jobject "scope" scope) :host #'host)))
              (check (jget (jget r "result") "thinning") :true "turn end wants thinning"))
            (check (mapcar #'car (reverse appended)) '("om.observations.recorded" "om.extracted") "level 0 appended its batch and marker")
            (check (and (search "8080" (json-string (cdr (car (last appended))))) t) t "the port is recorded")
            ;; The second turn end asks only for the entries after the branch it holds.
            (setf calls '())
            (peer-exchange stream 3 "event/turnEnd" (jobject "scope" scope) :host #'host
                           :seen (lambda (m p) (when (string= m "host/getBranch")
                                                 (check (jget p "from") 2d0 "incremental branch"))))
            (check (length appended) 2 "nothing new to record")
            ;; A context request that builds on one the image does not hold is stale.
            (check (jget (jget (peer-exchange stream 4 "event/context"
                                              (jobject "scope" scope "seq" 2 "base" 1 "reuse" 1 "messages" #())
                                              :host #'host)
                               "error") "code")
                   -32001d0 "stale context base")
            (let ((r (peer-exchange stream 5 "event/context"
                                    (jobject "scope" scope "seq" 3 "messages"
                                             (vector (jobject "role" "user" "timestamp" 1777629600000d0
                                                              "content" (vector (jobject "type" "text" "text" "hi")))))
                                    :host #'host)))
              (check (length (jget (jget r "result") "edits")) 1 "the day header is an edit")
              (check (jget (aref (jget (jget r "result") "edits") 0) "index") 0d0))
            (let ((edits (jget (jget (peer-exchange stream 6 "event/context"
                                                    (jobject "scope" scope "seq" 4 "base" 3 "reuse" 1 "messages" #())
                                                    :host #'host)
                                     "result") "edits")))
              (check (length edits) 1 "a reused message is the pristine one, edited again")
              (check (length (jget (jget (aref edits 0) "message") "content")) 2 "one header, not two"))
            ;; With a store and a session model, a turn end is refused before any write.
            (let ((n (length appended)))
              (flet ((store-host (method params)
                       (cond ((string= method "host/configHome") (jobject "value" dir))
                             ((string= method "host/sessionModel") (jobject "model" (jobject "provider" "p" "id" "m")))
                             (t (host method params)))))
                (check (jget (jget (peer-exchange stream 7 "event/turnEnd" (jobject "scope" scope) :host #'store-host)
                                   "error") "code")
                       -32004d0 "detect is not ported")
                (check (length appended) n "nothing appended"))))
          (close stream)
          (sb-bsd-sockets:socket-close sock))))))
